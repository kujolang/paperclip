{
  "name": "@kujolang/paperclip",
  "version": "0.1.9",
  "description": "Make Paperclip agent work easier to scope, review, reproduce, and verify.",
  "license": "MIT",
  "homepage": "https://github.com/kujolang/paperclip#readme",
  "bugs": {
    "url": "https://github.com/kujolang/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kujolang/paperclip.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "files": [
    "dist",
    "bundled",
    "docs",
    "examples",
    "schemas",
    "skills",
    "CHANGELOG.md",
    "README.md",
    "SECURITY.md",
    "VERSION",
    "LICENSE",
    "migrations"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui"
  },
  "scripts": {
    "build": "npm run abilities:verify && npm run verification:verify && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:watch": "vitest",
    "components:sync": "node scripts/sync-components.mjs --local-root ..",
    "components:verify": "node scripts/verify-components.mjs",
    "repository:verify": "node scripts/verify-repository.mjs",
    "supply-chain:verify": "node scripts/verify-supply-chain.mjs",
    "verify": "npm run repository:verify && npm run abilities:verify && npm run verification:verify && npm run typecheck && npm test && npm run components:verify && npm run supply-chain:verify && npm run build && npm run pack:verify",
    "pack:verify": "node scripts/verify-package.mjs",
    "release:dry-run": "npm run verify && npm run test:ui",
    "prepublishOnly": "npm run verify",
    "abilities:sync": "node scripts/sync-abilities.mjs",
    "abilities:generate": "node scripts/generate-abilities.mjs",
    "abilities:verify": "node scripts/generate-abilities.mjs --check",
    "verification:verify": "node scripts/verify-verification-contract.mjs",
    "test:host:execution": "node scripts/acceptance/execution-host.mjs"
  },
  "dependencies": {
    "@kujolang/kujo-runtime": "1.8.1",
    "@paperclipai/plugin-sdk": "2026.1012.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rollup": "4.63.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
