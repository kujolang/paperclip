{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/paperclip/schemas/fence-analysis.schema.json",
  "title": "Canonical Fence architecture report",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "status",
    "summary",
    "config",
    "zones",
    "violations",
    "skipped_files",
    "ignored_violations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "files_scanned",
        "imports_checked",
        "violations",
        "errors",
        "warnings",
        "skipped_files",
        "ignored_violations"
      ],
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "imports_checked": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_files": {
          "type": "integer",
          "minimum": 0
        },
        "ignored_violations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "config": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "files": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "integer",
            "minimum": 0
          },
          "warnings": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "files",
          "errors",
          "warnings"
        ]
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "from_zone": {
            "type": "string"
          },
          "to_zone": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "import": {
            "type": "string"
          },
          "resolved": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "from_zone",
          "to_zone",
          "file",
          "line",
          "import",
          "resolved",
          "rule",
          "message",
          "suggestion"
        ]
      }
    },
    "skipped_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "reason"
        ]
      }
    },
    "ignored_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "import": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "expires": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "line",
          "import",
          "reason",
          "expires"
        ]
      }
    }
  }
}
