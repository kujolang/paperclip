{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kujo Spec validation result",
  "type": "object",
  "required": [
    "valid",
    "errors"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
