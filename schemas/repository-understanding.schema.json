{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "scout"
        },
        "version": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "languages": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "maxLength": 1000
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "largest_files": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 1000
              },
              "lang": {
                "type": "string",
                "maxLength": 1000
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "lang",
              "size"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "total_files",
        "total_lines",
        "total_size",
        "languages",
        "largest_files"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string",
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "maxLength": 1000
          },
          "type": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "module",
          "source",
          "type"
        ],
        "additionalProperties": false
      }
    },
    "routes": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "maxLength": 1000
          },
          "path": {
            "type": "string",
            "maxLength": 1000
          },
          "source": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "method",
          "path",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "security_findings": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "maxLength": 1000
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "severity": {
            "type": "string",
            "maxLength": 1000
          },
          "label": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "file",
          "line",
          "severity",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "parse_errors": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "maxLength": 1000
          },
          "error": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "file",
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tool",
    "metrics",
    "dependencies",
    "routes",
    "security_findings",
    "parse_errors"
  ],
  "additionalProperties": false
}
