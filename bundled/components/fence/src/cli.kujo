// src/cli.kujo
// Top-level command dispatch for Fence.
//
// fence.kujo calls cli_dispatch(args()) and exits with its return code.
// Command handlers live in their own modules to keep call frames shallow.

from src.meta import version_line, help_text
from src.cliargs import parse_args
from src.cmd_init import cmd_init
from src.cmd_validate import cmd_validate
from src.cmd_doctor import cmd_doctor
from src.cmd_check import cmd_check
from src.cmd_explain import cmd_explain
from src.cmd_graph import cmd_graph
from src.cmd_baseline import cmd_baseline
from src.cmd_workspace import cmd_workspace
from src.cmd_ignores import cmd_ignores

// Flags that always consume the following token as their value.
func value_flags() {
    return ["template", "format", "output", "fail-on", "base", "within-days"]
}

export func cli_dispatch(argv) {
    // Handle bare --version / --help before normal parsing.
    if len(argv) == 0 {
        print(help_text())
        return 0
    }
    let first = argv[0]
    if first == "--version" {
        print(version_line())
        return 0
    }
    if first == "--help" {
        print(help_text())
        return 0
    }

    let parsed = parse_args(argv, value_flags())
    let cmd = parsed["command"]

    if cmd == "" {
        print(help_text())
        return 0
    }
    if cmd == "help" {
        print(help_text())
        return 0
    }
    if cmd == "version" {
        print(version_line())
        return 0
    }
    if cmd == "init" {
        return cmd_init(parsed)
    }
    if cmd == "validate" {
        return cmd_validate(parsed)
    }
    if cmd == "doctor" {
        return cmd_doctor(parsed)
    }
    if cmd == "check" {
        return cmd_check(parsed)
    }
    if cmd == "explain" {
        return cmd_explain(parsed)
    }
    if cmd == "graph" {
        return cmd_graph(parsed)
    }
    if cmd == "baseline" {
        return cmd_baseline(parsed)
    }
    if cmd == "workspace" {
        return cmd_workspace(parsed)
    }
    if cmd == "ignores" { return cmd_ignores(parsed) }

    print("Unknown command: " + cmd)
    print("Run `kujo run fence.kujo -- help` for usage.")
    return 2
}
