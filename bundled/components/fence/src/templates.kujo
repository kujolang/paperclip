// src/templates.kujo
// Starter fence.toml templates for `fence init`.
//
// Built from one TOML line per literal so embedded quotes stay localized and the
// generated scaffold remains easy to review.

from src.util import join_strings

func lines(xs) {
    return join_strings(xs, "\n") + "\n"
}

// Shared header comment block.
func header() {
    return lines([
        "# fence.toml - architecture boundary contract",
        "# Generated by `fence init`. Edit to match your project.",
        "# Docs: run `kujo run fence.kujo -- help`.",
        ""
    ])
}

func common_scan() {
    return lines([
        "[scan]",
        "include = [",
        "  \"src/**/*.ts\",",
        "  \"src/**/*.tsx\",",
        "  \"src/**/*.js\",",
        "  \"src/**/*.jsx\",",
        "  \"src/**/*.py\",",
        "  \"src/**/*.rs\",",
        "  \"src/**/*.php\",",
        "  \"src/**/*.go\",",
        "  \"src/**/*.kujo\"",
        "]",
        "exclude = [",
        "  \"node_modules/**\",",
        "  \"vendor/**\",",
        "  \"dist/**\",",
        "  \"build/**\",",
        "  \"coverage/**\",",
        "  \".git/**\",",
        "  \"**/*.min.js\",",
        "  \"**/*.generated.*\"",
        "]",
        "",
        "[aliases]",
        "\"@\" = \"src\"",
        "\"~\" = \"src\"",
        ""
    ])
}

func preamble() {
    return lines([
        "version = 1",
        "source_roots = [\"src\"]",
        "default_severity = \"error\"",
        "fail_on = \"error\"",
        "unknown_dependency_policy = \"warn\"",
        ""
    ])
}

func zone(name, paths_line, can_line, cannot_line, sev) {
    return lines([
        "[zones." + name + "]",
        "paths = " + paths_line,
        "can_depend_on = " + can_line,
        "cannot_depend_on = " + cannot_line,
        "severity = \"" + sev + "\"",
        ""
    ])
}

// Layered template: ui / http / domain / database / infra / shared.
export func template_layered() {
    mut o = header()
    o = o + preamble()
    o = o + common_scan()
    o = o + zone("ui", "[\"src/ui/**\", \"src/components/**\", \"src/pages/**\"]", "[\"domain\", \"shared\"]", "[\"database\", \"infra\"]", "error")
    o = o + zone("domain", "[\"src/domain/**\", \"src/core/**\"]", "[\"shared\"]", "[\"ui\", \"http\", \"database\", \"infra\"]", "error")
    o = o + zone("http", "[\"src/http/**\", \"src/api/**\", \"src/routes/**\"]", "[\"domain\", \"shared\"]", "[\"ui\", \"database\"]", "warning")
    o = o + zone("database", "[\"src/database/**\", \"src/db/**\", \"src/repositories/**\"]", "[\"domain\", \"shared\"]", "[\"ui\", \"http\"]", "error")
    o = o + zone("infra", "[\"src/infra/**\", \"src/adapters/**\"]", "[\"domain\", \"shared\"]", "[\"ui\"]", "warning")
    o = o + zone("shared", "[\"src/shared/**\", \"src/utils/**\"]", "[]", "[\"ui\", \"http\", \"database\", \"infra\", \"domain\"]", "warning")
    return o
}

// CLI template: cli / commands / core / adapters / shared.
export func template_cli() {
    mut o = header()
    o = o + preamble()
    o = o + common_scan()
    o = o + zone("cli", "[\"src/cli/**\", \"src/bin/**\"]", "[\"commands\", \"core\", \"shared\"]", "[\"adapters\"]", "error")
    o = o + zone("commands", "[\"src/commands/**\"]", "[\"core\", \"shared\"]", "[\"cli\"]", "error")
    o = o + zone("core", "[\"src/core/**\", \"src/domain/**\"]", "[\"shared\"]", "[\"cli\", \"commands\", \"adapters\"]", "error")
    o = o + zone("adapters", "[\"src/adapters/**\", \"src/infra/**\"]", "[\"core\", \"shared\"]", "[\"cli\", \"commands\"]", "warning")
    o = o + zone("shared", "[\"src/shared/**\", \"src/utils/**\"]", "[]", "[\"cli\", \"commands\", \"core\", \"adapters\"]", "warning")
    return o
}

// Web-app template: pages / components / features / domain / server / database / shared.
export func template_web_app() {
    mut o = header()
    o = o + preamble()
    o = o + common_scan()
    o = o + zone("pages", "[\"src/pages/**\", \"src/app/**\"]", "[\"components\", \"features\", \"domain\", \"shared\"]", "[\"database\"]", "error")
    o = o + zone("components", "[\"src/components/**\", \"src/ui/**\"]", "[\"domain\", \"shared\"]", "[\"database\", \"server\"]", "error")
    o = o + zone("features", "[\"src/features/**\"]", "[\"components\", \"domain\", \"shared\"]", "[\"database\"]", "warning")
    o = o + zone("domain", "[\"src/domain/**\", \"src/core/**\"]", "[\"shared\"]", "[\"pages\", \"components\", \"server\", \"database\"]", "error")
    o = o + zone("server", "[\"src/server/**\", \"src/api/**\"]", "[\"domain\", \"database\", \"shared\"]", "[\"pages\", \"components\"]", "warning")
    o = o + zone("database", "[\"src/database/**\", \"src/db/**\"]", "[\"domain\", \"shared\"]", "[\"pages\", \"components\", \"features\"]", "error")
    o = o + zone("shared", "[\"src/shared/**\", \"src/utils/**\"]", "[]", "[\"pages\", \"components\", \"features\", \"domain\", \"server\", \"database\"]", "warning")
    return o
}

// Hexagonal (ports & adapters): domain / application / ports / adapters / shared.
export func template_hexagonal() {
    mut o = header()
    o = o + preamble()
    o = o + common_scan()
    o = o + zone("domain", "[\"src/domain/**\", \"src/model/**\"]", "[\"shared\"]", "[\"application\", \"ports\", \"adapters\"]", "error")
    o = o + zone("application", "[\"src/application/**\", \"src/usecases/**\"]", "[\"domain\", \"ports\", \"shared\"]", "[\"adapters\"]", "error")
    o = o + zone("ports", "[\"src/ports/**\"]", "[\"domain\", \"shared\"]", "[\"adapters\", \"application\"]", "warning")
    o = o + zone("adapters", "[\"src/adapters/**\", \"src/infra/**\"]", "[\"application\", \"ports\", \"domain\", \"shared\"]", "[]", "warning")
    o = o + zone("shared", "[\"src/shared/**\", \"src/utils/**\"]", "[]", "[\"domain\", \"application\", \"ports\", \"adapters\"]", "warning")
    return o
}

// MVC: controllers / models / views / services / shared.
export func template_mvc() {
    mut o = header()
    o = o + preamble()
    o = o + common_scan()
    o = o + zone("controllers", "[\"src/controllers/**\"]", "[\"models\", \"views\", \"services\", \"shared\"]", "[]", "error")
    o = o + zone("views", "[\"src/views/**\", \"src/templates/**\"]", "[\"models\", \"shared\"]", "[\"controllers\", \"services\"]", "warning")
    o = o + zone("services", "[\"src/services/**\"]", "[\"models\", \"shared\"]", "[\"controllers\", \"views\"]", "error")
    o = o + zone("models", "[\"src/models/**\"]", "[\"shared\"]", "[\"controllers\", \"views\", \"services\"]", "error")
    o = o + zone("shared", "[\"src/shared/**\", \"src/utils/**\"]", "[]", "[\"controllers\", \"views\", \"services\", \"models\"]", "warning")
    return o
}

// Feature-sliced: app / processes / pages / widgets / features / entities / shared.
export func template_feature_sliced() {
    mut o = header()
    o = o + preamble()
    o = o + common_scan()
    o = o + zone("app", "[\"src/app/**\"]", "[\"processes\", \"pages\", \"widgets\", \"features\", \"entities\", \"shared\"]", "[]", "error")
    o = o + zone("processes", "[\"src/processes/**\"]", "[\"pages\", \"widgets\", \"features\", \"entities\", \"shared\"]", "[\"app\"]", "warning")
    o = o + zone("pages", "[\"src/pages/**\"]", "[\"widgets\", \"features\", \"entities\", \"shared\"]", "[\"app\", \"processes\"]", "error")
    o = o + zone("widgets", "[\"src/widgets/**\"]", "[\"features\", \"entities\", \"shared\"]", "[\"app\", \"processes\", \"pages\"]", "warning")
    o = o + zone("features", "[\"src/features/**\"]", "[\"entities\", \"shared\"]", "[\"app\", \"processes\", \"pages\", \"widgets\"]", "error")
    o = o + zone("entities", "[\"src/entities/**\"]", "[\"shared\"]", "[\"app\", \"processes\", \"pages\", \"widgets\", \"features\"]", "error")
    o = o + zone("shared", "[\"src/shared/**\", \"src/utils/**\"]", "[]", "[\"app\", \"processes\", \"pages\", \"widgets\", \"features\", \"entities\"]", "warning")
    return o
}

// Generic workspace: deployable apps depend on reusable packages, never the
// reverse. Teams can split the broad package zone after the first successful
// rollout without changing the adoption path.
export func template_monorepo() {
    mut o = header()
    o = o + lines([
        "version = 1",
        "source_roots = [\"apps\", \"packages\", \"tools\"]",
        "default_severity = \"error\"",
        "fail_on = \"error\"",
        "unknown_dependency_policy = \"warn\"",
        "",
        "[scan]",
        "include = [",
        "  \"apps/**/*.ts\", \"apps/**/*.tsx\", \"apps/**/*.js\", \"apps/**/*.jsx\",",
        "  \"apps/**/*.py\", \"apps/**/*.rs\", \"apps/**/*.php\", \"apps/**/*.go\", \"apps/**/*.kujo\",",
        "  \"packages/**/*.ts\", \"packages/**/*.tsx\", \"packages/**/*.js\", \"packages/**/*.jsx\",",
        "  \"packages/**/*.py\", \"packages/**/*.rs\", \"packages/**/*.php\", \"packages/**/*.go\", \"packages/**/*.kujo\",",
        "  \"tools/**/*.ts\", \"tools/**/*.js\", \"tools/**/*.py\", \"tools/**/*.go\", \"tools/**/*.kujo\"",
        "]",
        "exclude = [\"node_modules/**\", \"vendor/**\", \"dist/**\", \"build/**\", \"coverage/**\", \".git/**\", \"**/*.generated.*\"]",
        "",
        "[aliases]",
        "\"@apps\" = \"apps\"",
        "\"@packages\" = \"packages\"",
        ""
    ])
    o = o + zone("applications", "[\"apps/**\"]", "[\"packages\"]", "[\"tooling\"]", "error")
    o = o + zone("packages", "[\"packages/**\"]", "[]", "[\"applications\", \"tooling\"]", "error")
    o = o + zone("tooling", "[\"tools/**\"]", "[\"packages\"]", "[\"applications\"]", "warning")
    return o
}

// Return template content by name, or "" for an unknown template.
export func template_by_name(name) {
    if name == "layered" {
        return template_layered()
    }
    if name == "cli" {
        return template_cli()
    }
    if name == "web-app" {
        return template_web_app()
    }
    if name == "hexagonal" {
        return template_hexagonal()
    }
    if name == "mvc" {
        return template_mvc()
    }
    if name == "feature-sliced" {
        return template_feature_sliced()
    }
    if name == "monorepo" {
        return template_monorepo()
    }
    return ""
}

// List of available template names (for help/error messages).
export func template_names() {
    return "layered, cli, web-app, hexagonal, mvc, feature-sliced, monorepo"
}
