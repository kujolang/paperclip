{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/schemas/workflow-control/evaluation-result/v1.json",
  "title": "Kujo Evaluation Result v1",
  "type": "object",
  "required": ["schema", "result_id", "evaluator", "subject", "verdict", "severity", "checks", "started_at", "finished_at", "evidence"],
  "properties": {
    "schema": {"const": "kujo.evaluation-result/v1"},
    "result_id": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "subject": {
      "type": "object",
      "required": ["run_id"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "step_id": {"type": "string"},
        "attempt_id": {"type": "string"}
      }
    },
    "verdict": {"enum": ["pass", "fail", "warn", "indeterminate"]},
    "severity": {"enum": ["info", "warning", "error", "critical"]},
    "checks": {
      "type": "object",
      "required": ["passed", "failed", "warned", "skipped"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "warned": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "input_evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["$ref"], "properties": {"$ref": {"type": "string", "minLength": 1}}}},
    "evidence_refs": {"type": "array", "items": {"type": "object"}},
    "annotations": {"type": "array"}
  }
}
