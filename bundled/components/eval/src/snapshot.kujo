# Snapshot management for eval.
#
# Snapshots are stored as plain text files in a snapshot directory.
# Each snapshot is identified by name and stores the expected output.
#
# Functions:
#   save_snapshot(dir, name, content)   - Save/update a snapshot
#   compare_snapshot(dir, name, content) - Compare content against snapshot
#   list_snapshots(dir)                 - List all snapshots in a directory
#   delete_snapshot(dir, name)          - Remove a snapshot

from src.common import dict_get_or, normalize_string, contains_text, make_result

func sanitize_snapshot_name(name) {
	result := ""
	i := 0
	while i < len(name) {
		ch := name[i]
		is_alphanum := (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9")
		if is_alphanum || ch == "-" || ch == "_" || ch == "." {
			result = result + ch
		} else {
			result = result + "_"
		}
		i := i + 1
	}
	return result
}

export func save_snapshot(snapshot_dir, name, content) {
	dir := normalize_string(snapshot_dir, "./snapshots")
	safe_name := sanitize_snapshot_name(normalize_string(name, "unnamed"))

	if path_exists(dir) == false {
		try { create_dir(dir) } except err {
			return make_result(false, "Failed to create snapshot directory: " + dir, {"name": safe_name})
		}
	}

	file_path := dir + "/" + safe_name + ".snap"
	try { write_file(file_path, content, true) } except err {
		return make_result(false, "Failed to write snapshot: " + file_path, {"path": file_path, "name": safe_name})
	}

	return make_result(true, "", {"path": file_path, "name": safe_name, "message": "Snapshot saved: " + safe_name})
}

export func compare_snapshot(snapshot_dir, name, actual_content) {
	dir := normalize_string(snapshot_dir, "./snapshots")
	safe_name := sanitize_snapshot_name(normalize_string(name, "unnamed"))
	file_path := dir + "/" + safe_name + ".snap"

	if path_exists(file_path) == false {
		return make_result(false, "No snapshot found for: " + safe_name, {
			"match": 0, "snapshot_path": file_path, "name": safe_name,
			"diff": "No snapshot exists. Actual content:\n" + actual_content
		})
	}

	expected := ""
	try { expected = read_file(file_path) } except err {
		return make_result(false, "Failed to read snapshot: " + file_path, {"match": 0, "snapshot_path": file_path, "name": safe_name, "diff": "Read error"})
	}

	if expected == actual_content {
		return make_result(true, "", {"match": 1, "snapshot_path": file_path, "name": safe_name, "message": "Snapshot matches", "diff": ""})
	}

	diff_text := generate_diff(expected, actual_content)
	return make_result(false, "Snapshot does not match", {"match": 0, "snapshot_path": file_path, "name": safe_name, "diff": diff_text})
}

func generate_diff(expected, actual) {
	expected_lines := split(expected, "\n")
	actual_lines := split(actual, "\n")

	result := ""
	result = result + "--- expected\n"
	result = result + "+++ actual\n"

	max_lines := len(expected_lines)
	if len(actual_lines) > max_lines {
		max_lines = len(actual_lines)
	}

	i := 0
	while i < max_lines {
		exp_line := ""
		act_line := ""

		if i < len(expected_lines) {
			exp_line = expected_lines[i]
		}
		if i < len(actual_lines) {
			act_line = actual_lines[i]
		}

		if exp_line == act_line {
			result = result + "  " + exp_line + "\n"
		} else {
			if i < len(expected_lines) {
				result = result + "- " + expected_lines[i] + "\n"
			}
			if i < len(actual_lines) {
				result = result + "+ " + actual_lines[i] + "\n"
			}
		}

		i := i + 1
	}

	return result
}

export func list_snapshots(snapshot_dir) {
	dir := normalize_string(snapshot_dir, "./snapshots")

	if path_exists(dir) == false {
		return make_result(false, "Snapshot directory not found: " + dir, {"snapshots": []})
	}

	files := []
	try { files = list_dir(dir) } except err {
		return make_result(false, "Failed to list snapshot directory: " + dir, {"snapshots": []})
	}

	snaps := []
	i := 0
	while i < len(files) {
		f := files[i]
		if contains_text(f, ".snap") { snaps := push(snaps, f) }
		i := i + 1
	}

	return make_result(true, "", {"snapshots": snaps, "count": len(snaps)})
}

export func delete_snapshot(snapshot_dir, name) {
	dir := normalize_string(snapshot_dir, "./snapshots")
	safe_name := sanitize_snapshot_name(normalize_string(name, "unnamed"))
	file_path := dir + "/" + safe_name + ".snap"

	if path_exists(file_path) == false { return make_result(false, "Snapshot not found: " + safe_name, {}) }

	try { delete_file(file_path) } except err {
		return make_result(false, "Failed to delete snapshot: " + file_path, {})
	}

	return make_result(true, "", {"message": "Snapshot deleted: " + safe_name})
}

export func describe_snapshot_module() {
	return {
		"module": "snapshot",
		"description": "Snapshot management — save, compare, diff, list, delete",
		"exports": ["save_snapshot", "compare_snapshot", "list_snapshots", "delete_snapshot"],
		"contract_version": "2.0.0"
	}
}
