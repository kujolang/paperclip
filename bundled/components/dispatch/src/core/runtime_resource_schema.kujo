# Kujo e65bb57 runtime-measurements/v1 schema embedded for cwd-independent validation.
# The runtime validator lacks maxProperties/uniqueItems; resource_facts enforces them.
func supported_schema(value) {
    if type(value) == "dict" {result := {};for key in keys(value) {if key != "maxProperties"&&key != "uniqueItems" {result[key] := supported_schema(value[key])}};return result}
    if type(value) == "array" {result := [];for item in value {result = push(result, supported_schema(item))};return result}
    return value
}
export func runtime_resource_schema() {return supported_schema(parse_json("{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://kujolang.ai/schemas/runtime-measurements/v1.json\",\n  \"title\": \"Kujo runtime measurements v1\",\n  \"type\": \"object\",\n  \"required\": [\n    \"schema\",\n    \"scope\",\n    \"runtime\",\n    \"runtime_version\",\n    \"outcome\",\n    \"wall_ns\",\n    \"counters\",\n    \"snapshot_consistency\",\n    \"waited_for_detached\",\n    \"unsupported\",\n    \"cpu_seconds\",\n    \"process_peak_rss_bytes\"\n  ],\n  \"properties\": {\n    \"schema\": {\n      \"const\": \"kujo.runtime-measurements/v1\"\n    },\n    \"scope\": {\n      \"const\": \"process\"\n    },\n    \"runtime\": {\n      \"const\": \"vm\"\n    },\n    \"runtime_version\": {\n      \"type\": \"string\",\n      \"maxLength\": 64\n    },\n    \"outcome\": {\n      \"enum\": [\n        \"success\",\n        \"runtime_error\",\n        \"compile_error\",\n        \"internal_error\"\n      ]\n    },\n    \"wall_ns\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 18446744073709551615\n    },\n    \"counters\": {\n      \"type\": \"object\",\n      \"maxProperties\": 64,\n      \"required\": [\n        \"vm_entries\",\n        \"vm_inclusive_wall_ns\",\n        \"vm_call_opcodes\",\n        \"vm_return_opcodes\",\n        \"vm_native_call_opcodes\",\n        \"scheduler_rounds\",\n        \"vm_closures_created\",\n        \"vm_capture_cells_created\",\n        \"vm_capture_value_shallow_bytes\",\n        \"vm_generator_states_created\",\n        \"vm_generator_state_drops\",\n        \"vm_generator_state_shallow_bytes\",\n        \"vm_generator_resume_attempts\",\n        \"tasks_admitted\",\n        \"tasks_admission_rejected\",\n        \"tasks_started\",\n        \"task_bodies_exited\",\n        \"task_completions_published\",\n        \"task_cancellations_published\",\n        \"task_queue_wall_ns\",\n        \"detached_tasks_observed\",\n        \"promise_polls\",\n        \"promise_pending_polls\",\n        \"promise_ready_polls\",\n        \"jit_compile_entries\",\n        \"jit_compile_inclusive_wall_ns\",\n        \"jit_cache_lookup_hits\",\n        \"jit_cache_lookup_misses\",\n        \"jit_type_guard_passes\",\n        \"jit_type_guard_failures\"\n      ],\n      \"properties\": {\n        \"vm_entries\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_inclusive_wall_ns\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_call_opcodes\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_return_opcodes\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_native_call_opcodes\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"scheduler_rounds\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_closures_created\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_capture_cells_created\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_capture_value_shallow_bytes\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_generator_states_created\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_generator_state_drops\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_generator_state_shallow_bytes\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"vm_generator_resume_attempts\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"tasks_admitted\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"tasks_admission_rejected\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"tasks_started\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"task_bodies_exited\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"task_completions_published\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"task_cancellations_published\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"task_queue_wall_ns\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"detached_tasks_observed\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"promise_polls\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"promise_pending_polls\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"maximum\": 18446744073709551615\n        },\n        \"promise_read