# Experimental reference evaluator. Not installed in workflow/CLI policy defaults.
# Policy, selected profile, expected context and registry are host-owned values.
from src.core.utils import dict_get_or
from src.core.control import validate_execution_result
from src.core.intervention import retry_is_effect_safe
from src.core.effect_assurance import resolve_effect_assurance, validate_effect_assurance_shape

func outcome(action, code, verified) {return {"ok": (action == "verified"||action == "legacy"), "action": action, "code": code, "assurance_verified": verified}}
func legacy(result, code) {
    if retry_is_effect_safe({"execution_result": result}) {return outcome("legacy", code, false)}
    return outcome("blocked", "compat_v1_denied", false)
}
func unavailable(result, policy, code) {
    if policy["mode"] == "optional"&&policy["fallback"] == "legacy_unavailable" {return legacy(result, code)}
    return outcome("blocked", code, false)
}
func mechanism(profile, version) {
    if version != "1alpha1" {return ""}
    if profile == "dispatch.sqlite-unique" {return "sqlite_unique_transaction"}
    if profile == "workcell.git-cas" {return "git_ref_cas_transaction"}
    if profile == "ability.application-gateway" {return "ability_application_gateway"}
    return ""
}
func id(value) {return type(value) == "string"&&regex_match(value, "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$")}

export func evaluate_assurance_compatibility(result_raw, assurance_raw, expected, policy, selected, entries, at_seconds) {
    try {
        if type(policy) != "dict"||len(keys(policy)) != 2||contains(["legacy", "optional", "required"], dict_get_or(policy, "mode", "")) == false||contains(["deny", "legacy_unavailable"], dict_get_or(policy, "fallback", "")) == false {return outcome("configuration_error", "compat_policy_invalid", false)}
        if policy["mode"] != "optional"&&policy["fallback"] != "deny" {return outcome("configuration_error", "compat_policy_invalid", false)}
        if type(result_raw) != "string"||byte_length(result_raw) > 1048576 {return outcome("blocked", "compat_result_invalid", false)}
        result := parse_json(result_raw)
        if validate_execution_result(result)["ok"] == false {return outcome("blocked", "compat_result_invalid", false)}
        if policy["mode"] == "legacy" {return legacy(result, "compat_legacy_selected")}
        if sha256(result_raw) != dict_get_or(expected, "result_sha256", "") {return outcome("blocked", "assurance_result_digest_mismatch", false)}
        # The reference API is explicitly for one external-idempotent action effect.
        # Other policy domains keep their existing admission path, never auto-fallback.
        if len(result["effects"]) != 1 {return outcome("blocked", "compat_single_effect_required", false)}
        if retry_is_effect_safe({"execution_result": result}) == false {return outcome("blocked", "compat_v1_denied", false)}
        if result["effects"][0]["class"] != "external_idempotent" {return outcome("blocked", "compat_effect_out_of_scope", false)}
        if type(selected) != "dict"||len(keys(selected)) != 2||id(dict_get_or(selected, "profile", null)) == false||id(dict_get_or(selected, "version", null)) == false||type(entries) != "array"||len(entries) > 8 {return outcome("configuration_error", "compat_registry_invalid", false)}
        seen := {}; matched := null
        for entry in entries {
            if type(entry) != "dict"||len(keys(entry)) != 7 {return outcome("configuration_error", "compat_registry_invalid", false)}
            for field in ["profile", "version", "issuer", "status", "envelope", "assurance", "verify"] {if has_key(entry, field) == 0 {return outcome("configuration_error", "compat_registry_invalid", false)}}
            for field in ["profile", "version", "issuer"] {if id(dict_get_or(entry, field, null)) == false {return outcome("configuration_error", "compat_registry_invalid", false)}}
            if contains(["active", "disabled", "revoked"], dict_get_or(entry, "status", "")) == false||entry["envelope"] != "dispatch.effect-assurance/v1alpha1"||contains(["adapter_attested", "independently_verified"], entry["assurance"]) == false||type(entry["verify"]) != "function" {return outcome("configuration_error", "compat_registry_invalid", false)}
            key := to_json([entry["profile"], entry["version"], entry["issuer"]])
            if has_key(seen, key) {return outcome("configuration_error", "compat_registry_duplicate", false)}
            seen[key] := true
            if entry["profile"] == selected["profile"]&&entry["version"] == selected["version"]&&entry["issuer"] == expected["issuer"] {matched = entry}
        }
        # Revocation/disablement beats absence and unsupported metadata. No downgrade.
        if matched != null&&matched["status"] == "revoked" {return outcome("blocked", "compat_profile_revoked", false)}
        if matched != null&&matched["status"] == "disabled" {return outcome("configuration_error", "compat_profile_disabled", false)}
        known := mechanism(selected["profile"], selected["version"])
        if known != ""&&matched == null {return outcome("configuration_error", "compat_verifier_unconfigured", false)}
        if matched != null&&matched["assurance"] != expected["assurance"] {return outcome("configuration_error", "compat_authority_mismatch", false)}
        # Framing and understood envelope failures outrank unsupported-profile
        # fallback. Unknown envelopes remain uninterpreted, not partially trusted.
        doc := null
        if assurance_raw != null {
            if type(assurance_raw) != "string"||byte_length(assurance_raw) > 8192 {return outcome("blocked", "compat_assurance_invalid", false)}
            doc = parse_json(assurance_raw)
            if type(doc) != "dict"||type(dict_get_or(doc, "schema", null)) != "string"||len(doc["schema"]) == 0||len(doc["schema"]) > 128 {return outcome("blocked", "compat_assurance_invalid", false)}
            if doc["schema"] == "dispatch.effect-assurance/v1alpha1" {
                if known != ""&&dict_get_or(doc, "mechanism", "") != known {return outcome("blocked", "compat_profile_mismatch", false)}
                if validate_effect_assurance_shape(doc) == false {return outcome("blocked", "assurance_contract_invalid", false)}
                if type(at_seconds) != "int"||at_seconds < 0||at_seconds > 253402300799 {return outcome("blocked", "assurance_clock_invalid", false)}
                if at_seconds < doc["valid_from"]||at_seconds >= doc["valid_until"] {return outcome("blocked", "assurance_expired_or_future", false)}
                for field in ["issuer", "assurance", "run_id", "step_id", "attempt_id", "effect_id", "result_sha256", "operation", "target_sha256", "scope_sha256", "key_sha256", "request_sha256", "precondition_sha256", "transaction_sha256", "reported_state", "replay_class"] {
                    if doc[field] != dict_get_or(expected, field, null) {return outcome("blocked", "assurance_binding_mismatch", false)}
                }
            }
        }
        if known == "" {return unavailable(result, policy, "compat_profile_unsupported")}
        if doc == null {return unavailable(result, policy, "compat_assurance_absent")}
        if doc["schema"] != "dispatch.effect-assurance/v1alpha1" {return unavailable(result, policy, "compat_envelope_unsupported")}
        registry := {}; registry[expected["issuer"]] := {"assurance": matched["assurance"], "verify": matched["verify"]}
        resolved := resolve_effect_assurance(result_raw, assurance_raw, expected, registry, at_seconds)
        if resolved["ok"] == false {return outcome("blocked", resolved["code"], false)}
        return outcome("verified", "compat_verified_v1_eligible", true)
    } except error {return outcome("blocked", "compat_input_or_resolution_invalid", false)}
}
