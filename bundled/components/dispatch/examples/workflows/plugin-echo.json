{
  "id": "plugin-echo",
  "name": "Scoped plugin echo",
  "description": "A minimal tool workflow using the sample plugin under an explicit tool allowlist.",
  "input_schema": {"type": "dict", "required": ["topic"]},
  "tools": ["echo_tool"],
  "steps": [
    {"id": "echo", "name": "Echo topic", "type": "tool", "tool_name": "echo_tool", "input_from": ["input"], "output_key": "echo"},
