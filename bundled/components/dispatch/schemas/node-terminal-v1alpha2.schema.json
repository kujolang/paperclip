{
  "$id": "dispatch.node-terminal/v1alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "node_id",
    "contract",
    "subject",
    "facts_ref",
    "finalized_revision",
    "outcome",
    "authority_ref"
  ],
  "properties": {
    "schema": {
      "const": "dispatch.node-terminal/v1alpha2"
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "contract": {
      "const": "program-attempt/v1alpha1"
    },
    "subject": {
      "type": "object",
      "required": [
        "run_id"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "facts_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finalized_revision": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "enum": [
        "completed",
        "failed",
        "rejected",
        "cancelled"
      ]
    },
    "authority_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
