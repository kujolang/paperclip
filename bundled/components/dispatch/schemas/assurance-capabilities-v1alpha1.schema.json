{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "advisory",
    "execution_results",
    "envelopes",
    "max_document_bytes",
    "max_effects",
    "multi_effect",
    "profiles"
  ],
  "properties": {
    "schema": {
      "const": "dispatch.assurance-capabilities/v1alpha1"
    },
    "advisory": {
      "const": true
    },
    "execution_results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "kujo.execution-result/v1"
      }
    },
    "envelopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "const": "dispatch.effect-assurance/v1alpha1"
      }
    },
    "max_document_bytes": {
      "const": 8192
    },
    "max_effects": {
      "const": 1
    },
    "multi_effect": {
      "const": false
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "mechanism",
          "predicate",
          "revocation",
          "live_verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mechanism": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "predicate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revocation": {
            "enum": [
              "registry",
              "registry_and_session"
            ]
          },
          "live_verification": {
            "const": true
          }
        }
      }
    }
  }
}
