func key_exists(map_obj, key_name) {
    if type(map_obj) != "dict" {
        return false
    }
    if has_key(map_obj, key_name) {
        return true
    }
    return false
}

func parsed_flag_present(parsed_args, flag_name) {
    return key_exists(dict_get_or(parsed_args, "present", {}), flag_name)
}

func text_contains(haystack, needle) {
    if contains(haystack, needle) {
        return true
    }
    return false
}

func parsed_positionals_or_empty(parsed_args) {
    positionals := dict_get_or(parsed_args, "positionals", [])
    if type(positionals) != "array" {
        return []
    }
    return positionals
}

func command_has_flag(command_args, flag_name) {
    if type(command_args) != "array" {
        return false
    }
    for token in command_args {
        if to_string(token) == flag_name {
            return true
        }
    }
    return false
}

func config_get_any(config, keys_list, default_value) {
    if type(config) != "dict" {
        return default_value
    }
    for key in keys_list {
        if key_exists(config, key) {
            return config[key]
        }
    }
    return default_value
}

func normalize_workflow_file_path(raw_workflow_file) {
    bundled := bundled_workflow_path(raw_workflow_file, env("DISPATCH_ROOT"))
    if type(bundled) == "dict" {return bundled}
    return normalize_config_path(raw_workflow_file)
}

func strip_wrapping_quotes(raw_value) {
    value := trim(to_string(raw_value))
    if len(value) >= 2 {
        if (starts_with(value, "\"")&&ends_with(value, "\""))||(starts_with(value, "'")&&ends_with(value, "'")) {
            return substring(value, 1, len(value) - 1)
        }
    }
    return value
}

func parse_yaml_scalar(raw_value) {
    value := strip_wrapping_quotes(raw_value)
    lower_value := to_lower(value)
    if lower_value == "true"||lower_value == "yes"||lower_value == "on" {
        return true
    }
    if lower_value == "false"||lower_value == "no"||lower_value == "off" {
        return false
    }
    parsed_number := 0
    try {
        parsed_number = to_float(value)
        return parsed_number
    } except err {
        return value
    }
}

func parse_simple_yaml(raw_text) {
    config := {}
    lines := split(raw_text, "\n")
    for line in lines {
        trimmed := trim(line)
        if trimmed == ""||starts_with(trimmed, "#") {
            continue
        }
        if text_contains(trimmed, ":") == false {
            continue
        }
        parts := split(trimmed, ":")
        if len(parts) < 2 {
            continue
        }
        key := trim(parts[0])
        if key == "" {
            continue
        }
        value_parts := []
        i := 1
        while i < len(parts) {
            value_parts := push(value_parts, parts[i])
            i := i + 1
        }
        raw_value := trim(join(value_parts, ":"))
        config[key] := parse_yaml_scalar(raw_value)
    }
    return {
        "ok": true,
        "config": config
    }
}

func load_command_config(config_path) {
    path_result := normalize_config_path(config_path)
    if path_result["ok"] == false {
        return {
            "ok": false,
            "message": path_result["message"]
        }
    }
    path := trim(to_string(path_result["config_path"]))
    if path == "" {
        return {
            "ok": true,
            "config": {}
        }
    }
    if ! file_exists(path) {
        return {
            "ok": false,
            "message": "Config file not found: " + path
        }
    }
    content := ""
    try {
        content = read_file(path)
    } except err {
        return {
            "ok": false,
            "message": "Unable to read config file: " + path
        }
    }
    if trim(content) == "" {
        return {
            "ok": false,
            "message": "Config file is empty: " + path
        }
    }
    max_config_bytes := 262144
    raw_max_config_bytes := trim(to_string(env("DISPATCH_CONFIG_MAX_BYTES")))
    if raw_max_config_bytes != "" {
        parsed_max_bytes := 0
        try {
            parsed_max_bytes = to_float(raw_max_config_bytes)
        } except err {
            parsed_max_bytes = max_config_bytes
        }
        if parsed_max_bytes > 0 {
            max_config_bytes = parsed_max_bytes
        }
    }
    if len(content) > max_config_bytes {
        return {
            "ok": false,
            "message": "Config file exceeds maximum size of " + to_string(max_config_bytes) + " bytes."
        }
    }
    lower_path := to_lower(path)
    if ends_with(lower_path, ".json") {
        parsed_config := null
        try {
            parsed_config = parse_json(content)
        } except err {
            return {
                "ok": false,
                "message": "Config file is not valid JSON: " + path
            }
        }
        if type(parsed_config) != "dict" {
            return {
                "ok": false,
                "message": "Config JSON must be an object."
            }
        }
        return {
            "ok": true,
            "config": parsed_config
        }
    }
    if ends_with(lower_path, ".yml")||ends_with(lower_path, ".yaml") {
        return parse_simple_yaml(content)
    }
    return {
        "ok": false,
        "message": "Unsupported config format. Use .json, .yml, or .yaml"
    }
}

func resolve_string_flag(parsed_args, command_args, flag_name, config, config_keys, default_value) {
    parsed_present := parsed_flag_present(parsed_args, flag_name)
    command_present := command_has_flag(command_args, flag_name)
    if parsed_present||command_present {
        return parsed_flag_value(parsed_args, flag_name, default_value)
    }
    value := config_get_any(config, config_keys, default_value)
    return to_string(value)
}

func resolve_bool_flag(parsed_args, command_args, flag_name, config, config_keys, default_value) {
    if parsed_flag_present(parsed_args, flag_name)||command_has_flag(command_args, flag_name) {
        if parsed_has_flag(parsed_args, flag_name) {
            return true
        }
        return command_has_flag(command_args, flag_name)
    }
    value := config_get_any(config, config_keys, default_value)
    if type(value) == "bool" {
        return value
    }
    if type(value) == "string" {
        normalized := to_lower(trim(value))
        if normalized == "true"||normalized == "1"||normalized == "yes"||normalized == "y"||normalized == "on" {
            return true
        }
        if normalized == "false"||normalized == "0"||normalized == "no"||normalized == "n"||normalized == "off" {
            return false
        }
    }
    return default_value
}

func resolve_tool_name_list(parsed_args, command_args, flag_name, config, config_keys, env_var_name) {
    parsed_present := parsed_flag_present(parsed_args, flag_name)
    command_present := command_has_flag(command_args, flag_name)
    if parsed_present||command_present {
        return parse_tool_name_list(parsed_flag_value(parsed_args, flag_name, ""))
    }
    config_value := config_get_any(config, config_keys, null)
    if type(config_value) != "null" {
        return parse_tool_name_list(config_value)
    }
    return parse_tool_name_list(to_string(env(env_var_name)))
}

func resolve_tool_policy_settings(parsed_args, command_args, config) {
    policy_profile := resolve_string_flag(parsed_args, command_args, "--policy-profile", config, ["policy_profile", "policy-profile"], to_string(env("DISPATCH_POLICY_PROFILE")))
    if trim(policy_profile) == "" {
        policy_profile = "production"
        fixture_value := to_lower(trim(to_string(env("DISPATCH_OFFLINE_FIXTURE"))))
        if fixture_value == "true"||fixture_value == "1"||fixture_value == "yes"||fixture_value == "on" {policy_profile = "development"}
    }
    allowed_tools := resolve_tool_name_list(parsed_args, command_args, "--allow-tools", config, ["allow_tools", "allow-tools"], "DISPATCH_ALLOWED_TOOLS")
    denied_tools := resolve_tool_name_list(parsed_args, command_args, "--deny-tools", config, ["deny_tools", "deny-tools"], "DISPATCH_DENIED_TOOLS")
    return build_tool_authorization_policy_with_profile(policy_profile, allowed_tools, denied_tools)
}

func filter_runs_by_workflow(run_items, workflow_query) {
    query := to_lower(trim(to_string(workflow_query)))
    if query == "" {
        return run_items
    }
    filtered := []
    for run_item in run_items {
        workflow_name := to_lower(to_string(dict_get_or(run_item, "workflow_name", "")))
        workflow_id := to_lower(to_string(dict_get_or(run_item, "workflow_id", "")))
        if contains(workflow_name, query)||contains(workflow_id, query) {
            filtered := push(filtered, run_item)
        }
    }
    return filtered
}

func filter_runs_by_tags(run_items, tags_query) {
    required_tags := parse_tool_name_list(tags_query)
    if len(required_tags) == 0 {
        return run_items
    }
    filtered := []
    run_index := 0
    while run_index < len(run_items) {
        run_item := run_items[run_index]
        run_tags := parse_tool_name_list(dict_get_or(run_item, "tags", []))
        tag_map := {}
        tag_index := 0
        while tag_index < len(run_tags) {
            run_tag := run_tags[tag_index]
            tag_map[run_tag] := true
            tag_index := tag_index + 1
        }
        includes_all := true
        required_index := 0
        while required_index < len(required_tags) {
            required_tag := required_tags[required_index]
            if key_exists(tag_map, required_tag) == false {
                includes_all = false
                break
            }
            required_index := required_index + 1
        }
        if includes_all {
            filtered := push(filtered, run_item)
        }
        run_index := run_index + 1
    }
    return filtered
}

func resolve_output_root_or_exit(raw_output_root) {
    validation := normalize_output_root(raw_output_root)
    if validation["ok"] == false {
        exit_error(validation["error"]["message"])
    }
    return validation["output_root"]
}

func normalize_webhook_sink_path(raw_sink_path) {
    path := trim(to_string(raw_sink_path))
    if path == "" {
        return {"ok": true, "webhook_sink": ""}
    }
    path = replace(path, "\\", "/")

    allow_any := to_lower(trim(to_string(env("DISPATCH_ALLOW_ANY_WEBHOOK_SINK"))))
    if allow_any == "true"||allow_any == "1"||allow_any == "yes"||allow_any == "on" {
        return {"ok": true, "webhook_sink": path}
    }

    if starts_with(path, "/")||starts_with(path, "~/") {
        return {"ok": false, "message": "Absolute --webhook-sink paths are blocked by default. Set DISPATCH_ALLOW_ANY_WEBHOOK_SINK=true for explicit opt-in."}
    }
    lower_path := to_lower(path)
    if contains(lower_path, "..")||contains(lower_path, "%2f")||contains(lower_path, "%5c") {
        return {"ok": false, "message": "Path traversal patterns are not allowed in --webhook-sink path."}
    }
    for segment in split(path, "/") {
        clean_segment := trim(segment)
        if clean_segment == ".." {
            return {"ok": false, "message": "Webhook sink path contains invalid path segments."}
        }
    }
    return {"ok": true, "webhook_sink": path}
}

func resolve_webhook_sink_or_exit(raw_sink_path) {
    validation := normalize_webhook_sink_path(raw_sink_path)
    if validation["ok"] == false {
        exit_error(validation["message"])
    }
    return validation["webhook_sink"]
}

func validate_status_filter_or_exit(status_filter, flag_name) {
    value := to_lower(trim(to_string(status_filter)))
    if value == "" {
        return ""
    }
    allowed_statuses := {
        "running": true,
        "paused": true,
        "needs_changes": true,
        "interrupted": true,
        "completed": true,
        "failed": true,
        "rejected": true,
        "cancelled": true
    }
    if key_exists(allowed_statuses, value) == false {
        exit_error("Invalid value for " + flag_name + ": " + value + ". Allowed values: running, paused, needs_changes, interrupted, completed, failed, rejected, cancelled")
    }
    return value
}

func has_markdown_sources(sources_dir) {
    entries := []
    try {
        entries := list_dir(sources_dir)
    } except err {
        return false
    }
    for entry in entries {
        name := replace(entry, "/", "")
        if ends_with(name, ".md") {
            return true
        }
    }
    return false
}

func validate_demo_inputs(topic, sources_dir, simulated_decision) {
    if trim(topic) == "" {
        return {
            "ok": false,
            "message": "Topic is required and cannot be empty."
        }
    }
    sources_dir_result := normalize_sources_dir(sources_dir)
    if sources_dir_result["ok"] == false {
        return {
            "ok": false,
            "message": sources_dir_result["error"]["message"]
        }
    }
    sources_dir := sources_dir_result["sources_dir"]
    if has_markdown_sources(sources_dir) == false {
        return {
            "ok": false,
            "message": "Sources directory must exist and contain .md fixtures: " + sources_dir
        }
    }
    normalized := normalize_decision(simulated_decision, "")
    if normalized == "invalid" {
        return {
            "ok": false,
            "message": "Invalid --decision value. Use approve|reject|changes."
        }
    }
    return {
        "ok": true,
        "normalized_decision": normalized
    }
}

func parse_non_negative_number(raw_value, flag_name, default_value) {
    raw_text := trim(to_string(raw_value))
    if raw_text == "" {
        return {
            "ok": true,
            "value": default_value
        }
    }
    parsed_value := default_value
    try {
        parsed_value = to_float(raw_text)
    } except err {
        return {
            "ok": false,
            "message": "Invalid value for " + flag_name + ": " + raw_text
        }
    }
    if parsed_value < 0 {
        return {
            "ok": false,
            "message": flag_name + " must be non-negative."
        }
    }
    return {
        "ok": true,
        "value": parsed_value
    }
}

func dispatch_key_exists(map_obj, key_name) {
    if type(map_obj) != "dict" {
        return false
    }
    if has_key(map_obj, key_name) {
        return true
    }
    return false
}

func dispatch_parsed_flag_present(parsed_args, flag_name) {
    return dispatch_key_exists(dict_get_or(parsed_args, "present", {}), flag_name)
}

func dispatch_command_has_flag(command_args, flag_name) {
    if type(command_args) != "array" {
        return false
    }
    for token in command_args {
        if to_string(token) == flag_name {
            return true
        }
    }
    return false
}

func dispatch_config_get_any(config, keys_list, default_value) {
    if type(config) != "dict" {
        return default_value
    }
    for key in keys_list {
        if dispatch_key_exists(config, key) {
            return config[key]
        }
    }
    return default_value
}

func dispatch_resolve_string_flag(parsed_args, command_args, flag_name, config, config_keys, default_value) {
    if dispatch_parsed_flag_present(parsed_args, flag_name)||dispatch_command_has_flag(command_args, flag_name) {
        return parsed_flag_value(parsed_args, flag_name, default_value)
    }
    value := dispatch_config_get_any(config, config_keys, default_value)
    return to_string(value)
}

func dispatch_resolve_bool_flag(parsed_args, command_args, flag_name, config, config_keys, default_value) {
    if dispatch_parsed_flag_present(parsed_args, flag_name)||dispatch_command_has_flag(command_args, flag_name) {
        if parsed_has_flag(parsed_args, flag_name) {
            return true
        }
        return dispatch_command_has_flag(command_args, flag_name)
    }
    value := dispatch_config_get_any(config, config_keys, default_value)
    if type(value) == "bool" {
        return value
    }
    if type(value) == "string" {
        normalized := to_lower(trim(value))
        if normalized == "true"||normalized == "1"||normalized == "yes"||normalized == "y"||normalized == "on" {
            return true
        }
        if normalized == "false"||normalized == "0"||normalized == "no"||normalized == "n"||normalized == "off" {
            return false
        }
    }
    return default_value
}

func dispatch_resolve_tool_name_list(parsed_args, command_args, flag_name, config, config_keys, env_var_name) {
    if dispatch_parsed_flag_present(parsed_args, flag_name)||dispatch_command_has_flag(command_args, flag_name) {
        return parse_tool_name_list(parsed_flag_value(parsed_args, flag_name, ""))
    }
    config_value := dispatch_config_get_any(config, config_keys, null)
    if type(config_value) != "null" {
        return parse_tool_name_list(config_value)
    }
    return parse_tool_name_list(to_string(env(env_var_name)))
}

func dispatch_resolve_tool_policy_settings(parsed_args, command_args, config) {
    policy_profile := dispatch_resolve_string_flag(parsed_args, command_args, "--policy-profile", config, ["policy_profile", "policy-profile"], to_string(env("DISPATCH_POLICY_PROFILE")))
    if trim(policy_profile) == "" {
        policy_profile = "production"
        fixture_value := to_lower(trim(to_string(env("DISPATCH_OFFLINE_FIXTURE"))))
        if fixture_value == "true"||fixture_value == "1"||fixture_value == "yes"||fixture_value == "on" {policy_profile = "development"}
    }
    allowed_tools := dispatch_resolve_tool_name_list(parsed_args, command_args, "--allow-tools", config, ["allow_tools", "allow-tools"], "DISPATCH_ALLOWED_TOOLS")
    denied_tools := dispatch_resolve_tool_name_list(parsed_args, command_args, "--deny-tools", config, ["deny_tools", "deny-tools"], "DISPATCH_DENIED_TOOLS")
    return build_tool_authorization_policy_with_profile(policy_profile, allowed_tools, denied_tools)
}

func resolve_signing_key(parsed, flag_name) {
    key := trim(to_string(parsed_flag_value(parsed, flag_name, "")))
    if key != "" {
        return key
    }
    return trim(to_string(env("DISPATCH_BUNDLE_SIGNING_KEY")))
}

func env_guard_enabled(env_key) {
    value := to_lower(trim(to_string(env(env_key))))
    return value == "true"||value == "1"||value == "yes"||value == "on"
}

func strict_mutation_mode_enabled(parsed) {
    if parsed_has_flag(parsed, "--strict-mutations") {
        return true
    }
    return env_guard_enabled("DISPATCH_STRICT_MUTATION_MODE")
}

func mutation_confirmation_enabled(parsed) {
    if parsed_has_flag(parsed, "--confirm-mutation") {
        return true
    }
    return env_guard_enabled("DISPATCH_MUTATION_CONFIRM")
}

func enforce_mutation_guard_or_exit(parsed, command_name, mutation_flag) {
    if strict_mutation_mode_enabled(parsed) == false {
        return
    }
    if mutation_confirmation_enabled(parsed) {
        return
    }
    exit_error("Strict mutation mode blocked " + command_name + " " + mutation_flag + ". Re-run with --confirm-mutation or set DISPATCH_MUTATION_CONFIRM=true.")
}

func dispatch_resolve_workflow(workflow_file, workflow_template_id, topic, auto_approve) {
    if workflow_file != "" {
        workflow_file_path := normalize_workflow_file_path(workflow_file)
        if workflow_file_path["ok"] == false {
            exit_error(workflow_file_path["message"])
        }
        loaded_workflow := load_workflow_from_file(workflow_file_path["config_path"])
        if loaded_workflow["ok"] == false {
            exit_error(loaded_workflow["error"]["message"])
        }
        return loaded_workflow["workflow"]
    }
    workflow_result := create_workflow_by_template(workflow_template_id, topic, auto_approve)
    if workflow_result["ok"] == false {
        exit_error(workflow_result["error"]["message"])
    }
    return workflow_result["workflow"]
}

func dispatch_resolve_resume_workflow(run_state, explicit_template_id, topic, auto_approve) {
    if trim(to_string(explicit_template_id)) == "" {
        persisted_workflow := dict_get_or(run_state, "workflow_definition", null)
        if type(persisted_workflow) == "dict"&&trim(to_string(dict_get_or(persisted_workflow, "id", ""))) != "" {
            validated_workflow := load_workflow_from_spec(persisted_workflow)
            if dict_get_or(validated_workflow, "ok", false) == false {
                exit_error("Persisted workflow_definition failed current schema validation: " + dict_get_or(dict_get_or(validated_workflow, "error", {}), "message", "invalid workflow"))
            }
            return validated_workflow["workflow"]
        }
    }
    template_id := explicit_template_id
    if trim(to_string(template_id)) == "" {
        template_id = dict_get_or(dict_get_or(run_state, "options", {}), "workflow_template_id", "research-report")
    }
    workflow_result := create_workflow_by_template(template_id, topic, auto_approve)
    if workflow_result["ok"] == false {
        exit_error(workflow_result["error"]["message"])
    }
    return workflow_result["workflow"]
}

func dispatch_apply_plugins(workflow, tool_registry, parsed, command_args, config) {
    plugin_names := parse_tool_name_list(dispatch_resolve_string_flag(parsed, command_args, "--plugin", config, ["plugin", "plugins"], ""))
    if len(plugin_names) == 0 {
        for active_plugin in dict_get_or(workflow, "active_plugins", []) {
            plugin_id := trim(to_string(dict_get_or(active_plugin, "id", "")))
            if plugin_id != "" {
                plugin_names := push(plugin_names, plugin_id)
            }
        }
    }
    if len(plugin_names) == 0 {
        return {
            "workflow": workflow,
            "tool_registry": tool_registry,
            "event_hook": null
        }
    }
    resolution := resolve_builtin_plugins(plugin_names)
    if len(resolution["unknown"]) > 0 {
        exit_error("Unknown plugin(s): " + join(resolution["unknown"], ", ") + ". Available built-in plugins: sample")
    }
    plugins := resolution["plugins"]
    plugin_registry := create_plugin_registry()
    for plugin in plugins {
        plugin_registry = register_plugin(plugin_registry, plugin)
    }
    applied := apply_plugins_to_runtime(workflow, tool_registry, plugin_registry)
    combined_event_hook := null
    if len(plugins) > 0 {
        combined_event_hook = func(event) {
            return emit_builtin_plugin_events(plugins, event)
        }
    }
    return {
        "workflow": applied["workflow"],
        "tool_registry": applied["tool_registry"],
        "event_hook": combined_event_hook
    }
}

func routing_environment_preflight(workflow, live_mode) {
    errors := []
    warnings := []
    routing := dict_get_or(workflow, "routing", {})
    catalog := dict_get_or(routing, "model_catalog", {})
    providers := []
    for model in dict_get_or(catalog, "models", []) {
        provider := to_lower(trim(to_string(dict_get_or(model, "provider", ""))))
        provider_seen := false
        for existing_provider in providers {if existing_provider == provider {provider_seen = true}}
        if provider != ""&&provider_seen == false {
            providers := push(providers, provider)
        }
    }
    providers = sort(providers)
    for provider in providers {
        if supported_route_provider(provider) == false {
            errors := push(errors, {"path": "routing.model_catalog", "message": "Unsupported provider adapter: " + provider})
            continue
        }
        if live_mode&&provider == "fixture" {
            errors := push(errors, {"path": "routing.model_catalog", "message": "Fixture providers are offline-only and cannot pass live preflight."})
        } else if live_mode {
            key_env := "OPENAI_API_KEY"
            if provider == "openrouter" {key_env = "OPENROUTER_API_KEY"}
            if provider == "deepseek" {key_env = "DEEPSEEK_API_KEY"}
            if provider == "custom" {key_env = ""}
            if key_env != ""&&trim(to_string(env(key_env))) == "" {
                errors := push(errors, {"path": "environment." + key_env, "message": "Required live-provider credential is not set."})
            }
        }
    }
    if live_mode {
        for agent_id in keys(dict_get_or(workflow, "agents", {})) {
            agent := dict_get_or(workflow["agents"], agent_id, {})
            model := dict_get_or(agent, "model", {})
            if to_lower(trim(to_string(dict_get_or(model, "provider", "")))) == "custom" {
                custom_key_env := trim(to_string(dict_get_or(model, "api_key_env", "")))
                custom_base_url := trim(to_string(dict_get_or(model, "base_url", "")))
                if custom_provider_endpoint_allowed(custom_base_url) == false {
                    errors := push(errors, {"path": "agents." + agent_id + ".model.base_url", "message": "Custom provider base_url must be an exact HTTPS entry in DISPATCH_ALLOWED_CUSTOM_PROVIDER_ORIGINS."})
                }
                if custom_provider_api_key_env_allowed(custom_key_env) == false {
                    errors := push(errors, {"path": "agents." + agent_id + ".model.api_key_env", "message": "Custom provider credential environment variable is not allowed. Use CUSTOM_API_KEY or explicitly allow it with DISPATCH_ALLOWED_CUSTOM_API_KEY_ENVS."})
                } else if custom_key_env == ""||trim(to_string(env(custom_key_env))) == "" {
                    errors := push(errors, {"path": "agents." + agent_id + ".model.api_key_env", "message": "Custom provider credential environment variable is not set."})
                }
            }
        }
    }
    if live_mode {
        bridge_path := trim(to_string(env("DISPATCH_SDK_BRIDGE_SCRIPT")))
        legacy_bridge_path := dispatch_root_path("bridge_chat.kujo")
        if bridge_path == legacy_bridge_path&&file_exists(bridge_path) == false {
            bridge_path = dispatch_root_path("src/bridge/bridge_chat.kujo")
        }
        if bridge_path == "" {bridge_path = dispatch_root_path("src/bridge/bridge_chat.kujo")}
        if file_exists(bridge_path) == false {
            errors := push(errors, {"path": "environment.DISPATCH_SDK_BRIDGE_SCRIPT", "message": "Dispatch AI SDK bridge is unavailable: " + bridge_path})
        }
    }
    mode := "offline"
    if live_mode {mode = "live"}
    return {"ok": len(errors) == 0, "errors": errors, "warnings": warnings, "providers": providers, "mode": mode}
}

func load_routing_command_workflow(command_args, command_name) {
    parsed := parse_cli_args(command_args, {"flags": {"--workflow-file": {"takes_value": true, "default": ""}, "--plugin": {"takes_value": true, "default": ""}, "--step-id": {"takes_value": true, "default": ""}, "--live": {"takes_value": false, "default": false}, "--json": {"takes_value": false, "default": false}}})
    if parsed["ok"] == false {exit_error(parsed["error"]["message"])}
    workflow_file := trim(parsed_flag_value(parsed, "--workflow-file", ""))
    if workflow_file == "" {exit_error("--workflow-file is required for " + command_name + ".")}
    workflow_file_path := normalize_workflow_file_path(workflow_file)
    if workflow_file_path["ok"] == false {exit_error(workflow_file_path["message"])}
    loaded := load_workflow_from_file(workflow_file_path["config_path"])
    if loaded["ok"] == false {exit_error(loaded["error"]["message"])}
    tool_registry := register_default_tools(default_sources_dir())
    plugin_runtime := dispatch_apply_plugins(loaded["workflow"], tool_registry, parsed, command_args, {})
    return {"parsed": parsed, "workflow": plugin_runtime["workflow"]}
}

func run_validate(command_args) {
    loaded := load_routing_command_workflow(command_args, "validate")
    parsed := loaded["parsed"]
    workflow := loaded["workflow"]
    validation := validate_workflow_routing(workflow)
    preflight := routing_environment_preflight(workflow, parsed_has_flag(parsed, "--live"))
    errors := dict_get_or(validation, "errors", [])
    for problem in preflight["errors"] {errors := push(errors, problem)}
    result := {"command": "validate", "ok": len(errors) == 0, "workflow_id": dict_get_or(workflow, "id", ""), "errors": errors, "warnings": dict_get_or(validation, "warnings", []), "preflight": preflight}
    if parsed_has_flag(parsed, "--json") {
        print(to_json(result))
    } else if result["ok"] {
        print("Routing validation passed for workflow: " + result["workflow_id"])
    } else {
        print("Routing validation failed for workflow: " + result["workflow_id"])
        for problem in errors {print("- " + dict_get_or(problem, "field", "routing") + ": " + dict_get_or(problem, "message", "Invalid routing configuration."))}
    }
    if result["ok"] == false {exit(1)}
}

func run_explain_route(command_args) {
    loaded := load_routing_command_workflow(command_args, "explain-route")
    parsed := loaded["parsed"]
    workflow := loaded["workflow"]
    validation := validate_workflow_routing(workflow)
    if validation["ok"] == false {print(to_json({"command": "explain-route", "ok": false, "errors": validation["errors"]})); exit(1)}
    step_id := trim(parsed_flag_value(parsed, "--step-id", ""))
    selected_step := null
    for step in workflow["steps"] {
        if dict_get_or(step, "type", "") == "agent"&&(step_id == ""||dict_get_or(step, "id", "") == step_id) {selected_step = step; break}
    }
    if type(selected_step) != "dict" {exit_error("No matching agent step was found.")}
    routing := dict_get_or(workflow, "routing", {})
    result := resolve_route({"workflow": workflow, "step": selected_step, "step_id": selected_step["id"], "requested_agent_id": dict_get_or(selected_step, "agent_id", ""), "model_catalog": dict_get_or(routing, "model_catalog", {}), "policy_version": dict_get_or(routing, "policy_version", routing_policy_version()), "fallback_index": 0})
    payload := {"command": "explain-route", "ok": dict_get_or(result, "ok", false), "step_id": selected_step["id"], "decision": dict_get_or(result, "decision", null), "candidate_evaluations": dict_get_or(result, "candidate_evaluations", []), "error": dict_get_or(result, "error", null)}
    if parsed_has_flag(parsed, "--json") {
        print(to_json(payload))
    } else if payload["ok"] {
        decision := payload["decision"]
        print("Selected route: " + dict_get_or(decision, "selected_agent_id", "") + " :: " + dict_get_or(decision, "provider_id", "") + " :: " + dict_get_or(decision, "model", ""))
        print("Decision ID: " + dict_get_or(decision, "decision_id", ""))
    } else {
        print("No valid route: " + dict_get_or(dict_get_or(payload, "error", {}), "message", "No route available."))
    }
    if dict_get_or(result, "ok", false) == false {exit(1)}
}

func run_demo(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--config": {"takes_value": true, "default": ""},
            "--workflow": {"takes_value": true, "default": "research-report"},
            "--policy-profile": {"takes_value": true, "default": ""},
            "--tags": {"takes_value": true, "default": ""},
            "--yes": {"takes_value": false, "default": false},
            "--non-interactive": {"takes_value": false, "default": false},
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--sources-dir": {"takes_value": true, "default": default_sources_dir()},
            "--allow-tools": {"takes_value": true, "default": ""},
            "--deny-tools": {"takes_value": true, "default": ""},
            "--decision": {"takes_value": true, "default": ""},
            "--note": {"takes_value": true, "default": ""},
            "--input-json": {"takes_value": true, "default": ""},
            "--workflow-file": {"takes_value": true, "default": ""},
            "--plugin": {"takes_value": true, "default": ""},
            "--webhook-sink": {"takes_value": true, "default": ""},
            "--webhook-url": {"takes_value": true, "default": ""},
            "--leash-url": {"takes_value": true, "default": ""},
            "--cancel-after-step": {"takes_value": true, "default": ""},
            "--trace-max-events": {"takes_value": true, "default": "400"},
            "--trace-max-payload-chars": {"takes_value": true, "default": "2400"}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    config_result := load_command_config(parsed_flag_value(parsed, "--config", ""))
    if config_result["ok"] == false {
        exit_error(config_result["message"])
    }
    config := config_result["config"]

    positionals := parsed_positionals_or_empty(parsed)
    topic := ""
    if len(positionals) > 0 {
        topic = join(positionals, " ")
    } else {
        topic = to_string(config_get_any(config, ["topic"], ""))
    }
    if trim(topic) == "" {
        exit_error("topic is required for demo command.")
    }
    auto_approve := dispatch_resolve_bool_flag(parsed, command_args, "--yes", config, ["yes", "auto_approve"], false)
    non_interactive := dispatch_resolve_bool_flag(parsed, command_args, "--non-interactive", config, ["non_interactive", "non-interactive"], false)
    interactive := non_interactive == false
    workflow_template_id := dispatch_resolve_string_flag(parsed, command_args, "--workflow", config, ["workflow", "workflow_template_id"], "research-report")
    tags := parse_tool_name_list(dispatch_resolve_string_flag(parsed, command_args, "--tags", config, ["tags"], ""))
    output_root := resolve_output_root_or_exit(dispatch_resolve_string_flag(parsed, command_args, "--output-root", config, ["output_root", "output-root"], "outputs"))
    sources_dir := dispatch_resolve_string_flag(parsed, command_args, "--sources-dir", config, ["sources_dir", "sources-dir"], default_sources_dir())
    simulated_decision := dispatch_resolve_string_flag(parsed, command_args, "--decision", config, ["decision"], "")
    simulated_note := dispatch_resolve_string_flag(parsed, command_args, "--note", config, ["note"], "")
    webhook_sink := resolve_webhook_sink_or_exit(dispatch_resolve_string_flag(parsed, command_args, "--webhook-sink", config, ["webhook_sink", "webhook-sink"], ""))
    webhook_url := trim(dispatch_resolve_string_flag(parsed, command_args, "--webhook-url", config, ["webhook_url", "webhook-url"], ""))
    leash_url := trim(dispatch_resolve_string_flag(parsed, command_args, "--leash-url", config, ["leash_url", "leash-url"], ""))
    cancel_after_step := trim(dispatch_resolve_string_flag(parsed, command_args, "--cancel-after-step", config, ["cancel_after_step", "cancel-after-step"], ""))
    trace_max_events_result := parse_non_negative_number(dispatch_resolve_string_flag(parsed, command_args, "--trace-max-events", config, ["trace_max_events", "trace-max-events"], "400"), "--trace-max-events", 400)
    trace_max_payload_result := parse_non_negative_number(dispatch_resolve_string_flag(parsed, command_args, "--trace-max-payload-chars", config, ["trace_max_payload_chars", "trace-max-payload-chars"], "2400"), "--trace-max-payload-chars", 2400)
    if trace_max_events_result["ok"] == false {
        exit_error(trace_max_events_result["message"])
    }
    if trace_max_payload_result["ok"] == false {
        exit_error(trace_max_payload_result["message"])
    }
    trace_max_events := trace_max_events_result["value"]
    trace_max_payload_chars := trace_max_payload_result["value"]
    tool_policy_settings := dispatch_resolve_tool_policy_settings(parsed, command_args, config)
    if dict_get_or(tool_policy_settings, "ok", true) == false {
        exit_error(dict_get_or(tool_policy_settings, "message", "Invalid tool policy profile configuration."))
    }
    if trace_max_events <= 0 {
        trace_max_events = 400
    }
    if trace_max_payload_chars <= 0 {
        trace_max_payload_chars = 2400
    }

    validation := validate_demo_inputs(topic, sources_dir, simulated_decision)
    if validation["ok"] == false {
        exit_error(validation["message"])
    }
    simulated_decision := validation["normalized_decision"]

    run_input := {"topic": topic}
    input_json_raw := trim(dispatch_resolve_string_flag(parsed, command_args, "--input-json", config, ["input_json", "input-json"], ""))
    if input_json_raw != "" {
        parsed_input := null
        try {
            parsed_input = parse_json(input_json_raw)
        } except err {
            exit_error("Invalid --input-json: expected a JSON object.")
        }
        if type(parsed_input) != "dict" {
            exit_error("Invalid --input-json: expected a JSON object.")
        }
        for input_key in keys(parsed_input) {
            run_input[input_key] := parsed_input[input_key]
        }
        if key_exists(run_input, "topic") == false {
            run_input["topic"] := topic
        }
    }

    workflow_file := trim(dispatch_resolve_string_flag(parsed, command_args, "--workflow-file", config, ["workflow_file", "workflow-file"], ""))
    workflow := dispatch_resolve_workflow(workflow_file, workflow_template_id, topic, auto_approve)
    if workflow_file != "" {
        workflow_template_id = dict_get_or(workflow, "id", workflow_template_id)
    }
    tool_registry := register_default_tools(sources_dir)
    plugin_runtime := dispatch_apply_plugins(workflow, tool_registry, parsed, command_args, config)
    workflow = plugin_runtime["workflow"]
    tool_registry = plugin_runtime["tool_registry"]
    run_state := create_run_state(workflow, run_input, output_root, {
        "auto_approve": auto_approve,
        "interactive": interactive,
        "sources_dir": sources_dir,
        "workflow_template_id": workflow_template_id,
        "tags": tags,
        "allowed_tools": dict_get_or(tool_policy_settings, "allowed_tools", []),
        "denied_tools": dict_get_or(tool_policy_settings, "denied_tools", []),
        "trace_max_events": trace_max_events,
        "trace_max_payload_chars": trace_max_payload_chars
    })
    result := run_workflow(workflow, run_state, tool_registry, {
        "auto_approve": auto_approve,
        "interactive": interactive,
        "command_name": "demo",
        "tool_authorization_policy": dict_get_or(tool_policy_settings, "policy", null),
        "simulated_decision": simulated_decision,
        "simulated_note": simulated_note,
        "webhook_sink": webhook_sink,
        "webhook_url": webhook_url,
        "leash_url": leash_url,
        "leash_callback_url": leash_url,
        "cancel_after_step_id": cancel_after_step,
        "event_hook": plugin_runtime["event_hook"]
    })

    final_state := result["run_state"]
    print_run_completion(final_state)
    print_report_path_if_present(final_state)
    print_kv("State", final_state["run_dir"] + "/state.json")
    print_kv("Trace", final_state["run_dir"] + "/trace.json")

    if result["ok"] == false {
        exit_error(to_json(result["error"]))
    }
    if result["paused"] {
        print("Workflow paused. Resume with: kujo run dispatch.kujo resume " + final_state["run_id"])
    }
}

func run_show(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--json": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) < 1 {
        exit_error("run-id is required for show command.")
    }
    run_id := positionals[0]
    json_output := parsed_has_flag(parsed, "--json")
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    loaded := load_run_state(output_root, run_id)
    if loaded["ok"] == false {
        exit_error(loaded["error"]["message"])
    }
    run_state := loaded["run_state"]
    summary := summarize_run(run_state)
    contract := build_contract_metadata(run_state)
    artifacts := build_artifact_paths(run_state)
    if json_output {
        payload := {
            "command": "show",
            "ok": true,
            "run_id": run_state["run_id"],
            "output_root": output_root,
            "contract": contract,
            "summary": summary,
            "artifacts": artifacts
        }
        print(to_json(payload))
        return
    }
    print(to_json(summary))
    print_report_path_if_present(run_state)
}

func run_inspect(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--json": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) < 1 {
        exit_error("run-id is required for inspect command.")
    }
    run_id := positionals[0]
    json_output := parsed_has_flag(parsed, "--json")
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    loaded := load_run_state(output_root, run_id)
    if loaded["ok"] == false {
        exit_error(loaded["error"]["message"])
    }
    run_state := loaded["run_state"]
    topic := dict_get_or(dict_get_or(run_state, "input", {}), "topic", "")
    summary := summarize_run(run_state)
    contract := build_contract_metadata(run_state)
    artifacts := build_artifact_paths(run_state)
    if json_output {
        payload := {
            "command": "inspect",
            "ok": true,
            "run_id": run_state["run_id"],
            "output_root": output_root,
            "contract": contract,
            "summary": summary,
            "topic": topic,
            "health": dict_get_or(run_state, "health", {}),
            "steps": dict_get_or(run_state, "steps", []),
            "approvals": dict_get_or(run_state, "approvals", []),
            "handoffs": dict_get_or(run_state, "handoffs", []),
            "routing": {
                "decisions": dict_get_or(run_state, "route_decisions", {}),
                "attempts": dict_get_or(run_state, "route_attempts", {})
            },
            "errors": dict_get_or(run_state, "errors", []),
            "artifacts": artifacts
        }
        print(to_json(payload))
        return
    }
    print_kv("Run", run_state["run_id"])
    print_kv("Status", run_state["status"])
    print_kv("Workflow", run_state["workflow_name"])
    print_kv("Topic", topic)
    print_kv("Step Index", to_string(run_state["current_step_index"]) + "/" + to_string(len(run_state["steps"])))
    print_kv("Health Issues", len(run_state["health"]["issues"]))
    issue_index := 0
    while issue_index < len(run_state["health"]["issues"]) {
        print_item("issue: " + run_state["health"]["issues"][issue_index])
        issue_index := issue_index + 1
    }
    print_kv("Step Status Counts", to_json(run_state["health"]["step_status_counts"]))
    print_kv("Approvals", to_string(len(run_state["approvals"])) + " | Handoffs: " + to_string(len(run_state["handoffs"])) + " | Errors: " + to_string(len(run_state["errors"])))
    print_artifact_summary(run_state)
    print("")
    print("Steps:")
    step_index := 0
    while step_index < len(run_state["steps"]) {
        step := run_state["steps"][step_index]
        print_item(step["id"] + " | " + step["type"] + " | status=" + step["status"] + " | attempts=" + to_string(dict_get_or(step, "attempts", 0)))
        step_index := step_index + 1
    }
}

func run_resume(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--config": {"takes_value": true, "default": ""},
            "--workflow": {"takes_value": true, "default": ""},
            "--policy-profile": {"takes_value": true, "default": ""},
            "--yes": {"takes_value": false, "default": false},
            "--non-interactive": {"takes_value": false, "default": false},
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--sources-dir": {"takes_value": true, "default": default_sources_dir()},
            "--allow-tools": {"takes_value": true, "default": ""},
            "--deny-tools": {"takes_value": true, "default": ""},
            "--decision": {"takes_value": true, "default": ""},
            "--note": {"takes_value": true, "default": ""},
            "--plugin": {"takes_value": true, "default": ""},
            "--webhook-sink": {"takes_value": true, "default": ""},
            "--webhook-url": {"takes_value": true, "default": ""},
            "--leash-url": {"takes_value": true, "default": ""},
            "--cancel-after-step": {"takes_value": true, "default": ""},
            "--trace-max-events": {"takes_value": true, "default": "400"},
            "--trace-max-payload-chars": {"takes_value": true, "default": "2400"}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    config_result := load_command_config(parsed_flag_value(parsed, "--config", ""))
    if config_result["ok"] == false {
        exit_error(config_result["message"])
    }
    config := config_result["config"]

    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) < 1 {
        exit_error("run-id is required for resume command.")
    }
    run_id := positionals[0]
    auto_approve := dispatch_resolve_bool_flag(parsed, command_args, "--yes", config, ["yes", "auto_approve"], false)
    non_interactive := dispatch_resolve_bool_flag(parsed, command_args, "--non-interactive", config, ["non_interactive", "non-interactive"], false)
    interactive := non_interactive == false
    workflow_template_flag := dispatch_resolve_string_flag(parsed, command_args, "--workflow", config, ["workflow", "workflow_template_id"], "")
    output_root := resolve_output_root_or_exit(dispatch_resolve_string_flag(parsed, command_args, "--output-root", config, ["output_root", "output-root"], "outputs"))
    sources_dir := dispatch_resolve_string_flag(parsed, command_args, "--sources-dir", config, ["sources_dir", "sources-dir"], default_sources_dir())
    simulated_decision := dispatch_resolve_string_flag(parsed, command_args, "--decision", config, ["decision"], "")
    simulated_note := dispatch_resolve_string_flag(parsed, command_args, "--note", config, ["note"], "")
    webhook_sink := resolve_webhook_sink_or_exit(dispatch_resolve_string_flag(parsed, command_args, "--webhook-sink", config, ["webhook_sink", "webhook-sink"], ""))
    webhook_url := trim(dispatch_resolve_string_flag(parsed, command_args, "--webhook-url", config, ["webhook_url", "webhook-url"], ""))
    leash_url := trim(dispatch_resolve_string_flag(parsed, command_args, "--leash-url", config, ["leash_url", "leash-url"], ""))
    cancel_after_step := trim(dispatch_resolve_string_flag(parsed, command_args, "--cancel-after-step", config, ["cancel_after_step", "cancel-after-step"], ""))
    trace_max_events_result := parse_non_negative_number(dispatch_resolve_string_flag(parsed, command_args, "--trace-max-events", config, ["trace_max_events", "trace-max-events"], "400"), "--trace-max-events", 400)
    trace_max_payload_result := parse_non_negative_number(dispatch_resolve_string_flag(parsed, command_args, "--trace-max-payload-chars", config, ["trace_max_payload_chars", "trace-max-payload-chars"], "2400"), "--trace-max-payload-chars", 2400)
    if trace_max_events_result["ok"] == false {
        exit_error(trace_max_events_result["message"])
    }
    if trace_max_payload_result["ok"] == false {
        exit_error(trace_max_payload_result["message"])
    }
    trace_max_events := trace_max_events_result["value"]
    trace_max_payload_chars := trace_max_payload_result["value"]
    tool_policy_settings := dispatch_resolve_tool_policy_settings(parsed, command_args, config)
    if dict_get_or(tool_policy_settings, "ok", true) == false {
        exit_error(dict_get_or(tool_policy_settings, "message", "Invalid tool policy profile configuration."))
    }
    if trace_max_events <= 0 {
        trace_max_events = 400
    }
    if trace_max_payload_chars <= 0 {
        trace_max_payload_chars = 2400
    }
    validation := validate_demo_inputs("resume", sources_dir, simulated_decision)
    if validation["ok"] == false {
        exit_error(validation["message"])
    }
    simulated_decision := validation["normalized_decision"]

    loaded := load_run_state(output_root, run_id)
    if loaded["ok"] == false {
        exit_error(loaded["error"]["message"])
    }
    run_state := loaded["run_state"]
    run_state["trace"] = apply_trace_limits(run_state["trace"], {
        "trace_max_events": trace_max_events,
        "trace_max_payload_chars": trace_max_payload_chars
    })
    if run_state["status"] == "completed" {
        print("Run is already completed: " + run_id)
        return
    }
    if run_state["status"] == "failed" {
        print("Run is failed and cannot resume automatically: " + run_id)
        exit(1)
    }
    if run_state["status"] == "rejected" {
        print("Run was rejected and cannot resume automatically: " + run_id)
        exit(1)
    }
    if run_state["status"] == "cancelled" {
        print("Run was cancelled and cannot resume automatically: " + run_id)
        exit(1)
    }
    current_control_boundary := dict_get_or(run_state, "current_control_boundary", null)
    if type(current_control_boundary) == "dict"&&dict_get_or(current_control_boundary, "status", "") == "open" {
        print("Run is paused at a policy boundary and requires an explicit revision-bound resume-decision: " + run_id)
        exit(1)
    }

    topic := ""
    if has_key(run_state["input"], "topic") {
        topic := run_state["input"]["topic"]
    }
    workflow := dispatch_resolve_resume_workflow(run_state, workflow_template_flag, topic, auto_approve)
    tool_registry := register_default_tools(sources_dir)
    plugin_runtime := dispatch_apply_plugins(workflow, tool_registry, parsed, command_args, config)
    workflow = plugin_runtime["workflow"]
    tool_registry = plugin_runtime["tool_registry"]
    result := run_workflow(workflow, run_state, tool_registry, {
        "auto_approve": auto_approve,
        "interactive": interactive,
        "command_name": "resume",
        "tool_authorization_policy": dict_get_or(tool_policy_settings, "policy", null),
        "simulated_decision": simulated_decision,
        "simulated_note": simulated_note,
        "webhook_sink": webhook_sink,
        "webhook_url": webhook_url,
        "leash_url": leash_url,
        "leash_callback_url": leash_url,
        "cancel_after_step_id": cancel_after_step,
        "event_hook": plugin_runtime["event_hook"],
        "trace_max_events": trace_max_events,
        "trace_max_payload_chars": trace_max_payload_chars
    })
    final_state := result["run_state"]
    print_run_completion(final_state)
    if result["paused"] {
        print("Workflow still paused.")
    }
    if result["ok"] == false {
        exit_error(to_json(result["error"]))
    }
}

func resume_decision_error(code, message) {
    return {
        "ok": false,
        "error": {
            "code": code,
            "message": message,
            "retryable": false
        }
    }
}

func close_control_boundary(run_state, decision) {
    boundary_id := dict_get_or(decision, "boundary_id", "")
    boundaries := dict_get_or(run_state, "control_boundaries", [])
    index := 0
    closed := null
    while index < len(boundaries) {
        boundary := boundaries[index]
        if dict_get_or(boundary, "boundary_id", "") == boundary_id {
            boundary["status"] := "closed"
            boundary["decision"] := decision
            boundary["closed_at"] := format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
            boundaries[index] := boundary
            closed = boundary
            break
        }
        index = index + 1
    }
    if type(closed) != "dict" {return {"ok": false, "run_state": run_state}}
    run_state["control_boundaries"] := boundaries
    run_state["current_control_boundary"] := closed
    barrier := dict_get_or(run_state, "control_barrier", null)
    if type(barrier) == "dict"&&dict_get_or(barrier, "boundary_id", "") == boundary_id {
        barrier["status"] := "released"
        barrier["released_by_decision_id"] := dict_get_or(decision, "decision_id", "")
        run_state["control_barrier"] := barrier
    }
    return {"ok": true, "run_state": run_state, "boundary": closed}
}

func load_amended_inputs(input_ref) {
    path := trim(to_string(input_ref))
    if path == ""||starts_with(path, "/")||starts_with(path, "~/")||contains(path, "..")||contains(to_lower(path), "%2f")||contains(to_lower(path), "%5c") {
        return resume_decision_error("invalid_input_ref", "Amended input_ref must be a relative traversal-free JSON path.")
    }
    if file_exists(path) == false||file_size(path) > 1048576 {
        return resume_decision_error("invalid_input_ref", "Amended input_ref is missing or exceeds 1 MiB.")
    }
    body := ""
    try {body = read_file_beneath(".", path, 1048576)} except err {return resume_decision_error("invalid_input_ref", "Amended input must be a bounded regular file below the project root.")}
    amended := null
    try {amended = parse_json(body)} except err {return resume_decision_error("invalid_input_ref", "Amended input must be valid JSON.")}
    if type(amended) != "dict" {
        return resume_decision_error("invalid_input_ref", "Amended input_ref must contain a JSON object.")
    }
    return {"ok": true, "input": amended, "path": path, "sha256": sha256(body)}
}

func run_v2_resume_decision(decision, parsed, command_args, config, tool_policy_settings) {
    run_id := trim(to_string(dict_get_or(decision, "run_id", "")))
    decision_id := trim(to_string(dict_get_or(decision, "decision_id", "")))
    if run_id == "" {exit_error("Dispatch v2 decisions require the additive run_id routing field.")}
    output_root := resolve_output_root_or_exit(dispatch_resolve_string_flag(parsed, command_args, "--output-root", config, ["output_root", "output-root"], "outputs"))
    loaded := load_run_state(output_root, run_id)
    if loaded["ok"] == false {exit_error(loaded["error"]["message"])}
    lock := acquire_run_lock(loaded["run_state"])
    if lock["ok"] == false {exit_error(to_json(lock["error"]))}
    # Reload after locking so concurrent callers cannot validate stale snapshots.
    loaded = load_run_state(output_root, run_id)
    if loaded["ok"] == false {exit_error(to_json(loaded["error"]))}
    run_state := loaded["run_state"]
    recovered := reconcile_control_journal(run_state)
    if recovered["ok"] == false {exit_error(to_json(recovered["error"]))}
    decision_digest := sha256(to_json(decision))
    decision_history := dict_get_or(run_state, "human_decisions", {})
    if type(decision_history) != "dict" {decision_history = {}}
    if has_key(decision_history, decision_id)&&dict_get_or(decision_history[decision_id], "decision_sha256", "") != decision_digest {exit_error("conflicting_intervention_decision")}
    if has_key(decision_history, decision_id)&&dict_get_or(decision_history[decision_id], "status", "") == "claimed" {exit_error("control_recovery_required: decision was claimed; do not replay automatically")}
    if has_key(decision_history, decision_id)&&dict_get_or(decision_history[decision_id], "status", "") == "applied" {
        release_run_lock(lock)
        print(to_json({"status": "already_applied", "run_id": run_id, "decision_id": decision_id}))
        return
    }
    checkpoint_id := parsed_flag_value(parsed, "--checkpoint", "")
    if checkpoint_id != "" {
        checked := validate_review_checkpoint(run_state, checkpoint_id)
        if checked["ok"] == false {exit_error(to_json(checked["error"]))}
    }
    validated := validate_intervention_decision(decision, run_state)
    if dict_get_or(validated, "ok", false) == false {exit_error(to_json(validated["error"]))}
    prepared := prepare_intervention_continuation(run_state, decision)
    if dict_get_or(prepared, "ok", false) == false {exit_error(to_json(prepared["error"]))}
    run_state = prepared["run_state"]
    action := dict_get_or(decision, "action", "")
    amended_result := null
    if action == "amend_inputs" {
        amended_result = load_amended_inputs(dict_get_or(dict_get_or(decision, "continuation", {}), "input_ref", ""))
        if dict_get_or(amended_result, "ok", false) == false {exit_error(to_json(amended_result["error"]))}
        run_state["input"] := amended_result["input"]
        data := dict_get_or(run_state, "data", {})
        data["input"] := amended_result["input"]
        run_state["data"] := data
    }
    closed := close_control_boundary(run_state, decision)
    if dict_get_or(closed, "ok", false) == false {exit_error("Open control boundary could not be closed.")}
    run_state = closed["run_state"]
    decision_history[decision_id] := {
        "schema": "kujo.intervention-decision-receipt/v1",
        "request_id": dict_get_or(decision, "request_id", ""),
        "boundary_id": dict_get_or(decision, "boundary_id", ""),
        "action": action,
        "actor": dict_get_or(decision, "actor", {}),
        "status": "claimed", "decision_sha256": decision_digest,
        "claimed_at": format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
    }
    if type(amended_result) == "dict" {
        decision_history[decision_id]["amended_input"] := {"path": amended_result["path"], "sha256": amended_result["sha256"]}
    }
    run_state["human_decisions"] := decision_history
    run_state["last_human_decision"] := decision
    run_state["human_intervention"] := null
    journaled := append_control_event(run_state, "intervention_decision", dict_get_or(closed["boundary"], "step_id", ""), [decision_id, dict_get_or(decision, "request_id", ""), dict_get_or(decision, "boundary_id", "")], {"action": action, "decision": decision, "decision_sha256": decision_digest, "continuation_mode": dict_get_or(prepared, "mode", "")})
    run_state = journaled["run_state"]
    run_state["trace"] := append_trace(run_state["trace"], "intervention_decision", dict_get_or(closed["boundary"], "step_id", ""), "Control boundary decision accepted: " + action, {"decision_id": decision_id, "boundary_id": dict_get_or(decision, "boundary_id", "")})
    mode := dict_get_or(prepared, "mode", "continue")
    if mode == "abort"||mode == "cancel" {
        terminal_status := "failed"
        if mode == "cancel" {terminal_status = "cancelled"}
        run_state["status"] := terminal_status
        run_state["completed_at"] := format_date(now(), "YYYY-MM-DD HH:mm:ss")
        run_state["trace"] := finalize_trace(run_state["trace"], terminal_status)
        record := decision_history[decision_id]
        record["status"] := "applied"
        record["finished_at"] := format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
        decision_history[decision_id] := record
        run_state["human_decisions"] := decision_history
        journaled = append_control_event(run_state, "workflow_" + terminal_status, dict_get_or(closed["boundary"], "step_id", ""), [decision_id], {"action": action})
        run_state = journaled["run_state"]
        run_state = persist_run_state(run_state)
        release_run_lock(lock)
        print_run_completion(run_state)
        print(to_json({"status": terminal_status, "run_id": run_id, "decision_id": decision_id, "boundary_id": dict_get_or(decision, "boundary_id", "")}))
        return
    }
    run_state["status"] := "paused"
    run_state = persist_run_state(run_state)
    topic := dict_get_or(dict_get_or(run_state, "input", {}), "topic", "")
    workflow := dispatch_resolve_resume_workflow(run_state, "", topic, false)
    sources_dir := parsed_flag_value(parsed, "--sources-dir", default_sources_dir())
    tool_registry := register_default_tools(sources_dir)
    plugin_runtime := dispatch_apply_plugins(workflow, tool_registry, parsed, command_args, config)
    workflow = plugin_runtime["workflow"]
    tool_registry = plugin_runtime["tool_registry"]
    result := run_workflow_under_lock(workflow, run_state, tool_registry, {
        "auto_approve": false,
        "interactive": false,
        "command_name": "resume-decision",
        "tool_authorization_policy": tool_policy_settings["policy"],
        "webhook_sink": resolve_webhook_sink_or_exit(parsed_flag_value(parsed, "--webhook-sink", "")),
        "webhook_url": trim(parsed_flag_value(parsed, "--webhook-url", "")),
        "leash_url": trim(parsed_flag_value(parsed, "--leash-url", "")),
        "leash_callback_url": trim(parsed_flag_value(parsed, "--leash-url", "")),
        "event_hook": plugin_runtime["event_hook"]
    })
    final_state := result["run_state"]
    final_history := dict_get_or(final_state, "human_decisions", {})
    record := dict_get_or(final_history, decision_id, decision_history[decision_id])
    record["status"] := "applied"
    if result["ok"] == false&&dict_get_or(result, "cancelled", false) == false {record["status"] := "failed"}
    record["finished_at"] := format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
    final_history[decision_id] := record
    final_state["human_decisions"] := final_history
    journaled = append_control_event(final_state, "continuation_finished", dict_get_or(closed["boundary"], "step_id", ""), [decision_id], {"action": action, "run_status": dict_get_or(final_state, "status", "")})
    final_state = journaled["run_state"]
    final_state = persist_run_state(final_state)
    release_run_lock(lock)
    print_run_completion(final_state)
    print(to_json({"status": dict_get_or(final_state, "status", "unknown"), "run_id": run_id, "decision_id": decision_id, "boundary_id": dict_get_or(decision, "boundary_id", "")}))
    if result["ok"] == false&&dict_get_or(result, "cancelled", false) == false {exit_error(to_json(result["error"]))}
}

func run_recover(command_args) {
    parsed := parse_cli_args(command_args, {"flags":{"--output-root":{"takes_value":true,"default":"outputs"},"--json":{"takes_value":false,"default":false},"--operator":{"takes_value":true,"default":""}}})
    if parsed["ok"] == false {exit_error(parsed["error"]["message"])}
    args := parsed_positionals_or_empty(parsed)
    if len(args) < 2 {exit_error("recover requires inspect|plan|apply and run ID")}
    root := parsed_flag_value(parsed,"--output-root","outputs");result := {}
    if args[0] == "inspect"&&len(args) == 2 {result = inspect_retained_run(root,args[1])}
    else if args[0] == "plan"&&len(args) == 2 {result = plan_retained_reconciliation(root,args[1])}
    else if args[0] == "apply"&&len(args) == 3 {result = apply_retained_reconciliation(root,args[1],parse_json(read_file_beneath(dirname(args[2]),basename(args[2]),1048576)),parsed_flag_value(parsed,"--operator",""))}
    else {exit_error("recover requires inspect|plan <run> or apply <run> <plan.json> --operator <id>")}
    if parsed_has_flag(parsed,"--json") {print(to_json(result))}
    else {
        print("Retained-host recovery: " + args[1])
        if has_key(result,"assessment") {report := result["assessment"];print("State revision: " + to_string(report["state_revision"]));print("Journal sequence: " + to_string(report["journal_sequence"]));print("Classification: " + report["classification"]);print("Safe repairs: " + to_json(report["safe_repairs"]));print("Unresolved: " + to_json(report["unresolved"]));print("Orphans: " + to_json(report["orphans"]))} else {print(to_json(result))}
        print("Continuation is not authorized. Consumed work stays consumed.")
        if has_key(result,"plan") {print("Plan: " + to_json(result["plan"]))}
    }
    if result["ok"] == false {exit(1)}
}

func run_checkpoint(command_args) {
    parsed := parse_cli_args(command_args, {"flags": {"--output-root": {"takes_value": true, "default": "outputs"}}})
    if parsed["ok"] == false {exit_error(parsed["error"]["message"])}
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) != 1 {exit_error("checkpoint requires one run ID.")}
    result := publish_review_checkpoint(parsed_flag_value(parsed, "--output-root", "outputs"), to_string(positionals[0]))
    if result["ok"] == false {exit_error(to_json(result["error"]))}
    print(to_json(result))
}

func run_resume_decision(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--config": {"takes_value": true, "default": ""},
            "--policy-profile": {"takes_value": true, "default": ""},
            "--allow-tools": {"takes_value": true, "default": ""},
            "--deny-tools": {"takes_value": true, "default": ""},
            "--checkpoint": {"takes_value": true, "default": ""},
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--sources-dir": {"takes_value": true, "default": default_sources_dir()},
            "--non-interactive": {"takes_value": false, "default": false},
            "--leash-url": {"takes_value": true, "default": ""},
            "--webhook-sink": {"takes_value": true, "default": ""},
            "--webhook-url": {"takes_value": true, "default": ""}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    # Resolve operator policy before a decision can claim or mutate persisted state.
    config_result := load_command_config(parsed_flag_value(parsed, "--config", ""))
    if config_result["ok"] == false {exit_error(config_result["message"])}
    config := config_result["config"]
    tool_policy_settings := dispatch_resolve_tool_policy_settings(parsed, command_args, config)
    if dict_get_or(tool_policy_settings, "ok", false) == false {exit_error(dict_get_or(tool_policy_settings, "message", "Invalid tool policy configuration."))}
    webhook_validation := validate_webhook_options({"webhook_url": trim(parsed_flag_value(parsed, "--webhook-url", "")), "leash_url": trim(parsed_flag_value(parsed, "--leash-url", ""))})
    if webhook_validation["ok"] == false {exit_error(to_json(webhook_validation["error"]))}
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) < 1 {
        exit_error("decision JSON path is required for resume-decision command.")
    }
    decision_path := to_string(positionals[0])
    decision := null
    try {decision = parse_json(read_file_beneath(dirname(decision_path), basename(decision_path), 1048576))} except err {exit_error("Decision must be a bounded regular JSON file (1 MiB maximum).")}
    if type(decision) != "dict" {
        exit_error("Decision payload could not be read as JSON.")
    }
    if dict_get_or(decision, "schema", "") == "kujo.intervention-decision/v2" {
        run_v2_resume_decision(decision, parsed, command_args, config, tool_policy_settings)
        return
    }
    if parsed_flag_value(parsed, "--checkpoint", "") != "" {exit_error("Review checkpoints require a v2 intervention decision.")}
    run_id := trim(to_string(dict_get_or(decision, "run_id", "")))
    step_id := trim(to_string(dict_get_or(decision, "step_id", "")))
    event_id := trim(to_string(dict_get_or(decision, "event_id", "")))
    decision_id := trim(to_string(dict_get_or(decision, "decision_id", "")))
    decision_value := to_lower(trim(to_string(dict_get_or(decision, "decision", ""))))
    if run_id == ""||step_id == ""||event_id == ""||decision_id == "" {
        exit_error(resume_decision_error("invalid_resume_request", "Decision must contain decision_id, event_id, run_id, and step_id.")["error"]["message"])
    }
    decision_map := {
        "approve": "approve",
        "approved": "approve",
        "reject": "reject",
        "rejected": "reject",
        "request_changes": "changes",
        "changes": "changes",
        "reply": "reply",
        "cancel": "cancel"
    }
    if key_exists(decision_map, decision_value) == false {
        exit_error("Unsupported decision value: " + decision_value)
    }
    output_root := resolve_output_root_or_exit(dispatch_resolve_string_flag(parsed, command_args, "--output-root", config, ["output_root", "output-root"], "outputs"))
    loaded := load_run_state(output_root, run_id)
    if loaded["ok"] == false {
        exit_error(loaded["error"]["message"])
    }
    lock := acquire_run_lock(loaded["run_state"])
    if lock["ok"] == false {exit_error(to_json(lock["error"]))}
    # Validation, claim, execution and receipt publication share one lock.
    loaded = load_run_state(output_root, run_id)
    if loaded["ok"] == false {exit_error(to_json(loaded["error"]))}
    run_state := loaded["run_state"]
    recovered := reconcile_control_journal(run_state)
    if recovered["ok"] == false {exit_error(to_json(recovered["error"]))}
    run_state = recovered["run_state"]
    human_event := dict_get_or(run_state, "human_intervention", {})
    if dict_get_or(human_event, "event_id", "") != event_id||dict_get_or(dict_get_or(human_event, "run", {}), "step_id", "") != step_id {
        exit_error("Resume request does not match the currently suspended event and step.")
    }
    if dict_get_or(dict_get_or(human_event, "run", {}), "run_id", "") != run_id {
        exit_error("Resume request is bound to a different run.")
    }
    expected_decision_id := trim(to_string(dict_get_or(dict_get_or(human_event, "security", {}), "decision_id", "")))
    if expected_decision_id == ""||decision_id != expected_decision_id {
        exit_error("Resume request decision_id does not match the current approval.")
    }
    decision_history := dict_get_or(run_state, "human_decisions", {})
    if type(decision_history) != "dict" {
        decision_history := {}
    }
    if has_key(decision_history, decision_id)&&dict_get_or(decision_history[decision_id], "status", "") == "claimed" {exit_error("control_recovery_required: decision was claimed; do not replay automatically")}
    if has_key(decision_history, decision_id)&&dict_get_or(decision_history[decision_id], "status", "") == "applied" {
        release_run_lock(lock)
        print(to_json({"status": "already_applied", "run_id": run_id, "decision_id": decision_id}))
        return
    }
    if dict_get_or(run_state, "status", "") != "paused"&&dict_get_or(run_state, "status", "") != "needs_changes" {
        release_run_lock(lock)
        print(to_json({"status": "already_terminal", "run_id": run_id, "decision_id": decision_id, "run_status": dict_get_or(run_state, "status", "")}))
        return
    }
    topic := dict_get_or(dict_get_or(run_state, "input", {}), "topic", "")
    workflow := dispatch_resolve_resume_workflow(run_state, "", topic, false)
    decision_history[decision_id] := {
        "event_id": event_id,
        "step_id": step_id,
        "decision": decision_value,
        "status": "claimed",
        "claimed_at": format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
    }
    run_state["human_decisions"] := decision_history
    run_state["last_human_decision"] := decision
    run_state := persist_run_state(run_state)
    sources_dir := parsed_flag_value(parsed, "--sources-dir", default_sources_dir())
    tool_registry := register_default_tools(sources_dir)
    plugin_runtime := dispatch_apply_plugins(workflow, tool_registry, parsed, command_args, config)
    workflow = plugin_runtime["workflow"]
    tool_registry = plugin_runtime["tool_registry"]
    options := {
        "auto_approve": false,
        "interactive": false,
        "command_name": "resume-decision",
        "tool_authorization_policy": tool_policy_settings["policy"],
        "simulated_decision": decision_map[decision_value],
        "simulated_decision_step_id": step_id,
        "simulated_note": dict_get_or(decision, "response", ""),
        "webhook_sink": resolve_webhook_sink_or_exit(parsed_flag_value(parsed, "--webhook-sink", "")),
        "webhook_url": trim(parsed_flag_value(parsed, "--webhook-url", "")),
        "leash_url": trim(parsed_flag_value(parsed, "--leash-url", "")),
        "leash_callback_url": trim(parsed_flag_value(parsed, "--leash-url", "")),
        "event_hook": plugin_runtime["event_hook"]
    }
    if decision_value == "reply" {
        options["simulated_decision"] := "changes"
    }
    if decision_value == "cancel" {
        options["simulated_decision"] := ""
        options["cancel_requested"] := true
    }
    result := run_workflow_under_lock(workflow, run_state, tool_registry, options)
    final_state := result["run_state"]
    final_history := dict_get_or(final_state, "human_decisions", {})
    decision_record := dict_get_or(final_history, decision_id, {})
    decision_record["status"] := "applied"
    if result["ok"] == false&&dict_get_or(result, "cancelled", false) == false {
        decision_record["status"] := "failed"
    }
    decision_record["finished_at"] := format_date(now(), "YYYY-MM-DDTHH:mm:ssZ")
    final_history[decision_id] := decision_record
    final_state["human_decisions"] := final_history
    final_state := persist_run_state(final_state)
    release_run_lock(lock)
    print_run_completion(final_state)
    resume_status := dict_get_or(final_state, "status", "unknown")
    if result["paused"] {
        resume_status := "paused_again"
    }
    print(to_json({"status": resume_status, "run_id": run_id, "decision_id": decision_id, "event_id": event_id}))
    if result["ok"] == false&&dict_get_or(result, "cancelled", false) == false {
        exit_error(to_json(result["error"]))
    }
}

func run_runs(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--status": {"takes_value": true, "default": ""},
            "--workflow": {"takes_value": true, "default": ""},
            "--topic": {"takes_value": true, "default": ""},
            "--tags": {"takes_value": true, "default": ""},
            "--issues-only": {"takes_value": false, "default": false},
            "--limit": {"takes_value": true, "default": "50"},
            "--offset": {"takes_value": true, "default": "0"},
            "--json": {"takes_value": false, "default": false},
            "--diagnostics": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    output_root_raw := parsed_flag_value(parsed, "--output-root", "outputs")
    output_root := resolve_output_root_or_exit(output_root_raw)
    status_filter := validate_status_filter_or_exit(parsed_flag_value(parsed, "--status", ""), "--status")
    workflow_filter := parsed_flag_value(parsed, "--workflow", "")
    topic_filter := parsed_flag_value(parsed, "--topic", "")
    tags_filter := parsed_flag_value(parsed, "--tags", "")
    issues_only := parsed_has_flag(parsed, "--issues-only")
    limit_result := parse_non_negative_number(parsed_flag_value(parsed, "--limit", "50"), "--limit", 50)
    if limit_result["ok"] == false {
        exit_error(limit_result["message"])
    }
    offset_result := parse_non_negative_number(parsed_flag_value(parsed, "--offset", "0"), "--offset", 0)
    if offset_result["ok"] == false {
        exit_error(offset_result["message"])
    }
    limit := limit_result["value"]
    offset := offset_result["value"]
    json_output := parsed_has_flag(parsed, "--json")
    diagnostics_mode := parsed_has_flag(parsed, "--diagnostics")
    runs_payload := list_runs_with_diagnostics(output_root)
    runs := dict_get_or(runs_payload, "runs", [])
    diagnostics := dict_get_or(runs_payload, "diagnostics", {})
    filtered := filter_runs(runs, status_filter, topic_filter, issues_only)
    filtered = filter_runs_by_workflow(filtered, workflow_filter)
    filtered = filter_runs_by_tags(filtered, tags_filter)
    filtered_total := len(filtered)
    paged := paginate_runs(filtered, offset, limit)
    page_catalog := build_run_catalog(paged)
    filtered_catalog := build_run_catalog(filtered)

    if json_output {
        payload := {
            "filtered_total": filtered_total,
            "filters": {
                "status": status_filter,
                "workflow": workflow_filter,
                "topic": topic_filter,
                "tags": parse_tool_name_list(tags_filter),
                "issues_only": issues_only
            },
            "offset": offset,
            "limit": limit,
            "catalog": page_catalog,
            "page_catalog": page_catalog,
            "filtered_catalog": filtered_catalog,
            "runs": paged
        }
        if diagnostics_mode {
            payload["diagnostics"] := diagnostics
        }
        print(to_json(payload))
        return
    }

    if len(paged) == 0 {
        print("No runs found in " + output_root)
        if status_filter != ""||workflow_filter != ""||topic_filter != ""||trim(to_string(tags_filter)) != ""||issues_only {
            filters_line := "Filters: status=" + status_filter + " workflow=" + workflow_filter + " topic=" + topic_filter
            filters_line = filters_line + " tags=" + to_json(parse_tool_name_list(tags_filter)) + " issues_only=" + to_string(issues_only)
            print(filters_line)
        }
        return
    }

    runs_line := "Runs: " + to_string(page_catalog["total_runs"]) + " (showing " + to_string(len(paged)) + " of " + to_string(filtered_total) + ")"
    runs_line = runs_line + " | resumable=" + to_string(page_catalog["resumable_runs"]) + " | issues_total=" + to_string(page_catalog["issues_total"])
    print(runs_line)
    if diagnostics_mode {
        print_kv("Diagnostics", to_json(diagnostics))
    }
    print_kv("Status counts (page)", to_json(page_catalog["status_counts"]))
    print_kv("Status counts (filtered)", to_json(filtered_catalog["status_counts"]))
    print("")

    run_index := 0
    while run_index < len(paged) {
        run_item := paged[run_index]
        artifacts := dict_get_or(run_item, "artifacts", {})
        report_ready := dict_get_or(artifacts, "report_md", false)&&dict_get_or(artifacts, "report_json", false)
        run_line := run_item["run_id"] + " | " + run_item["status"] + " | " + run_item["updated_at"] + " | topic=" + run_item["topic"]
        run_line = run_line + " | issues=" + to_string(run_item["issues_count"]) + " | step=" + to_string(run_item["current_step_index"]) + "/" + to_string(run_item["total_steps"])
        run_line = run_line + " | report_ready=" + to_string(report_ready)
        print(run_line)
        run_index := run_index + 1
    }
}

func run_templates(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--json": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    json_output := parsed_has_flag(parsed, "--json")
    templates := list_workflow_templates()
    if json_output {
        payload := {
            "templates": templates
        }
        print(to_json(payload))
        return
    }
    print("Workflow Templates")
    for template in templates {
        print_item(dict_get_or(template, "template_id", "") + " | " + dict_get_or(template, "name", "") + " | steps=" + to_string(dict_get_or(template, "step_count", 0)) + " | approvals=" + to_string(dict_get_or(template, "approval_step_count", 0)) + " | tools=" + to_string(dict_get_or(template, "tool_count", 0)))
    }
}

func build_doctor_summary(run_diagnostics) {
    summary := {
        "total_runs": len(run_diagnostics),
        "load_failures": 0,
        "issues_before_total": 0,
        "issues_after_total": 0,
        "repaired_runs": 0
    }
    index := 0
    while index < len(run_diagnostics) {
        item := run_diagnostics[index]
        if dict_get_or(item, "load_ok", false) == false {
            summary["load_failures"] := summary["load_failures"] + 1
            index := index + 1
            continue
        }
        summary["issues_before_total"] := summary["issues_before_total"] + dict_get_or(item, "issues_before", 0)
        summary["issues_after_total"] := summary["issues_after_total"] + dict_get_or(item, "issues_after", 0)
        if dict_get_or(item, "repaired", false) {
            summary["repaired_runs"] := summary["repaired_runs"] + 1
        }
        index := index + 1
    }
    return summary
}

func live_provider_probes(workflow) {
    probes := []
    seen := {}
    catalog := dict_get_or(dict_get_or(workflow, "routing", {}), "model_catalog", {})
    for model_entry in dict_get_or(catalog, "models", []) {
        provider_id := trim(to_string(dict_get_or(model_entry, "provider", "")))
        model_id := trim(to_string(dict_get_or(model_entry, "model", "")))
        probe_key := provider_id + "::" + model_id
        if provider_id == ""||model_id == ""||has_key(seen, probe_key) {continue}
        seen[probe_key] := true
        agent := {"instructions": "This is a Dispatch deployment health probe. Reply with OK.", "model": {"provider": provider_id, "model": model_id, "base_url": dict_get_or(model_entry, "base_url", ""), "api_key_env": dict_get_or(model_entry, "api_key_env", "")}}
        result := call_agent_model(agent, "Reply with OK.", {"max_tokens": 8, "temperature": 0, "max_retries": 0, "offline_fixture": false})
        probe := {"provider": provider_id, "model": model_id, "ok": dict_get_or(result, "ok", false), "status_code": dict_get_or(result, "status_code", 0)}
        if probe["ok"] == false {
            error := dict_get_or(result, "error", {})
            probe["error"] := {"code": dict_get_or(error, "code", "provider_probe_failed"), "message": dict_get_or(error, "message", "Provider probe failed."), "retryable": dict_get_or(error, "retryable", false)}
        }
        probes := push(probes, probe)
    }
    return probes
}

func run_doctor(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--workflow-file": {"takes_value": true, "default": ""},
            "--live": {"takes_value": false, "default": false},
            "--write": {"takes_value": false, "default": false},
            "--run-ids": {"takes_value": true, "default": ""},
            "--recent-count": {"takes_value": true, "default": "0"},
            "--json": {"takes_value": false, "default": false},
            "--strict-mutations": {"takes_value": false, "default": false},
            "--confirm-mutation": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    write_changes := parsed_has_flag(parsed, "--write")
    run_ids := parsed_flag_value(parsed, "--run-ids", "")
    json_output := parsed_has_flag(parsed, "--json")
    recent_count_result := parse_non_negative_number(parsed_flag_value(parsed, "--recent-count", "0"), "--recent-count", 0)
    if recent_count_result["ok"] == false {
        exit_error(recent_count_result["message"])
    }
    recent_count := recent_count_result["value"]
    if write_changes {
        enforce_mutation_guard_or_exit(parsed, "doctor", "--write")
    }
    run_diagnostics := doctor_runs(output_root, write_changes, {
        "run_ids": run_ids,
        "recent_count": recent_count
    })
    store_health := state_store_health(output_root)
    live_mode := parsed_has_flag(parsed, "--live")
    provider_probes := []
    if live_mode {
        workflow_file := trim(parsed_flag_value(parsed, "--workflow-file", ""))
        if workflow_file == "" {exit_error("--workflow-file is required with doctor --live.")}
        loaded := load_workflow_from_file(workflow_file)
        if loaded["ok"] == false {exit_error(loaded["error"]["message"])}
        preflight := routing_environment_preflight(loaded["workflow"], true)
        if preflight["ok"] == false {exit_error(to_json(preflight))}
        provider_probes = live_provider_probes(loaded["workflow"])
    }
    live_ok := true
    for provider_probe in provider_probes {if provider_probe["ok"] == false {live_ok = false}}
    overall_ok := dict_get_or(store_health, "ok", false)
    if live_ok == false {overall_ok = false}
    json_payload := {
        "command": "doctor",
        "ok": overall_ok,
        "output_root": output_root,
        "write_mode": write_changes,
        "scope": {
            "run_ids": run_ids,
            "recent_count": recent_count
        },
        "summary": build_doctor_summary(run_diagnostics),
        "runs": run_diagnostics,
        "state_store": store_health,
        "live_mode": live_mode,
        "provider_probes": provider_probes
    }
    if json_output {
        print(to_json(json_payload))
        if json_payload["ok"] == false {exit(1)}
        return
    }
    if len(run_diagnostics) == 0 {
        print("Dispatch Doctor")
        print_kv("State store", to_json(store_health))
        if live_mode {print_kv("Provider probes", to_json(provider_probes))}
        print("No runs found in " + output_root)
        if json_payload["ok"] == false {exit(1)}
        return
    }

    print("Dispatch Doctor")
    print_kv("Write mode", write_changes)
    print_kv("State store", to_json(store_health))
    if live_mode {print_kv("Provider probes", to_json(provider_probes))}
    if trim(to_string(run_ids)) != "" {
        print_kv("Scoped run_ids", run_ids)
    }
    if recent_count > 0 {
        print_kv("Recent count", recent_count)
    }
    print("")

    run_index := 0
    while run_index < len(run_diagnostics) {
        item := run_diagnostics[run_index]
        if dict_get_or(item, "load_ok", false) == false {
            print_item(item["run_id"] + " | load failed")
            run_index := run_index + 1
            continue
        }
        print_item(item["run_id"] + " | status=" + item["status"] + " | issues(before)=" + to_string(item["issues_before"]) + " | repaired=" + to_string(item["repaired"]) + " | notes=" + to_string(len(item["notes"])) + " | issues(after)=" + to_string(item["issues_after"]))
        note_index := 0
        while note_index < len(item["notes"]) {
            print_nested_item(item["notes"][note_index])
            note_index := note_index + 1
        }
        run_index := run_index + 1
    }

    if write_changes {
        audit_path := mutation_audit_path(output_root)
        if file_exists(audit_path) {
            print("")
            print_kv("Audit", audit_path)
        }
    }
}

func run_cleanup(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--status": {"takes_value": true, "default": ""},
            "--older-than-hours": {"takes_value": true, "default": "0"},
            "--max-count": {"takes_value": true, "default": "0"},
            "--apply": {"takes_value": false, "default": false},
            "--json": {"takes_value": false, "default": false},
            "--strict-mutations": {"takes_value": false, "default": false},
            "--confirm-mutation": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    status_filter := validate_status_filter_or_exit(parsed_flag_value(parsed, "--status", ""), "--status")
    older_result := parse_non_negative_number(parsed_flag_value(parsed, "--older-than-hours", "0"), "--older-than-hours", 0)
    if older_result["ok"] == false {
        exit_error(older_result["message"])
    }
    count_result := parse_non_negative_number(parsed_flag_value(parsed, "--max-count", "0"), "--max-count", 0)
    if count_result["ok"] == false {
        exit_error(count_result["message"])
    }
    older_than_hours := older_result["value"]
    max_count := count_result["value"]
    apply_mode := parsed_has_flag(parsed, "--apply")
    json_output := parsed_has_flag(parsed, "--json")
    if apply_mode {
        enforce_mutation_guard_or_exit(parsed, "cleanup", "--apply")
    }
    dry_run := apply_mode == false

    cleanup := prune_runs(output_root, status_filter, max_count, older_than_hours, dry_run)
    if json_output {
        print(to_json(cleanup))
        return
    }
    mode_label := "dry-run"
    if dry_run == false {
        mode_label = "apply"
    }
    print("Dispatch Cleanup (" + mode_label + ")")
    print_kv("Candidates", cleanup["candidate_count"])
    print_kv("Pruned", cleanup["pruned_count"])
    if dry_run {
        print("Use --apply to persist prune markers.")
    } else {
        audit_path := dict_get_or(cleanup, "audit_path", "")
        if audit_path != "" {
            print_kv("Audit", audit_path)
        }
    }
}

func run_export_run(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--bundle-path": {"takes_value": true, "required": true},
            "--sign-bundle": {"takes_value": false, "default": false},
            "--signing-key": {"takes_value": true, "default": ""}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) < 1 {
        exit_error("run-id is required for export-run command.")
    }
    run_id := positionals[0]
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    bundle_path := parsed_flag_value(parsed, "--bundle-path", "")
    sign_bundle := parsed_has_flag(parsed, "--sign-bundle")
    result := export_run_bundle(output_root, run_id, bundle_path, {
        "include_signature": sign_bundle,
        "signing_key": resolve_signing_key(parsed, "--signing-key")
    })
    if result["ok"] == false {
        exit_error(result["error"]["message"])
    }
    print_kv("Exported run bundle", result["bundle_path"])
}

func run_import_run(command_args) {
    parsed := parse_cli_args(command_args, {
        "flags": {
            "--output-root": {"takes_value": true, "default": "outputs"},
            "--bundle-path": {"takes_value": true, "required": true},
            "--verify-bundle-signature": {"takes_value": false, "default": false},
            "--allow-unsigned-bundle": {"takes_value": false, "default": false},
            "--signing-key": {"takes_value": true, "default": ""},
            "--strict-mutations": {"takes_value": false, "default": false},
            "--confirm-mutation": {"takes_value": false, "default": false}
        }
    })
    if parsed["ok"] == false {
        exit_error(parsed["error"]["message"])
    }
    enforce_mutation_guard_or_exit(parsed, "import-run", "--bundle-path")
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    bundle_path := parsed_flag_value(parsed, "--bundle-path", "")
    verify_signature := parsed_has_flag(parsed, "--allow-unsigned-bundle") == false
    result := import_run_bundle(output_root, bundle_path, {
        "verify_signature": verify_signature,
        "signing_key": resolve_signing_key(parsed, "--signing-key")
    })
    if result["ok"] == false {
        exit_error(result["error"]["message"])
    }
    print_kv("Imported run", result["run_id"])
    print_kv("Run Directory", result["run_dir"])
}

func run_init(command_args) {
    parsed := parse_cli_args(command_args, {"flags": {"--dir": {"takes_value": true, "default": "dispatch-workflow"}, "--force": {"takes_value": false, "default": false}}})
    if parsed["ok"] == false {exit_error(parsed["error"]["message"])}
    project_dir := trim(parsed_flag_value(parsed, "--dir", "dispatch-workflow"))
    path_check := normalize_config_path(project_dir + "/workflow.json")
    if path_check["ok"] == false {exit_error(path_check["message"])}
    workflow_path := path_check["config_path"]
    catalog_path := project_dir + "/model-catalog.json"
    force := parsed_has_flag(parsed, "--force")
    if force == false&&(file_exists(workflow_path)||file_exists(catalog_path)) {exit_error("Init target already contains Dispatch files. Use --force to replace them.")}
    ensure_dir(project_dir)
    catalog := {"schema_name": "ai-sdk-model-catalog", "schema_version": "1.0.0", "id": "starter-catalog", "version": "1", "models": [{"provider": "fixture", "model": "dispatch-starter", "quality_tier": "fixture", "relative_quality": 1, "reliability_score": 1, "supports_tools": true, "supports_structured_output": true, "enabled": true}], "metadata": {"purpose": "Dispatch starter; replace through dispatch catalog sync before live use"}}
    catalog["catalog_hash"] := sha256(to_json(catalog))
    workflow := {"id": "starter-workflow", "name": "Dispatch Starter Workflow", "description": "A routed starter workflow.", "input_schema": {"type": "dict"}, "agents": {"worker": {"id": "worker", "name": "Worker", "purpose": "Complete the requested work.", "instructions": "Return a concise result.", "handler_id": "model", "execution_contract": {"id": "dispatch-model-agent", "version": "1"}, "capabilities": {"general": true}, "model": {"provider": "fixture", "model": "dispatch-starter"}, "model_candidates": [{"provider": "fixture", "model": "dispatch-starter"}], "tools": [], "output_schema": {"type": "dict"}, "uses_model": true}}, "tools": [], "steps": [{"id": "work", "name": "Complete work", "type": "agent", "agent_id": "worker", "input_from": ["input"], "output_key": "result"}], "routing": {"enabled": true, "policy_version": "1.0.0", "objective": "balanced", "model_catalog_file": "model-catalog.json", "fallback": {"max_fallbacks": 0, "max_evaluation_retries": 0}}, "budgets": {"max_steps": 4, "max_total_tokens": 20000, "max_cost_usd": 5, "max_wall_time_ms": 300000}, "memory_config": {}, "default_retry_policy": {"max_attempts": 2, "base_delay_ms": 250, "max_delay_ms": 2000, "strategy": "exponential", "retry_on_codes": ["timeout", "rate_limit", "network_error"]}, "approval_config": {"auto_approve": false}, "output_schema": {"type": "dict"}}
    write_file(workflow_path, to_json(workflow) + "\n", true)
    write_file(catalog_path, to_json(catalog) + "\n", true)
    print_kv("Workflow", workflow_path)
    print_kv("Catalog", catalog_path)
    print("Fixture run: DISPATCH_OFFLINE_FIXTURE=true dispatch run \"First task\" --workflow-file " + workflow_path + " --yes --non-interactive")
}

func run_catalog(command_args) {
    parsed := parse_cli_args(command_args, {"min_positionals": 2, "flags": {"--output": {"takes_value": true, "required": true}}})
    if parsed["ok"] == false {exit_error(parsed["error"]["message"])}
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) != 2 {exit_error("catalog requires <generate|sync> <config.json>.")}
    action := positionals[0]
    if action != "generate"&&action != "sync" {exit_error("catalog action must be generate or sync.")}
    config_path_result := normalize_config_path(positionals[1])
    if config_path_result["ok"] == false {exit_error(config_path_result["message"])}
    config_path := config_path_result["config_path"]
    if starts_with(config_path, "/") == false {config_path = os_getcwd() + "/" + config_path}
    if file_exists(config_path) == false {exit_error("Catalog config not found: " + config_path)}
    output_path_result := normalize_config_path(parsed_flag_value(parsed, "--output", ""))
    if output_path_result["ok"] == false {exit_error(output_path_result["message"])}
    output_path := output_path_result["config_path"]
    if action == "generate"&&file_exists(output_path) {exit_error("Catalog output already exists. Use catalog sync to replace it.")}
    ai_sdk_path := trim(to_string(env("AI_SDK_PATH")))
    if ai_sdk_path == "" {ai_sdk_path = dispatch_root_path("../ai-sdk")}
    kujo_bin := trim(to_string(env("KUJO_BIN")))
    if kujo_bin == "" {kujo_bin = "kujo"}
    generator := ai_sdk_path + "/scripts/generate_model_catalog.kujo"
    if file_exists(generator) == false {exit_error("AI SDK catalog generator is unavailable: " + generator)}
    generated := spawn_process([kujo_bin, "run", "scripts/generate_model_catalog.kujo", "--interpreter", "--", config_path], {"cwd": ai_sdk_path, "inherit_env": true, "timeout_ms": 120000, "max_output_bytes": 5242880})
    if generated.success == false {exit_error("AI SDK catalog generation failed: " + trim(to_string(generated.stderr)))}
    catalog_text := trim(to_string(generated.stdout))
    catalog := null
    try {catalog = parse_json(catalog_text)} except err {exit_error("AI SDK catalog generator returned invalid JSON.")}
    if type(catalog) != "dict"||dict_get_or(catalog, "schema_name", "") != "ai-sdk-model-catalog" {exit_error("AI SDK catalog generator returned an incompatible catalog.")}
    write_file(output_path, to_json(catalog) + "\n", true)
    print_kv("Catalog", output_path)
    print_kv("Catalog hash", dict_get_or(catalog, "catalog_hash", ""))
}

func run_webhooks(command_args) {
    parsed := parse_cli_args(command_args, {"flags": {"--output-root": {"takes_value": true, "default": "outputs"}, "--url": {"takes_value": true, "default": ""}, "--destination": {"takes_value": true, "default": "lifecycle"}, "--json": {"takes_value": false, "default": false}, "--strict-mutations": {"takes_value": false, "default": false}, "--confirm-mutation": {"takes_value": false, "default": false}}})
    if parsed["ok"] == false {exit_error(parsed["error"]["message"])}
    positionals := parsed_positionals_or_empty(parsed)
    if len(positionals) != 1 {exit_error("webhooks requires status or replay.")}
    action := positionals[0]
    output_root := resolve_output_root_or_exit(parsed_flag_value(parsed, "--output-root", "outputs"))
    options := {"output_root": output_root}
    result := null
    if action == "status" {
        result = webhook_outbox_status(options)
    } else if action == "replay" {
        enforce_mutation_guard_or_exit(parsed, "webhooks replay", "--url")
        url := trim(parsed_flag_value(parsed, "--url", ""))
        if url == "" {exit_error("--url is required for webhooks replay.")}
        destination := trim(parsed_flag_value(parsed, "--destination", "lifecycle"))
        if destination != "lifecycle"&&destination != "leash" {exit_error("--destination must be lifecycle or leash.")}
        result = replay_webhook_outbox(options, url, destination)
    } else {
        exit_error("webhooks action must be status or replay.")
    }
    if parsed_has_flag(parsed, "--json") {print(to_json(result)); return}
    print_kv("Outbox", result["path"])
    if action == "status" {
        print_kv("Events", result["events"])
        print_kv("Pending", result["pending"])
        print_kv("Delivered", result["delivered"])
        print_kv("Dead letter", result["dead_letter"])
    } else {
        print_kv("Attempted", result["attempted"])
        print_kv("Delivered", result["delivered"])
        print_kv("Failed", result["failed"])
        if result["ok"] == false {exit(1)}
    }
}

raw_args := args()
if len(raw_args) == 0 {
    print_help()
    return
}

command := raw_args[0]
command_args := []
i := 1
while i < len(raw_args) {
    command_args := push(command_args, raw_args[i])
    i := i + 1
}

if command == "operator" {
    argv := ["bash", dispatch_root_path("scripts/operator.sh")]
    for value in command_args {argv = push(argv, value)}
    result := spawn_process(argv, {"inherit_env":true, "timeout_ms":300000, "max_output_bytes":4194304})
    if result.stdout != "" {print(trim(result.stdout))}
    if result.stderr != "" {print(trim(result.stderr))}
    if result.success == false {exit(1)}
    return
}
if command == "run"||command == "demo" {
    run_demo(command_args)
    return
}
if command == "init" {
    run_init(command_args)
    return
}
if command == "catalog" {
    run_catalog(command_args)
    return
}
if command == "webhooks" {
    run_webhooks(command_args)
    return
}
if command == "show" {
    run_show(command_args)
    return
}
if command == "inspect" {
    run_inspect(command_args)
    return
}
if command == "resume" {
    run_resume(command_args)
    return
}
if command == "resume-decision" {
    run_resume_decision(command_args)
    return
}
if command == "recover" {
    run_recover(command_args)
    return
}
if command == "checkpoint" {
    run_checkpoint(command_args)
    return
}
if command == "runs" {
    run_runs(command_args)
    return
}
if command == "templates" {
    run_templates(command_args)
    return
}
if command == "doctor" {
    run_doctor(command_args)
    return
}
if command == "cleanup" {
    run_cleanup(command_args)
    return
}
if command == "export-run" {
    run_export_run(command_args)
    return
}
if command == "import-run" {
    run_import_run(command_args)
    return
}
if command == "validate" {
    run_validate(command_args)
    return
}
if command == "explain-route" {
    run_explain_route(command_args)
    return
}
if command == "version"||command == "--version"||command == "-v" {
    run_version()
    return
}
if command == "help"||command == "--help"||command == "-h" {
    print_help()
    return
}

print("Unknown command: " + command)
print_help()
exit(1)
