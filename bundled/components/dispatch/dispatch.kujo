func dispatch_root_path(relative_path) {
    root := trim(to_string(env("DISPATCH_ROOT")))
    if root == "" {
        return relative_path
    }
    return replace(root, "\\", "/") + "/" + relative_path
}

func default_sources_dir() {
    return dispatch_root_path("examples/research-report/sources")
}

