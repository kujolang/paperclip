# =============================================================================

tool_deps := {
    "obj_schema": obj_schema,
    "str_schema": str_schema,
    "arr_schema": arr_schema,
    "bool_schema": bool_schema,
    "int_schema": int_schema,
    "docs_dir": DOCS_DIR,
    "allowed_dir": ALLOWED_DIR,
    "allowed_dirs": ALLOWED_DIRS,
    "read_only_patterns": READ_ONLY_PATTERNS,
    "default_timeout_ms": TOOLS_DEFAULT_TIMEOUT_MS,
    "scan_max_entries": TOOLS_SCAN_MAX_ENTRIES,
    "scan_max_files": TOOLS_SCAN_MAX_FILES,
    "scan_max_bytes": TOOLS_SCAN_MAX_BYTES,
    "tree_cache_enabled": TOOLS_TREE_CACHE_ENABLED
}
if TOOLS_ENABLED {
    registered_tools := register_all_tools(tool_deps)
    for tool_name in keys(registered_tools) {
        tool_def := registered_tools[tool_name]
        tools[tool_name] := {
            "name": tool_def["name"],
            "description": tool_def["description"],
            "params": tool_def["params"]
        }
    }
}

resource_deps := {
    "docs_dir": DOCS_DIR,
    "allowed_dir": ALLOWED_DIR,
    "allowed_dirs": ALLOWED_DIRS,
    "log_file": LOG_FILE,
    "repo_docs_dir": "./docs"
}
if RESOURCES_ENABLED {
    registered_resources := register_all_resources(resource_deps)
    for resource_uri in keys(registered_resources) {
        resource_def := registered_resources[resource_uri]
        resources[resource_uri] := {
            "uri": resource_def["uri"],
            "name": resource_def["name"],
            "desc": resource_def["desc"],
            "mime": resource_def["mime"]
        }
    }
}

# =============================================================================
# MCP route handlers
# =============================================================================

print_lines([
    "",
    "╔════════════════════════════════════════════════╗",
    "║        MCP Server                        ║",
    "║        http://" + HOST + ":" + to_string(PORT) + "                    ║",
    "╚════════════════════════════════════════════════╝",
    ""
])

server := http_listen(HOST, PORT)

server := server.route("GET", "/", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    return json_response(200, {
        "server": SERVER_NAME, "version": SERVER_VERSION,
        "endpoints": {
            "health": "/mcp/v1/health",
            "tools_list": "POST /mcp/v1/tools/list",
            "tools_call": "POST /mcp/v1/tools/call",
            "resources_list": "POST /mcp/v1/resources/list",
            "resources_read": "POST /mcp/v1/resources/read",
            "logs": "/mcp/v1/logs"
        }
    })
})

server := server.route("GET", "/mcp/v1/health", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    return json_response(200, {"status": "ok", "server": SERVER_NAME, "version": SERVER_VERSION})
})

server := server.route("POST", "/mcp/v1/tools/list", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    if TOOLS_ENABLED == false {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32010, "message": "Tools are disabled by configuration"}})
    }

    log_call("info", "http", "List tools", {})
    return json_success({"tools": list_tools()})
})

server := server.route("POST", "/mcp/v1/tools/call", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    if TOOLS_ENABLED == false {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32010, "message": "Tools are disabled by configuration"}})
    }

    data := {}
    try {
        data := parse_json(req["body"])
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32600, "message": "Invalid JSON request body"}})
    }

    params := null
    try {
        params := data["params"]
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "Missing params object"}})
    }

    if type(params) != "dict" {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params must be an object"}})
    }

    tname := ""
    try {
        if type(params["name"]) != "string" {
            return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params.name must be a string"}})
        }
        tname := params["name"]
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "Missing params.name"}})
    }

    if trim(tname) == "" {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params.name must be a non-empty string"}})
    }

    tparams := {}
    try {
        args_val := params["arguments"]
        if type(args_val) != "dict" {
            return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params.arguments must be an object"}})
        }
        tparams := args_val
    } except err {
    }

    t := get_tool(tname)
    if t == null {
        log_call("error", "tool", "Rejected unknown tool", {})
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -1, "message": "Tool not found: " + tname}})
    }

    log_call("info", "http", "Tool call: " + tname, {})

    cacheable_tool := tname == "search_files" || tname == "list_tree_recursive" || tname == "grep_text"
    refresh_index := false
    if config_has_key(tparams, "refresh_index") && type(tparams["refresh_index"]) == "bool" {
        refresh_index := tparams["refresh_index"] == true
    }
    cache_key := tname + "|" + to_json(tparams) + "|" + format_date(now(), "YYYY-MM-DD HH:mm")
    if TOOLS_TREE_CACHE_ENABLED && cacheable_tool && !refresh_index && config_has_key(TREE_INDEX_CACHE, cache_key) {
        cached_result := TREE_INDEX_CACHE[cache_key]
        cached_result["cache_hit"] := true
        log_call("info", "tool", "OK (cached): " + tname, {})
        return json_response(200, {"jsonrpc": "2.0", "result": cached_result})
    }

    result := {}
    try {
        result := execute_registered_tool(tname, tparams, tool_deps)
    } except err {
        err_text := "Tool execution failed"
        try {
            err_text := to_string(err)
        } except nested_err {
        }
        log_call("error", "tool", "Exception: " + tname, {})
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -1, "message": "Tool error: " + err_text}})
    }

    result_ok := false
    try {
        result_ok := result["ok"] == true
    } except err {
        result_ok := false
    }

    if result_ok {
        result_data := {}
        try {
            result_data := result["data"]
        } except err {
        }
        if TOOLS_TREE_CACHE_ENABLED && cacheable_tool && !refresh_index {
            TREE_INDEX_CACHE[cache_key] := result_data
        }
        log_call("info", "tool", "OK: " + tname, {})
        return json_response(200, {"jsonrpc": "2.0", "result": result_data})
    }

    err_msg := "Tool failed"
    try {
        err_msg := to_string(result["error"])
    } except err {
    }

    err_code := -1
    if starts_with(to_lower(err_msg), "tool timeout exceeded") {
        err_code := -32001
    }

    log_call("error", "tool", "Fail: " + tname, {})
    return json_response(200, {"jsonrpc": "2.0", "error": {"code": err_code, "message": err_msg}})
})

server := server.route("POST", "/mcp/v1/resources/list", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    if RESOURCES_ENABLED == false {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32011, "message": "Resources are disabled by configuration"}})
    }

    log_call("info", "http", "List resources", {})
    return json_success({"resources": list_resources()})
})

server := server.route("POST", "/mcp/v1/resources/read", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    if RESOURCES_ENABLED == false {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32011, "message": "Resources are disabled by configuration"}})
    }

    data := {}
    try {
        data := parse_json(req["body"])
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32600, "message": "Invalid JSON request body"}})
    }

    params := null
    try {
        params := data["params"]
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "Missing params object"}})
    }

    if type(params) != "dict" {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params must be an object"}})
    }

    uri := ""
    try {
        if type(params["uri"]) != "string" {
            return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params.uri must be a string"}})
        }
        uri := params["uri"]
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "Missing params.uri"}})
    }

    if trim(uri) == "" {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -32602, "message": "params.uri must be a non-empty string"}})
    }

    log_call("info", "http", "Read resource: " + uri, {})

    if dict_has_key(resources, uri) == false {
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -2, "message": "Resource not found: " + uri}})
    }

    try {
        result := read_registered_resource(uri, resource_deps)
        if result["ok"] {
            return json_response(200, {"jsonrpc": "2.0", "result": {
                "contents": [{"uri": uri, "mimeType": result["mime_type"], "text": result["content"]}]
            }})
        }
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -2, "message": result["error"]}})
    } except err {
        err_text := "Resource execution failed"
        try {
            err_text := to_string(err)
        } except nested_err {
        }
        return json_response(200, {"jsonrpc": "2.0", "error": {"code": -2, "message": "Resource error: " + err_text}})
    }
})

server := server.route("POST", "/mcp/v1", func(req) {
    access := enforce_network_access(req)
    if !access["ok"] { return json_response(access["status"], access["body"]) }
    limits := enforce_request_limits(req)
    if !limits["ok"] { return json_response(limits["status"], limits["body"]) }

    payload := {}
    try {
        payload := parse_json(req["body"])
    } except err {
        return json_response(200, {"jsonrpc": "2.0", "id": null, "error": {"code": -32700, "message": "Parse error"}})
    }
    if type(payload) != "dict" || !config_has_key(payload, "jsonrpc") || payload["jsonrpc"] != "2.0" || !config_has_key(payload, "method") || type(payload["method"]) != "string" {
        return json_response(200, {"jsonrpc": "2.0", "id": null, "error": {"code": -32600, "message": "Invalid Request"}})
    }

    request_id := null
    if config_has_key(payload, "id") { request_id := payload["id"] }
    method := payload["method"]
    params := {}
    if config_has_key(payload, "params") && type(payload["params"]) == "dict" { params := payload["params"] }

    if method == "notifications/initialized" { return json_response(202, {}) }
    if method == "ping" { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {}}) }
    if method == "initialize" {
        return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {
            "protocolVersion": "2025-11-25",
            "capabilities": {"tools": {"listChanged": false}, "resources": {"listChanged": false}, "prompts": {"listChanged": false}},
            "serverInfo": {"name": SERVER_NAME, "version": SERVER_VERSION}
        }})
    }
    if method == "tools/list" {
        if !TOOLS_ENABLED { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32010, "message": "Tools are disabled by configuration"}}) }
        return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {"tools": list_standard_tools()}})
    }
    if method == "tools/call" {
        if !TOOLS_ENABLED { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32010, "message": "Tools are disabled by configuration"}}) }
        if !config_has_key(params, "name") || type(params["name"]) != "string" || trim(params["name"]) == "" {
            return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32602, "message": "params.name is required"}})
        }
        tool_name := trim(params["name"])
        if get_tool(tool_name) == null {
            log_call("error", "tool", "Rejected unknown tool", {})
            return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32601, "message": "Tool not found: " + tool_name}})
        }
        tool_args := {}
        if config_has_key(params, "arguments") {
            if type(params["arguments"]) != "dict" { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32602, "message": "params.arguments must be an object"}}) }
            tool_args := params["arguments"]
        }
        outcome := execute_registered_tool(tool_name, tool_args, tool_deps)
        if outcome["ok"] {
            log_call("info", "tool", "OK: " + tool_name, {})
            return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {"content": [{"type": "text", "text": to_json(outcome["data"])}], "structuredContent": outcome["data"], "isError": false}})
        }
        log_call("error", "tool", "Fail: " + tool_name, {})
        return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32000, "message": outcome["error"]}})
    }
    if method == "resources/list" {
        if !RESOURCES_ENABLED { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32011, "message": "Resources are disabled by configuration"}}) }
        return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {"resources": list_standard_resources()}})
    }
    if method == "resources/read" {
        if !RESOURCES_ENABLED { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32011, "message": "Resources are disabled by configuration"}}) }
        if !config_has_key(params, "uri") || type(params["uri"]) != "string" || trim(params["uri"]) == "" { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32602, "message": "params.uri is required"}}) }
        uri := trim(params["uri"])
        if !config_has_key(resources, uri) { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32002, "message": "Resource not found: " + uri}}) }
        outcome := read_registered_resource(uri, resource_deps)
        if outcome["ok"] { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {"contents": [{"uri": uri, "mimeType": outcome["mime_type"], "text": outcome["content"]}]}}) }
        return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32002, "message": outcome["error"]}})
    }
    if method == "prompts/list" { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {"prompts": list_prompts()}}) }
    if method == "prompts/get" {
        if !config_has_key(params, "name") || type(params["name"]) != "string" { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32602, "message": "params.name is required"}}) }
        prompt := read_prompt(trim(params["name"]))
        if prompt["ok"] { return json_response(200, {"jsonrpc": "2.0", "id": request_id, "result": {"description": prompt["description"], "messages": [{"role": "user", "content": {"type": "text", "text": prompt["text"]}}]}}) }
        return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32602, "message": prompt["error"]}})
    }
    return json_response(200, {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32601, "message": "Method not found: " + method}})
})

server := server.route("GET", "/mcp/v1/logs", func(req) {
    access := enforce_network_access(req)
    if access["ok"] == false {
        return json_response(access["status"], access["body"])
    }

    limits := enforce_request_limits(req)
    if limits["ok"] == false {
        return json_response(limits["status"], limits["body"])
    }

    entries := read_log_entries()
    return json_response(200, {"entries": entries, "total": len(entries)})
})

