register_resource := func(uri, name, desc, mime, reader) {
    resources[uri] := {
        "uri": uri, "name": name, "desc": desc,
        "mime": mime, "reader": reader
    }
}

func list_resources() {
    result := []
    for u in keys(resources) {
        r := resources[u]
        result := push(result, {
            "uri": r["uri"], "name": r["name"],
            "description": r["desc"], "mime_type": r["mime"]
        })
    }
    return result
}

func list_standard_tools() {
    result := []
    for name in keys(tools) {
        tool := tools[name]
        result := push(result, {"name": tool["name"], "description": tool["description"], "inputSchema": tool["params"]})
    }
    return result
}

func list_standard_resources() {
    result := []
    for uri in keys(resources) {
        resource := resources[uri]
        result := push(result, {"uri": resource["uri"], "name": resource["name"], "description": resource["desc"], "mimeType": resource["mime"]})
    }
    return result
}

func list_prompts() {
    return [
        {"name": "onboarding", "description": "Onboard an agent to this repository.", "arguments": []},
        {"name": "checklist_loop", "description": "Run a bounded implementation checklist loop.", "arguments": []}
    ]
}

func read_prompt(prompt_name) {
    if prompt_name == "onboarding" {
        return {"ok": true, "description": "Onboard an agent to this repository.", "text": read_file("./docs/onboarding-prompt.md")}
    }
    if prompt_name == "checklist_loop" {
        return {"ok": true, "description": "Run a bounded implementation checklist loop.", "text": read_file("./docs/checklist-loop-workflow.md")}
    }
    return {"ok": false, "error": "Prompt not found: " + prompt_name}
}

