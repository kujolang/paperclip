# =============================================================================

print_registry_summary("Tools", tools, "description")
print("")
print_registry_summary("Resources", resources, "desc")
print_lines([
    "",
    " Logging to: " + LOG_FILE,
    "",
    " Press Ctrl+C to stop",
    ""
])

server.listen()
