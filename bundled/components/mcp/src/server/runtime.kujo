register_tool := func(name, description, params_schema, handler) {
    tools[name] := {
        "name": name,
        "description": description,
        "params": params_schema,
        "handler": handler
    }
}

func dict_has_key(dict_value, key_name) {
    probe := has_key(dict_value, key_name)
    if type(probe) == "bool" {
        return probe
    }
    if type(probe) == "int" {
        return probe == 1
    }
    return false
}

func has_parent_path_segment(path_value) {
    slash_parts := split(path_value, "/")
    for part in slash_parts {
        if part == ".." {
            return true
        }
    }

    backslash_parts := split(path_value, "\\")
    for part in backslash_parts {
        if part == ".." {
            return true
        }
    }

    return false
}

func is_safe_relative_path(path_value) {
    clean := trim(to_string(path_value))
    if clean == "" {
        return false
    }
    if starts_with(clean, "/") || starts_with(clean, "\\") {
        return false
    }
    if has_parent_path_segment(clean) {
        return false
    }
    return true
}

func is_safe_doc_name(file_name) {
    clean := trim(to_string(file_name))
    if clean == "" {
        return false
    }
    if index_of(clean, "/") >= 0 || index_of(clean, "\\") >= 0 {
        return false
    }
    if clean == "." || clean == ".." {
        return false
    }
    return true
}

func get_header_value(req, header_name) {
    if dict_has_key(req, "headers") == false {
        return ""
    }

    headers := req["headers"]
    if type(headers) != "dict" {
        return ""
    }

    if dict_has_key(headers, header_name) {
        return to_string(headers[header_name])
    }

    header_name_lower := to_lower(header_name)
    for key in keys(headers) {
        key_text := to_string(key)
        if to_lower(key_text) == header_name_lower {
            return to_string(headers[key])
        }
    }

    return ""
}

func is_configured_host_allowed(req) {
    expected_host := trim(to_lower(HOST))
    if expected_host == "" || expected_host == "0.0.0.0" || expected_host == "::" {
        return true
    }

    host_header := trim(get_header_value(req, "Host"))
    if host_header == "" {
        return false
    }

    header_parts := split(host_header, ":")
    host_name := to_lower(trim(header_parts[0]))

    if expected_host == "localhost" {
        return host_name == "localhost" || host_name == "127.0.0.1"
    }

    return host_name == expected_host
}

func is_request_authorized(req) {
    if AUTH_ENABLED == false {
        return true
    }

    expected_token := trim(AUTH_TOKEN)
    if expected_token == "" {
        return false
    }

    if AUTH_TYPE == "api_key" {
        provided_key := trim(get_header_value(req, "X-API-Key"))
        return provided_key == expected_token
    }

    auth_header := trim(get_header_value(req, "Authorization"))
    if !starts_with(auth_header, "Bearer ") {
        return false
    }

    provided_token := trim(substring(auth_header, 7, len(auth_header)))
    return provided_token == expected_token
}

func enforce_network_access(req) {
    if !is_configured_host_allowed(req) {
        return {"ok": false, "status": 403, "body": {"error": "Host header is not allowed"}}
    }

    if !is_request_authorized(req) {
        return {"ok": false, "status": 401, "body": {"error": "Unauthorized request"}}
    }

    return {"ok": true, "status": 200, "body": {}}
}

func list_tools() {
    result := []
    for n in keys(tools) {
        t := tools[n]
        result := push(result, {
            "name": t["name"],
            "description": t["description"],
            "input_schema": t["params"]
        })
    }
    return result
}

func get_tool(name) {
    if dict_has_key(tools, name) { return tools[name] }
    return null
}

