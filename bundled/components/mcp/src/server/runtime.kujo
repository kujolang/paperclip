# =============================================================================
# Permission helpers
# =============================================================================

func resolve_allowed_path(fp) {
    chk := check_path(fp, ALLOWED_DIRS, READ_ONLY_PATTERNS, false)
    if !chk["ok"] {
        return {"ok": false, "path": "", "reason": chk["reason"]}
    }
    return {"ok": true, "path": path_absolute(fp), "reason": ""}
}

func read_in_scope(fp) {
    return safe_read(fp, ALLOWED_DIRS, READ_ONLY_PATTERNS)
}

func write_in_scope(fp, content) {
    return safe_write(fp, content, ALLOWED_DIRS, READ_ONLY_PATTERNS)
}

# =============================================================================
# Logging
# =============================================================================

func log_call(entry_type, source, msg, data) {
    entry := "[" + format_date(now(), "YYYY-MM-DD HH:mm:ss") + "] " + entry_type + "/" + source + " " + msg
    append_file(LOG_FILE, entry + "\n")
}

func read_log_entries() {
    if !file_exists(LOG_FILE) { return [] }
    content := read_file(LOG_FILE)
    lines := split(content, "\n")
    result := []
    for line in lines {
        if trim(line) != "" {
            result := push(result, {"text": line})
        }
    }

    if len(result) <= MAX_LOG_ENTRIES {
        return result
    }

    start_index := len(result) - MAX_LOG_ENTRIES
    trimmed := []
    idx := start_index
    while idx < len(result) {
        trimmed := push(trimmed, result[idx])
        idx := idx + 1
    }

    return trimmed
}

REQUEST_LIMIT_STATE := {
    "window": "",
    "count": 0
}

func enforce_request_limits(req) {
    body_size := 0
    try {
        body_size := len(to_string(req["body"]))
    } except err {
    }

    if body_size > MAX_REQUEST_BODY_BYTES {
        return {"ok": false, "status": 413, "body": {"error": "Request body exceeds configured maximum"}}
    }

    if RATE_LIMIT_ENABLED == false {
        return {"ok": true, "status": 200, "body": {}}
    }

    if RATE_LIMIT_STRATEGY == "external" {
        gateway_token := trim(get_header_value(req, RATE_LIMIT_GATEWAY_HEADER))
        if gateway_token != RATE_LIMIT_GATEWAY_TOKEN {
            return {"ok": false, "status": 429, "body": {"error": "External rate-limit attestation required"}}
        }
        return {"ok": true, "status": 200, "body": {}}
    }

    current_window := format_date(now(), "YYYY-MM-DD HH:mm")
    if REQUEST_LIMIT_STATE["window"] != current_window {
        REQUEST_LIMIT_STATE["window"] := current_window
        REQUEST_LIMIT_STATE["count"] := 0
    }

    if REQUEST_LIMIT_STATE["count"] >= RATE_LIMIT_PER_MINUTE {
        return {"ok": false, "status": 429, "body": {"error": "Rate limit exceeded"}}
    }

    REQUEST_LIMIT_STATE["count"] := REQUEST_LIMIT_STATE["count"] + 1
    return {"ok": true, "status": 200, "body": {}}
}

