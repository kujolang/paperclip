# MCP Server - Demo
# A complete MCP server demonstrating tools, resources, and agent interaction.
#
# Run: kujo run server.kujo
#
# The server starts a local MCP-compatible HTTP server.
# Agents can discover tools, read resources, and call tool functions.

export entry_loaded := true

from src.core.framework import check_path, safe_read, safe_write, str_schema, bool_schema, int_schema, arr_schema, obj_schema, json_success
from src.tools.registry import register_all_tools, execute_registered_tool
from src.resources.registry import register_all_resources, read_registered_resource

# =============================================================================
# Configuration
# =============================================================================

func config_has_key(dict_value, key_name) {
    probe := has_key(dict_value, key_name)
    if type(probe) == "bool" {
        return probe
    }
    if type(probe) == "int" {
        return probe == 1
    }
    return false
}

func config_fail(message) {
    assert(false, "Invalid mcp-server.json: " + message)
}

func require_config_dict(parent, key_name, scope_name) {
    if config_has_key(parent, key_name) == false {
        config_fail(scope_name + "." + key_name + " is required and must be an object")
    }

    value := parent[key_name]
    if type(value) != "dict" {
        config_fail(scope_name + "." + key_name + " must be an object")
    }
    return value
}

func require_positive_int(parent, key_name, scope_name) {
    if config_has_key(parent, key_name) == false {
        config_fail(scope_name + "." + key_name + " is required")
    }

    value := parent[key_name]
    if type(value) != "int" || value <= 0 {
        config_fail(scope_name + "." + key_name + " must be a positive integer")
    }
    return value
}

func require_port(parent, key_name, scope_name) {
    value := require_positive_int(parent, key_name, scope_name)
    if value > 65535 {
        config_fail(scope_name + "." + key_name + " must be between 1 and 65535")
    }
    return value
}

func read_optional_positive_int(parent, key_name, scope_name, default_value) {
    if config_has_key(parent, key_name) == false {
        return default_value
    }

    value := parent[key_name]
    if type(value) != "int" || value <= 0 {
        config_fail(scope_name + "." + key_name + " must be a positive integer")
    }

    return value
}

func read_optional_bool(parent, key_name, scope_name, default_value) {
    if config_has_key(parent, key_name) == false {
        return default_value
    }

    value := parent[key_name]
    if type(value) != "bool" {
        config_fail(scope_name + "." + key_name + " must be a boolean")
    }

    return value == true
}

func read_optional_string(parent, key_name, scope_name, default_value) {
    if config_has_key(parent, key_name) == false {
        return default_value
    }
    value := parent[key_name]
    if type(value) != "string" {
        config_fail(scope_name + "." + key_name + " must be a string")
    }
    return trim(value)
}

func require_non_empty_string(parent, key_name, scope_name) {
    if config_has_key(parent, key_name) == false {
        config_fail(scope_name + "." + key_name + " is required")
    }

    if type(parent[key_name]) != "string" {
        config_fail(scope_name + "." + key_name + " must be a non-empty string")
    }

    value := trim(parent[key_name])
    if value == "" {
        config_fail(scope_name + "." + key_name + " must be a non-empty string")
    }
    return value
}

config_raw := read_file("mcp-server.json")
config := parse_json(config_raw)

if type(config) != "dict" {
    config_fail("top-level object is required")
}

server_cfg := require_config_dict(config, "server", "root")
http_cfg := require_config_dict(config, "http", "root")
permissions_cfg := require_config_dict(config, "permissions", "root")
logging_cfg := require_config_dict(config, "logging", "root")
tools_cfg := require_config_dict(config, "tools", "root")
resources_cfg := require_config_dict(config, "resources", "root")

SERVER_NAME := require_non_empty_string(server_cfg, "name", "server")
SERVER_VERSION := require_non_empty_string(server_cfg, "version", "server")

PORT := require_port(http_cfg, "port", "http")
HOST := "127.0.0.1"
if config_has_key(http_cfg, "host") {
    if type(http_cfg["host"]) != "string" || trim(http_cfg["host"]) == "" {
        config_fail("http.host must be a non-empty string")
    }
    HOST := trim(http_cfg["host"])
}

if config_has_key(permissions_cfg, "allowed_directories") == false || type(permissions_cfg["allowed_directories"]) != "array" || len(permissions_cfg["allowed_directories"]) == 0 {
    config_fail("permissions.allowed_directories must be a non-empty array")
}

ALLOWED_DIRS := []
for allowed_dir_raw in permissions_cfg["allowed_directories"] {
    if type(allowed_dir_raw) != "string" {
        config_fail("permissions.allowed_directories entries must be non-empty strings")
    }
    allowed_dir := trim(allowed_dir_raw)
    if allowed_dir == "" {
        config_fail("permissions.allowed_directories entries must be non-empty strings")
    }
    ALLOWED_DIRS := push(ALLOWED_DIRS, allowed_dir)
}

ALLOWED_DIR := ALLOWED_DIRS[0]

MAX_FILE_SIZE := require_positive_int(permissions_cfg, "max_file_size", "permissions")

if config_has_key(permissions_cfg, "read_only_patterns") == false || type(permissions_cfg["read_only_patterns"]) != "array" {
    config_fail("permissions.read_only_patterns must be an array")
}
READ_ONLY_PATTERNS := permissions_cfg["read_only_patterns"]
for read_only_pattern in READ_ONLY_PATTERNS {
    if type(read_only_pattern) != "string" || trim(read_only_pattern) == "" {
        config_fail("permissions.read_only_patterns entries must be non-empty strings")
    }
}

DOCS_DIR := ALLOWED_DIR + "/docs"

LOG_FILE := require_non_empty_string(logging_cfg, "log_file", "logging")
MAX_LOG_ENTRIES := require_positive_int(logging_cfg, "max_entries", "logging")

if config_has_key(tools_cfg, "enabled") && type(tools_cfg["enabled"]) != "bool" {
    config_fail("tools.enabled must be a boolean")
}
TOOLS_ENABLED := read_optional_bool(tools_cfg, "enabled", "tools", true)
TOOLS_DEFAULT_TIMEOUT_MS := require_positive_int(tools_cfg, "default_timeout_ms", "tools")
TOOLS_SCAN_MAX_ENTRIES := read_optional_positive_int(tools_cfg, "scan_max_entries", "tools", 8000)
TOOLS_SCAN_MAX_FILES := read_optional_positive_int(tools_cfg, "scan_max_files", "tools", 4000)
TOOLS_SCAN_MAX_BYTES := read_optional_positive_int(tools_cfg, "scan_max_bytes", "tools", 67108864)
TOOLS_TREE_CACHE_ENABLED := read_optional_bool(tools_cfg, "tree_cache_enabled", "tools", false)
TREE_INDEX_CACHE := {}

if config_has_key(resources_cfg, "enabled") && type(resources_cfg["enabled"]) != "bool" {
    config_fail("resources.enabled must be a boolean")
}
RESOURCES_ENABLED := read_optional_bool(resources_cfg, "enabled", "resources", true)

MAX_REQUEST_BODY_BYTES := read_optional_positive_int(http_cfg, "max_request_body_bytes", "http", 262144)
RATE_LIMIT_PER_MINUTE := read_optional_positive_int(http_cfg, "rate_limit_per_minute", "http", 300)
RATE_LIMIT_ENABLED := read_optional_bool(http_cfg, "rate_limit_enabled", "http", true)
RATE_LIMIT_STRATEGY := to_lower(read_optional_string(http_cfg, "rate_limit_strategy", "http", "local"))
if RATE_LIMIT_STRATEGY != "local" && RATE_LIMIT_STRATEGY != "external" {
    config_fail("http.rate_limit_strategy must be 'local' or 'external'")
}
RATE_LIMIT_GATEWAY_HEADER := read_optional_string(http_cfg, "rate_limit_gateway_header", "http", "X-Kujo-Rate-Limit-Token")
RATE_LIMIT_GATEWAY_TOKEN := read_optional_string(http_cfg, "rate_limit_gateway_token", "http", "")
if RATE_LIMIT_ENABLED && RATE_LIMIT_STRATEGY == "external" && RATE_LIMIT_GATEWAY_TOKEN == "" {
    config_fail("http.rate_limit_gateway_token must be non-empty when external rate limiting is enabled")
}

AUTH_ENABLED := false
AUTH_TYPE := "bearer"
AUTH_TOKEN := ""

if config_has_key(config, "auth") {
    auth_cfg := config["auth"]
    if type(auth_cfg) != "dict" {
        config_fail("auth must be an object when provided")
    }

    if config_has_key(auth_cfg, "enabled") {
        if type(auth_cfg["enabled"]) != "bool" {
            config_fail("auth.enabled must be a boolean")
        }
        AUTH_ENABLED := auth_cfg["enabled"] == true
    }

    if config_has_key(auth_cfg, "type") {
        auth_type_candidate := to_lower(trim(to_string(auth_cfg["type"])))
        if auth_type_candidate != "bearer" && auth_type_candidate != "api_key" {
            config_fail("auth.type must be either 'bearer' or 'api_key'")
        }
        AUTH_TYPE := auth_type_candidate
    }

    if config_has_key(auth_cfg, "token") {
        if type(auth_cfg["token"]) != "string" {
            config_fail("auth.token must be a string")
        }
        AUTH_TOKEN := auth_cfg["token"]
    }
}

if AUTH_ENABLED && trim(AUTH_TOKEN) == "" {
    config_fail("auth.token must be a non-empty string when auth.enabled is true")
}

