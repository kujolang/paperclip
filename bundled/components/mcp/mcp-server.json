{
  "server": {
    "name": "mcp-demo",
    "version": "1.3.1",
    "description": "MCP Server Framework Demo"
  },
  "http": {
    "host": "127.0.0.1",
    "port": 8931,
    "max_request_body_bytes": 262144,
    "rate_limit_enabled": true,
    "rate_limit_per_minute": 300,
    "rate_limit_strategy": "local"
  },
  "permissions": {
    "allowed_directories": ["./demo"],
    "max_file_size": 1048576,
    "read_only_patterns": ["*.md", "*.txt", "*.json", "*.yaml", "*.yml"]
  },
  "logging": {
    "max_entries": 100,
    "log_file": "./mcp-calls.log"
  },
  "tools": {
    "enabled": true,
    "default_timeout_ms": 30000,
    "scan_max_entries": 8000,
    "scan_max_files": 4000,
    "scan_max_bytes": 67108864,
    "tree_cache_enabled": false
  },
  "resources": {
    "enabled": true
  },
  "auth": {
    "enabled": false,
    "type": "bearer",
    "token": ""
  }
}
