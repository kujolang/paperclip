func normalize_namespace(namespace_value) {
	if type(namespace_value) != "string" {
		return ""
	}
	ns := to_lower(trim(namespace_value))
	if ns == "" {
		return ""
	}
	if len(ns) > 64 {
		return ""
	}
	invalid := regex_replace(ns, "[a-z0-9_-]", "")
	if invalid != "" {
		return ""
	}
	return ns
}

func namespaced_index_path(index_path, namespace_value, isolate) {
	if isolate == false {
		return index_path
	}
	if namespace_value == "" || namespace_value == "default" {
		return index_path
	}
	ext := path_extension(index_path)
	if ext == "" {
		return index_path + "__" + namespace_value
	}
	ext_with_dot := "." + ext
	base := substring(index_path, 0, len(index_path) - len(ext_with_dot))
	namespace_suffix := "__" + namespace_value
	if ends_with(base, namespace_suffix) {
		return index_path
	}
	return base + "__" + namespace_value + ext_with_dot
}

export cfg_with_namespace := func(cfg, namespace_value) {
	base_namespace := dict_get_or(cfg, "namespace", "default")
	target_namespace := namespace_value
	if type(target_namespace) != "string" || trim(target_namespace) == "" {
		target_namespace = base_namespace
	}
	normalized := normalize_namespace(target_namespace)
	if normalized == "" {
		return {
			"ok": false,
			"error": "invalid_namespace",
			"message": "Namespace must be 1-64 chars and match [a-z0-9_-]",
			"details": {
				"namespace": target_namespace
			}
		}
	}

	updated := {}
	for key in keys(cfg) {
		updated[key] := cfg[key]
	}

	isolate := dict_get_or(updated, "namespace_index_isolation", true)
	updated["namespace"] := normalized
	updated["index_path"] := namespaced_index_path(dict_get_or(updated, "index_path", "./data/rag_index.json"), normalized, isolate)

	return {
		"ok": true,
		"namespace": normalized,
		"cfg": updated
	}
}

func parse_int_or(value, default_value) {
	err := null
	parsed := default_value
	try {
		parsed := parse_int(value)
	} except e {
		err := e
	}
	if type(err) != "null" {
		return default_value
	}
	return parsed
}

func parse_float_or(value, default_value) {
	err := null
	parsed := default_value
	try {
		parsed := parse_float(value)
	} except e {
		err := e
	}
	if type(err) != "null" {
		return default_value
	}
	return parsed
}

func parse_bool_or(value, default_value) {
	if type(value) != "string" {
		return default_value
	}
	lower := to_lower(trim(value))
	if lower == "1" || lower == "true" || lower == "yes" || lower == "on" {
		return true
	}
	if lower == "0" || lower == "false" || lower == "no" || lower == "off" {
		return false
	}
	return default_value
}

func is_safe_command_token(value) {
	if type(value) != "string" {
		return false
	}
	candidate := trim(value)
	if candidate == "" {
		return false
	}
	invalid := regex_replace(candidate, "[A-Za-z0-9_./-]", "")
	return invalid == ""
}

func parse_csv_string_array(value, default_value) {
	if type(value) != "string" {
		return default_value
	}
	raw := trim(value)
	if raw == "" {
		return default_value
	}
	items := split(raw, ",")
	parsed := []
	for item in items {
		entry := trim(item)
		if entry != "" {
			parsed := push(parsed, entry)
		}
	}
	if len(parsed) == 0 {
		return default_value
	}
	return parsed
}

func is_loopback_host(host_value) {
	host := to_lower(trim(to_string(host_value)))
	return host == "127.0.0.1" || host == "localhost" || host == "::1" || host == "[::1]"
}

func array_contains_string(values, expected) {
	if type(values) != "array" {
		return false
	}
	needle := to_lower(trim(to_string(expected)))
	for value in values {
		if to_lower(trim(to_string(value))) == needle {
			return true
		}
	}
	return false
}

func url_host(url_value) {
	url := trim(to_string(url_value))
	scheme_sep := index_of(url, "://")
	if scheme_sep < 0 {
		return ""
	}
	authority_and_path := substring(url, scheme_sep + 3, len(url))
	authority_parts := split(authority_and_path, "/")
	if len(authority_parts) == 0 {
		return ""
	}
	authority := trim(authority_parts[0])
	if authority == "" || index_of(authority, "@") >= 0 {
		return ""
	}
	if starts_with(authority, "[") {
		close_index := index_of(authority, "]")
		if close_index <= 1 {
			return ""
		}
		return to_lower(substring(authority, 1, close_index))
	}
	host_parts := split(authority, ":")
	if len(host_parts) == 0 {
		return ""
	}
	return to_lower(trim(host_parts[0]))
}

func parse_json_dict_or(value, default_value) {
	if type(value) != "string" {
		return default_value
	}
	raw := trim(value)
	if raw == "" {
		return default_value
	}
	err := null
	parsed := default_value
	try {
		parsed := parse_json(raw)
	} except e {
		err := e
	}
	if type(err) != "null" {
		return default_value
	}
	if type(parsed) != "dict" {
		return default_value
	}
	return parsed
}

export load_config := func(overrides) {
	cfg := default_config()

	cfg["index_path"] := env_or("KUJO_RAG_INDEX_PATH", cfg["index_path"])
	cfg["namespace"] := env_or("KUJO_RAG_NAMESPACE", cfg["namespace"])
	cfg["namespace_index_isolation"] := parse_bool_or(env_or("KUJO_RAG_NAMESPACE_INDEX_ISOLATION", "true"), cfg["namespace_index_isolation"])
	cfg["vector_backend"] := to_lower(trim(env_or("KUJO_RAG_VECTOR_BACKEND", cfg["vector_backend"])))
