	server := server.route("POST", "/retention/purge", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
			return rate_limit_error(req, cfg, access_log, rate)
		}

		if dict_get_or(cfg, "api_drain_reject_mutations", true) && drain_enabled(state) {
			return drain_mode_error(req, cfg, access_log, state, "retention_purge")
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		parsed := parse_api_json_body(req, cfg)
		if parsed["ok"] == false {
			log_access(access_log, req, 400, {"code": parsed["error"]})
			return json_err(req, cfg, 400, parsed["error"], parsed["message"], dict_get_or(parsed, "details", {}))
		}
		data := parsed["data"]

		ns_cfg := resolve_namespace_cfg(cfg, data)
		if dict_get_or(ns_cfg, "ok", false) == false {
			status := dict_get_or(ns_cfg, "status", 400)
			code := dict_get_or(ns_cfg, "error", "invalid_namespace")
			message := dict_get_or(ns_cfg, "message", "Invalid namespace")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(ns_cfg, "details", {}))
		}
		namespace := dict_get_or(ns_cfg, "namespace", dict_get_or(cfg, "namespace", "default"))
		namespace_cfg := dict_get_or(ns_cfg, "cfg", cfg)

		rbac := validate_api_rbac(req, cfg, auth, "admin", namespace)
		audit_rbac_decision(cfg, req, rbac, "admin", namespace)
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		policy_payload := namespace_retention_policy(state, namespace_cfg, namespace)
		state = dict_get_or(policy_payload, "state", state)
		policy := dict_get_or(policy_payload, "policy", retention_policy_default(namespace_cfg))

		hold_payload := effective_namespace_legal_hold(state, cfg, namespace, namespace_cfg)
		state = dict_get_or(hold_payload, "state", state)
		hold := dict_get_or(hold_payload, "hold", {})
		if to_bool(dict_get_or(hold, "enabled", false)) {
			reason := to_string(dict_get_or(hold, "reason", "legal_hold_active"))
			log_access(access_log, req, 409, {"code": "legal_hold_active", "namespace": namespace})
			response := json_response(409, {
				"ok": false,
				"request_id": ensure_request_id(req),
				"correlation_id": ensure_correlation_id(req),
				"error": {
					"code": "legal_hold_active",
					"message": "Retention purge is blocked by legal hold",
					"details": {
						"namespace": namespace,
						"reason": reason
					}
				}
			})
			response = with_request_ids(response, req)
			return with_cors(response, req, cfg)
		}

		if to_bool(dict_get_or(policy, "enabled", false)) == false {
			response_data := {
				"namespace": namespace,
				"index_path": dict_get_or(namespace_cfg, "index_path", ""),
				"policy": policy,
				"legal_hold": hold,
				"skipped": true,
				"reason": "retention_policy_disabled"
			}
			audit_emit(cfg, "admin_operation", "success", {"path": "/retention/purge", "namespace": namespace, "skipped": true})
			log_access(access_log, req, 200, {"retention_purge": true, "namespace": namespace, "skipped": true})
			return json_ok(req, cfg, response_data)
		}

		indexed := ensure_index_for_namespace(state, namespace, namespace_cfg)
		state = dict_get_or(indexed, "state", state)
		index_payload := dict_get_or(indexed, "index", {})
		now_ms := current_timestamp()
		ttl_days := normalize_retention_ttl_days(dict_get_or(policy, "ttl_days", 365), 365)
		retention_result := apply_retention_policy(index_payload, now_ms, ttl_days, false)
		updated_index := dict_get_or(retention_result, "index", index_payload)
		retention_persisted := save_index_with_backend(namespace_cfg, updated_index)
		if retention_persisted != true {
			audit_emit(cfg, "admin_operation", "failure", {"path": "/retention/purge", "namespace": namespace, "code": "retention_persistence_failed"})
			return json_err(req, cfg, 500, "retention_persistence_failed", "Retention purge could not be persisted to the configured vector backend", {
				"namespace": namespace
			})
		}

		indexes := dict_get_or(state, "indexes", {})
		indexes[namespace] = updated_index
		state["indexes"] = indexes
		state = invalidate_caches_after_ingest(state, namespace)
		state = persist_api_runtime_state(state)

		response_data := {
			"namespace": namespace,
			"index_path": dict_get_or(namespace_cfg, "index_path", ""),
			"policy": policy,
			"legal_hold": hold,
			"purge": {
				"ttl_days": ttl_days,
				"cutoff_ms": dict_get_or(retention_result, "cutoff_ms", 0),
				"purged_chunks": dict_get_or(retention_result, "purged_chunks", 0),
				"purged_vectors": dict_get_or(retention_result, "purged_vectors", 0),
				"purged_lexical": dict_get_or(retention_result, "purged_lexical", 0),
				"retained_chunks": dict_get_or(retention_result, "retained_chunks", len(dict_get_or(updated_index, "chunks", [])))
			}
		}
		audit_emit(cfg, "admin_operation", "success", {"path": "/retention/purge", "namespace": namespace, "purged_chunks": dict_get_or(dict_get_or(response_data, "purge", {}), "purged_chunks", 0)})
		log_access(access_log, req, 200, {"retention_purge": true, "namespace": namespace, "purged_chunks": dict_get_or(dict_get_or(response_data, "purge", {}), "purged_chunks", 0)})
		return json_ok(req, cfg, response_data)
	})

	server := server.route("POST", "/privacy/export", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
			return rate_limit_error(req, cfg, access_log, rate)
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		parsed := parse_api_json_body(req, cfg)
		if parsed["ok"] == false {
			log_access(access_log, req, 400, {"code": parsed["error"]})
			return json_err(req, cfg, 400, parsed["error"], parsed["message"], dict_get_or(parsed, "details", {}))
		}
		data := parsed["data"]

		ns_cfg := resolve_namespace_cfg(cfg, data)
		if dict_get_or(ns_cfg, "ok", false) == false {
			status := dict_get_or(ns_cfg, "status", 400)
			code := dict_get_or(ns_cfg, "error", "invalid_namespace")
			message := dict_get_or(ns_cfg, "message", "Invalid namespace")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(ns_cfg, "details", {}))
		}
		namespace := dict_get_or(ns_cfg, "namespace", dict_get_or(cfg, "namespace", "default"))
		namespace_cfg := dict_get_or(ns_cfg, "cfg", cfg)

		rbac := validate_api_rbac(req, cfg, auth, "admin", namespace)
		audit_rbac_decision(cfg, req, rbac, "admin", namespace)
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		export_type := trim(to_string(dict_get_or(data, "export_type", "namespace_snapshot")))
		if export_type == "" {
			export_type = "namespace_snapshot"
		}

		indexed := ensure_index_for_namespace(state, namespace, namespace_cfg)
		state = dict_get_or(indexed, "state", state)
		index_payload := dict_get_or(indexed, "index", {})
		summary := summarize_namespace_index(index_payload)
		artifact := write_privacy_export_artifact(namespace, index_payload, export_type, cfg)
		if dict_get_or(artifact, "ok", false) == false {
			audit_emit(cfg, "admin_operation", "failure", {"path": "/privacy/export", "namespace": namespace, "code": "privacy_artifact_write_failed"})
			return json_err(req, cfg, 500, "privacy_artifact_write_failed", "Privacy export could not be protected and persisted", {
				"namespace": namespace,
				"error": dict_get_or(artifact, "error", {})
			})
		}

		response_data := {
			"namespace": namespace,
			"index_path": dict_get_or(namespace_cfg, "index_path", ""),
			"export": artifact,
			"summary": summary,
			"scope": ["chunks", "vectors", "lexical", "documents_index"]
		}
		audit_emit(cfg, "admin_operation", "success", {"path": "/privacy/export", "namespace": namespace, "chunk_count": dict_get_or(summary, "chunk_count", 0), "artifact_path": dict_get_or(artifact, "path", "")})
		log_access(access_log, req, 200, {"privacy_export": true, "namespace": namespace, "chunk_count": dict_get_or(summary, "chunk_count", 0)})
		return json_ok(req, cfg, response_data)
	})

	server := server.route("POST", "/privacy/delete", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
			return rate_limit_error(req, cfg, access_log, rate)
		}

		if dict_get_or(cfg, "api_drain_reject_mutations", true) && drain_enabled(state) {
			return drain_mode_error(req, cfg, access_log, state, "privacy_delete")
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		parsed := parse_api_json_body(req, cfg)
		if parsed["ok"] == false {
			log_access(access_log, req, 400, {"code": parsed["error"]})
			return json_err(req, cfg, 400, parsed["error"], parsed["message"], dict_get_or(parsed, "details", {}))
		}
		data := parsed["data"]

		ns_cfg := resolve_namespace_cfg(cfg, data)
		if dict_get_or(ns_cfg, "ok", false) == false {
			status := dict_get_or(ns_cfg, "status", 400)
			code := dict_get_or(ns_cfg, "error", "invalid_namespace")
			message := dict_get_or(ns_cfg, "message", "Invalid namespace")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(ns_cfg, "details", {}))
		}
		namespace := dict_get_or(ns_cfg, "namespace", dict_get_or(cfg, "namespace", "default"))
		namespace_cfg := dict_get_or(ns_cfg, "cfg", cfg)

		rbac := validate_api_rbac(req, cfg, auth, "admin", namespace)
		audit_rbac_decision(cfg, req, rbac, "admin", namespace)
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		hold_payload := effective_namespace_legal_hold(state, cfg, namespace, namespace_cfg)
		state = dict_get_or(hold_payload, "state", state)
		hold := dict_get_or(hold_payload, "hold", {})
		if to_bool(dict_get_or(hold, "enabled", false)) {
			reason := to_string(dict_get_or(hold, "reason", "legal_hold_active"))
			log_access(access_log, req, 409, {"code": "legal_hold_active", "namespace": namespace})
			response := json_response(409, {
				"ok": false,
				"request_id": ensure_request_id(req),
				"correlation_id": ensure_correlation_id(req),
				"error": {
					"code": "legal_hold_active",
					"message": "Privacy deletion is blocked by legal hold",
					"details": {
						"namespace": namespace,
						"reason": reason
					}
				}
			})
			response = with_request_ids(response, req)
			return with_cors(response, req, cfg)
		}

		delete_reason := trim(to_string(dict_get_or(data, "reason", "privacy_delete_request")))
		if delete_reason == "" {
			delete_reason = "privacy_delete_request"
		}

		delete_error := null
		delete_response := null
		try {
			indexed := ensure_index_for_namespace(state, namespace, namespace_cfg)
			state = dict_get_or(indexed, "state", state)
			current_index := dict_get_or(indexed, "index", {})
			pre_delete_summary := summarize_namespace_index(current_index)
			pre_delete_export := write_privacy_export_artifact(namespace, current_index, "delete_preflight", cfg)
			if dict_get_or(pre_delete_export, "ok", false) == false {
				delete_error = "privacy_preflight_artifact_write_failed"
			} else {
				deleted_index := build_deleted_namespace_index(current_index, namespace)
				delete_persisted := save_index_with_backend(namespace_cfg, deleted_index)
				if delete_persisted != true {
					delete_error = "privacy_delete_persistence_failed"
				} else {
					indexes := dict_get_or(state, "indexes", {})
					indexes[namespace] := deleted_index
					state["indexes"] := indexes
					state = apply_namespace_privacy_delete(state, namespace)
					state = persist_api_runtime_state(state)

					post_delete_summary := summarize_namespace_index(deleted_index)
					delete_receipt := write_privacy_export_artifact(namespace, deleted_index, "delete_receipt", cfg)
					if dict_get_or(delete_receipt, "ok", false) == false {
						delete_error = "privacy_delete_receipt_write_failed"
					} else {
						response_data := {
							"namespace": namespace,
							"index_path": dict_get_or(namespace_cfg, "index_path", ""),
							"delete_reason": delete_reason,
							"deleted": true,
							"pre_delete_export": pre_delete_export,
							"deletion_receipt": delete_receipt,
							"summary_before": pre_delete_summary,
							"summary_after": post_delete_summary,
							"deleted_scopes": ["chunks", "vectors", "lexical", "documents_index", "sessions", "ingest_jobs", "ingest_queue", "ingest_idempotency", "query_cache", "retention_controls", "tenant_runtime_metrics"]
						}
						audit_emit(cfg, "admin_operation", "success", {"path": "/privacy/delete", "namespace": namespace, "reason": delete_reason, "deleted_chunks": dict_get_or(pre_delete_summary, "chunk_count", 0), "receipt_path": dict_get_or(delete_receipt, "path", "")})
						log_access(access_log, req, 200, {"privacy_delete": true, "namespace": namespace, "deleted_chunks": dict_get_or(pre_delete_summary, "chunk_count", 0)})
						delete_response = json_ok(req, cfg, response_data)
					}
				}
			}
		} except e {
			delete_error = e
		}

		if type(delete_error) != "null" {
			log_access(access_log, req, 500, {"code": "privacy_delete_failed", "namespace": namespace})
			audit_emit(cfg, "admin_operation", "failure", {"path": "/privacy/delete", "namespace": namespace, "reason": delete_reason, "error": to_string(delete_error)})
			return json_err(req, cfg, 500, "privacy_delete_failed", "Privacy delete workflow failed", {
				"namespace": namespace,
				"reason": delete_reason,
				"error": to_string(delete_error)
			})
		}

		return delete_response
	})

	server := server.route("GET", "/drain", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
				return rate_limit_error(req, cfg, access_log, rate)
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		rbac := validate_api_rbac(req, cfg, auth, "admin", dict_get_or(cfg, "namespace", "default"))
		audit_rbac_decision(cfg, req, rbac, "admin", dict_get_or(cfg, "namespace", "default"))
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		payload := drain_state_snapshot(state, cfg)
		audit_emit(cfg, "drain_mode", "status", payload)
		log_access(access_log, req, 200, {"drain": true, "enabled": dict_get_or(payload, "enabled", false)})
		return json_ok(req, cfg, payload)
	})

	server := server.route("POST", "/drain/start", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
				return rate_limit_error(req, cfg, access_log, rate)
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		rbac := validate_api_rbac(req, cfg, auth, "admin", dict_get_or(cfg, "namespace", "default"))
		audit_rbac_decision(cfg, req, rbac, "admin", dict_get_or(cfg, "namespace", "default"))
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		reason := "operator_requested"
		body_raw := trim(to_string(dict_get_or(req, "body", "")))
		if body_raw != "" {
			parsed := parse_api_json_body(req, cfg)
			if parsed["ok"] == false {
				log_access(access_log, req, 400, {"code": parsed["error"]})
				return json_err(req, cfg, 400, parsed["error"], parsed["message"], dict_get_or(parsed, "details", {}))
			}
			data := parsed["data"]
			reason = trim(to_string(dict_get_or(data, "reason", reason)))
			if reason == "" {
				reason = "operator_requested"
			}
		}

		state = set_drain_state(state, true, reason)
		payload := drain_state_snapshot(state, cfg)
		audit_emit(cfg, "drain_mode", "started", payload)
		log_access(access_log, req, 200, {"drain": "started", "reason": reason})
		return json_ok(req, cfg, payload)
	})

	server := server.route("POST", "/drain/stop", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
				return rate_limit_error(req, cfg, access_log, rate)
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		rbac := validate_api_rbac(req, cfg, auth, "admin", dict_get_or(cfg, "namespace", "default"))
		audit_rbac_decision(cfg, req, rbac, "admin", dict_get_or(cfg, "namespace", "default"))
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		state = set_drain_state(state, false, "")
		payload := drain_state_snapshot(state, cfg)
		audit_emit(cfg, "drain_mode", "stopped", payload)
		log_access(access_log, req, 200, {"drain": "stopped"})
		return json_ok(req, cfg, payload)
	})

	server := server.route("GET", "/", func(req) {
		rate := rate_check(state, cfg, req)
		state = dict_get_or(rate, "state", state)
		if rate["ok"] == false {
				return rate_limit_error(req, cfg, access_log, rate)
		}

		auth := validate_api_auth(req, cfg)
		audit_auth_decision(cfg, req, auth)
		if auth["ok"] == false {
			status := dict_get_or(auth, "status", 401)
			code := dict_get_or(auth, "error", "unauthorized")
			message := dict_get_or(auth, "message", "Unauthorized")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, {"provider": dict_get_or(auth, "provider", "unknown")})
		}

		rbac := validate_api_rbac(req, cfg, auth, "admin", dict_get_or(cfg, "namespace", "default"))
		audit_rbac_decision(cfg, req, rbac, "admin", dict_get_or(cfg, "namespace", "default"))
		if dict_get_or(rbac, "ok", false) == false {
			status := dict_get_or(rbac, "status", 403)
			code := dict_get_or(rbac, "error", "rbac_forbidden")
			message := dict_get_or(rbac, "message", "Forbidden")
			log_access(access_log, req, status, {"code": code})
			return json_err(req, cfg, status, code, message, dict_get_or(rbac, "details", {}))
		}

		payload := {
			"name": "kujo-rag",
			"version": "1.0.0",
			"namespace_default": dict_get_or(cfg, "namespace", "default"),
			"ingest_worker_mode": ingest_jobs_mode(cfg),
			"endpoints": {
				"health": "GET /health",
				"liveness": "GET /live",
				"readiness": "GET /ready",
				"startup": "GET /startup",
				"retention": "GET /retention",
				"retention_policy": "POST /retention/policy",
				"retention_legal_hold_start": "POST /retention/legal-hold/start",
				"retention_legal_hold_stop": "POST /retention/legal-hold/stop",
				"retention_purge": "POST /retention/purge",
				"privacy_export": "POST /privacy/export",
				"privacy_delete": "POST /privacy/delete",
				"drain_status": "GET /drain",
				"drain_start": "POST /drain/start",
				"drain_stop": "POST /drain/stop",
				"metrics": "GET /metrics",
				"ingest": "POST /ingest",
				"ingest_jobs": "POST /ingest/jobs",
				"ingest_job_status": "POST /ingest/jobs/status",
				"ingest_worker_tick": "POST /ingest/jobs/worker/tick",
				"query": "POST /query"
			}
		}
		audit_emit(cfg, "admin_operation", "success", {"path": "/", "root": true})
		log_access(access_log, req, 200, {"root": true})
		return json_ok(req, cfg, payload)
	})

	server.listen()
}
