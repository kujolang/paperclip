from src.common import dict_get_or, num_or

func copy_index_meta(index) {
	meta := dict_get_or(index, "meta", {})
	if type(meta) != "dict" {
		meta = {}
	}
	return meta
}

export normalize_retention_ttl_days := func(raw_ttl_days, default_ttl_days) {
	ttl_days := num_or(raw_ttl_days, default_ttl_days)
	if ttl_days < 1 {
		ttl_days = 1
	}
	if ttl_days > 36500 {
		ttl_days = 36500
	}
	return ttl_days
}

func retention_cutoff_ms(now_ms, ttl_days) {
	day_ms := 86400000
	return now_ms - (ttl_days * day_ms)
}

func chunk_retention_timestamp_ms(chunk) {
	meta := dict_get_or(chunk, "meta", {})
	if type(meta) != "dict" {
		meta = {}
	}

	timestamp_ms := num_or(dict_get_or(meta, "ingested_at_ms", 0), 0)
	if timestamp_ms <= 0 {
		timestamp_ms = num_or(dict_get_or(meta, "timestamp_ms", 0), 0)
	}
	if timestamp_ms <= 0 {
		timestamp_ms = num_or(dict_get_or(meta, "timestamp", 0), 0)
	}
	return timestamp_ms
}

export apply_retention_policy := func(index, now_ms, ttl_days, legal_hold_active) {
	normalized_ttl_days := normalize_retention_ttl_days(ttl_days, 365)
	cutoff_ms := retention_cutoff_ms(now_ms, normalized_ttl_days)

	chunks := dict_get_or(index, "chunks", [])
	vectors := dict_get_or(index, "vectors", [])
	lexical := dict_get_or(index, "lexical", [])
	meta := copy_index_meta(index)

	if legal_hold_active {
		meta["retention_last_run_ms"] = now_ms
		meta["retention_last_status"] = "skipped_legal_hold"
		index["meta"] = meta
		return {
			"index": index,
			"legal_hold_active": true,
			"ttl_days": normalized_ttl_days,
			"cutoff_ms": cutoff_ms,
			"purged_chunks": 0,
			"purged_vectors": 0,
			"purged_lexical": 0,
			"retained_chunks": len(chunks)
		}
	}

	expired_chunk_ids := {}
	retained_chunks := []
	i := 0
	while i < len(chunks) {
		chunk := chunks[i]
		chunk_id := to_string(dict_get_or(chunk, "chunk_id", ""))
		timestamp_ms := chunk_retention_timestamp_ms(chunk)
		if timestamp_ms > 0 && timestamp_ms < cutoff_ms {
			expired_chunk_ids[chunk_id] = true
		} else {
			retained_chunks = push(retained_chunks, chunk)
		}
		i = i + 1
	}

	retained_vectors := []
	i = 0
	while i < len(vectors) {
		entry := vectors[i]
		chunk_id := to_string(dict_get_or(entry, "chunk_id", ""))
		if has_key(expired_chunk_ids, chunk_id) == 0 {
			retained_vectors = push(retained_vectors, entry)
		}
		i = i + 1
	}

	retained_lexical := []
	i = 0
	while i < len(lexical) {
		entry := lexical[i]
		chunk_id := to_string(dict_get_or(entry, "chunk_id", ""))
		if has_key(expired_chunk_ids, chunk_id) == 0 {
			retained_lexical = push(retained_lexical, entry)
		}
		i = i + 1
	}

	purged_chunks := len(chunks) - len(retained_chunks)
	purged_vectors := len(vectors) - len(retained_vectors)
	purged_lexical := len(lexical) - len(retained_lexical)

	updated_index := {
		"chunks": retained_chunks,
		"vectors": retained_vectors,
		"lexical": retained_lexical,
		"meta": meta
	}
	meta["retention_last_run_ms"] = now_ms
	meta["retention_last_status"] = "applied"
	meta["retention_last_purged_chunks"] = purged_chunks
	meta["retention_last_cutoff_ms"] = cutoff_ms

	return {
		"index": updated_index,
		"legal_hold_active": false,
		"ttl_days": normalized_ttl_days,
		"cutoff_ms": cutoff_ms,
		"purged_chunks": purged_chunks,
		"purged_vectors": purged_vectors,
		"purged_lexical": purged_lexical,
		"retained_chunks": len(retained_chunks)
	}
}
