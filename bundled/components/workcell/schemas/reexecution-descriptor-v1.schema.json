{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/schemas/workflow-control/reexecution-descriptor/v1.json",
  "title": "Kujo Re-execution Descriptor v1",
  "type": "object",
  "required": ["schema", "capability", "source", "workflow", "tool", "inputs", "secret_refs", "external_dependencies", "effects"],
  "properties": {
    "schema": {"const": "kujo.reexecution-descriptor/v1"},
    "capability": {"enum": ["inspectable", "re_executable", "deterministic_replay"]},
    "source": {"type": "object", "required": ["repository", "commit"]},
    "workflow": {"type": "object", "required": ["id", "version", "sha256"]},
    "tool": {"type": "object", "required": ["name", "version"]},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["name", "evidence_ref"]}},
    "secret_refs": {"type": "array", "items": {"type": "string", "pattern": "^secret://"}, "uniqueItems": true},
    "external_dependencies": {"type": "array", "items": {"type": "object", "required": ["name", "mode", "replayable"]}},
    "effects": {"type": "object", "required": ["automatic_retry_allowed"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
