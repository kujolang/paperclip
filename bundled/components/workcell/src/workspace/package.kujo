# Portable clean-Git workspace packaging for remote backend transfer.

from src.util import base_of, ensure_dir, get_or, normalized_relative, parent_of, path_has_symlink, path_within, process_error, process_ok, read_text, run_argv, save_json, valid_run_id
from src.workspace.workspace import find_symlink_with_limits, inspect_repository, temp_root

export func workspace_package_schema_version() {
    return "workcell-workspace/v1"
}

func package_limits(value) {
    if type(value) != "dict" {
        return {"max_files": 100000, "max_bytes": 1000000000, "max_depth": 128}
    }
    return {
        "max_files": get_or(value, "max_files", 100000),
        "max_bytes": get_or(value, "max_bytes", 1000000000),
        "max_depth": get_or(value, "max_depth", 128)
    }
}

func process_exit_code(result) {
    if type(result) == "dict" {
        return get_or(result, "exitcode", 127)
    }
    return result.exitcode
}

func collect_package_files(root, limits) {
    mut queue_paths := [root]
    mut queue_relative := [""]
    mut queue_depths := [0]
    mut queue_i := 0
    mut files := []
    mut total_bytes := 0
    mut observed_depth := 0
    while queue_i < len(queue_paths) {
        path := queue_paths[queue_i]
        relative := queue_relative[queue_i]
        depth := queue_depths[queue_i]
        if depth > limits["max_depth"] {
            return {"ok": false, "error": "workspace package exceeds maximum depth: " + relative}
        }
        if depth > observed_depth {observed_depth = depth}
        if path_has_symlink(path) {
            return {"ok": false, "error": "workspace package source contains a symlink: " + relative}
        }
        mut entries := []
        try {
            entries = list_dir(path)
        } except err {
            return {"ok": false, "error": "workspace package could not list " + relative + ": " + to_string(err)}
        }
        mut entry_i := 0
        while entry_i < len(entries) {
            name := to_string(entries[entry_i])
            child_relative := name
            if relative != "" {child_relative = relative + "/" + name}
            checked := normalized_relative(child_relative)
            if checked["ok"] == false||checked["path"] != child_relative {
                return {"ok": false, "error": "workspace package contains an unsafe path: " + child_relative}
            }
            child := path + "/" + name
            if path_within(root, child) == false||path_has_symlink(child) {
                return {"ok": false, "error": "workspace package path escapes or contains a symlink: " + child_relative}
            }
            if path_is_dir(child) {
                queue_paths = push(queue_paths, child)
                queue_relative = push(queue_relative, child_relative)
                queue_depths = push(queue_depths, depth + 1)
            } else {
                mut bytes := 0
                mut digest := ""
                try {
                    bytes = file_size(child)
                    digest = sha256_file(child)
                } except err {
                    return {"ok": false, "error": "workspace package could not inspect " + child_relative + ": " + to_string(err)}
                }
                total_bytes = total_bytes + bytes
                files = push(files, {"path": child_relative, "bytes": bytes, "sha256": digest})
                if len(files) > limits["max_files"] {
                    return {"ok": false, "error": "workspace package exceeds maximum file count"}
                }
                if total_bytes > limits["max_bytes"] {
                    return {"ok": false, "error": "workspace package exceeds maximum expanded bytes"}
                }
            }
            entry_i = entry_i + 1
        }
        queue_i = queue_i + 1
    }
    return {"ok": true, "files": files, "total_files": len(files), "total_bytes": total_bytes, "observed_depth": observed_depth}
}

func cleanup_package_clone(path, _source_root) {
    prefix := "kujo-workcell-package-"
    if type(path) != "string"||path == ""||starts_with(path, temp_root() + "/" + prefix) == false {
        return false
    }
    name := base_of(path)
    if starts_with(name, prefix) == false {
        return false
    }
    run_identifier := substring(name, len(prefix), len(name))
    if valid_run_id(run_identifier) == false {
        return false
    }
    owner_path := path + ".owner"
    if path_has_symlink(owner_path) {
        return false
    }
    owner := read_text(owner_path)
    if owner["ok"] == false||owner["text"] != "workcell-run-id=" + run_identifier + "\n" {
        return false
    }
    removed := run_argv(["rm", "-rf", path], 60000)
    marker_removed := run_argv(["rm", "-f", owner_path], 30000)
    return process_ok(removed)&&process_ok(marker_removed)
}

func reject_unsupported_git_features(root) {
    if file_exists(root + "/.gitmodules") {
        return {"ok": false, "error": "portable workspace packages do not support submodules"}
    }
    lfs := run_argv(["git", "-C", root, "grep", "-l", "^version https://git-lfs.github.com/spec/v1$", "HEAD"], 30000)
    if process_ok(lfs)&&trim(lfs.stdout) != "" {
        return {"ok": false, "error": "portable workspace packages do not support Git LFS pointer-only files"}
    }
    if process_exit_code(lfs) != 0&&process_exit_code(lfs) != 1 {
        return {"ok": false, "error": process_error(lfs, "inspect Git LFS pointers")}
    }
    return {"ok": true}
}

export func create_workspace_package(repo_path, output_dir, run_identifier, requested_limits) {
    if type(repo_path) != "string"||trim(repo_path) == ""||type(output_dir) != "string"||trim(output_dir) == ""||valid_run_id(run_identifier) == false {
        return {"ok": false, "error": "workspace package repository, output, and run id are invalid"}
    }
    inspected := inspect_repository(repo_path)
    if inspected["ok"] == false {return inspected}
    if inspected["clean"] == false {
        return {"ok": false, "error": "source repository is dirty; portable workspace packaging refuses ambient or uncommitted files"}
    }
    unsupported := reject_unsupported_git_features(inspected["root"])
    if unsupported["ok"] == false {return unsupported}
    if path_has_symlink(output_dir)||ensure_dir(output_dir) == false||path_is_dir(output_dir) == false {
        return {"ok": false, "error": "workspace package output directory is unsafe"}
    }
    archive_path := output_dir + "/workspace.tar"
    manifest_path := output_dir + "/workspace-manifest.json"
    if file_exists(archive_path)||file_exists(manifest_path) {
        return {"ok": false, "error": "workspace package output already contains package files"}
    }
    clone_path := temp_root() + "/kujo-workcell-package-" + run_identifier
    if file_exists(clone_path)||path_is_dir(clone_path)||file_exists(clone_path + ".owner") {
        cleanup_package_clone(clone_path, inspected["root"])
    }
    if file_exists(clone_path)||path_is_dir(clone_path)||file_exists(clone_path + ".owner") {
        return {"ok": false, "error": "owned workspace package clone could not be recovered: " + clone_path}
    }
    clone := run_argv(["git", "clone", "--depth", "1", "--no-local", "file://" + inspected["root"], clone_path], 120000)
    if process_ok(clone) == false {
        return {"ok": false, "error": process_error(clone, "create shallow portable workspace clone")}
    }
    owner_written := false
    try {
        owner_written = write_file_atomic(clone_path + ".owner", "workcell-run-id=" + run_identifier + "\n", true)
    } except err {
        owner_written = false
    }
    if owner_written != true {
        cleanup_package_clone(clone_path, inspected["root"])
        return {"ok": false, "error": "could not write portable workspace ownership marker"}
    }
    checkout := run_argv(["git", "-C", clone_path, "checkout", "--detach", inspected["commit"]], 30000)
    remote := run_argv(["git", "-C", clone_path, "remote", "remove", "origin"], 30000)
    hooks := run_argv(["git", "-C", clone_path, "config", "--local", "core.hooksPath", ".git/workcell-disabled-hooks"], 30000)
    credential := run_argv(["git", "-C", clone_path, "config", "--local", "credential.helper", ""], 30000)
    shallow := run_argv(["git", "-C", clone_path, "rev-list", "--count", "HEAD"], 30000)
    status := run_argv(["git", "-C", clone_path, "status", "--porcelain=v1", "--untracked-files=all"], 30000)
    if process_ok(checkout) == false||process_ok(remote) == false||process_ok(hooks) == false||process_ok(credential) == false||process_ok(shallow) == false||trim(shallow.stdout) != "1"||process_ok(status) == false||trim(status.stdout) != "" {
        cleanup_package_clone(clone_path, inspected["root"])
        return {"ok": false, "error": "portable workspace clone did not resolve to one clean, credential-isolated commit"}
    }
    limits := package_limits(requested_limits)
    symlinks := find_symlink_with_limits(clone_path, limits)
    if symlinks["ok"] == false {
        cleanup_package_clone(clone_path, inspected["root"])
        return symlinks
    }
    files := collect_package_files(clone_path, limits)
    if files["ok"] == false {
        cleanup_package_clone(clone_path, inspected["root"])
        return files
    }
    manifest := {
        "schema_version": workspace_package_schema_version(),
        "source_commit": inspected["commit"],
        "source_clean": true,
        "history_commits": 1,
        "root_name": base_of(clone_path),
        "files": files["files"],
        "total_files": files["total_files"],
        "total_bytes": files["total_bytes"],
        "observed_depth": files["observed_depth"],
        "archive": "workspace.tar"
    }
    saved := save_json(manifest_path, manifest)
    archived := run_argv(["tar", "-cf", archive_path, "-C", parent_of(clone_path), base_of(clone_path)], 120000)
    cleanup_package_clone(clone_path, inspected["root"])
    if saved != true||process_ok(archived) == false {
        return {"ok": false, "error": "could not persist portable workspace package"}
    }
    mut archive_bytes := 0
    mut archive_digest := ""
    try {
        archive_bytes = file_size(archive_path)
        archive_digest = sha256_file(archive_path)
    } except err {
        return {"ok": false, "error": "could not inspect portable workspace archive: " + to_string(err)}
    }
    return {"ok": true, "schema_version": workspace_package_schema_version(), "archive_path": archive_path, "manifest_path": manifest_path, "sha256": archive_digest, "archive_bytes": archive_bytes, "expanded_bytes": files["total_bytes"], "files": files["total_files"], "source_commit": inspected["commit"], "root_name": manifest["root_name"], "manifest": manifest}
}

func inspect_tar_archive(archive_path, max_files) {
    names_result := run_argv(["tar", "-tf", archive_path], 60000)
    types_result := run_argv(["tar", "-tvf", archive_path], 60000)
    if process_ok(names_result) == false||process_ok(types_result) == false {
        return {"ok": false, "error": "archive could not be listed safely"}
    }
    names := split(trim(names_result.stdout), "\n")
    types := split(trim(types_result.stdout), "\n")
    if len(names) != len(types)||len(names) > max_files + 256 {
        return {"ok": false, "error": "archive listing is inconsistent or exceeds file bound"}
    }
    mut i := 0
    while i < len(names) {
        name := trim(names[i])
        while ends_with(name, "/")&&len(name) > 1 {
            name = substring(name, 0, len(name) - 1)
        }
        checked := normalized_relative(name)
        if checked["ok"] == false||checked["path"] != name {
            return {"ok": false, "error": "archive contains unsafe path: " + name}
        }
        detail := types[i]
        if detail == "" {
            return {"ok": false, "error": "archive entry type is missing"}
        }
        kind := substring(detail, 0, 1)
        if kind != "-"&&kind != "d" {
            return {"ok": false, "error": "archive contains unsupported entry type: " + name}
        }
        i = i + 1
    }
    return {"ok": true, "entries": len(names)}
}

func verify_package_manifest(root, manifest, limits) {
    if type(manifest) != "dict"||get_or(manifest, "schema_version", "") != workspace_package_schema_version()||type(get_or(manifest, "files", null)) != "array" {
        return {"ok": false, "error": "workspace package manifest is invalid"}
    }
    actual := collect_package_files(root, limits)
    if actual["ok"] == false {return actual}
    expected_files := manifest["files"]
    if len(expected_files) != actual["total_files"]||get_or(manifest, "total_bytes", - 1) != actual["total_bytes"] {
        return {"ok": false, "error": "workspace package manifest totals do not match materialized workspace"}
    }
    mut expected := {}
    mut i := 0
    while i < len(expected_files) {
        entry := expected_files[i]
        if type(entry) != "dict"||type(get_or(entry, "path", null)) != "string"||has_key(expected, entry["path"]) == 1 {
            return {"ok": false, "error": "workspace package manifest file entry is invalid"}
        }
        expected[entry["path"]] := entry
        i = i + 1
    }
    i = 0
    while i < len(actual["files"]) {
        entry = actual["files"][i]
        wanted := get_or(expected, entry["path"], null)
        if type(wanted) != "dict"||get_or(wanted, "sha256", "") != entry["sha256"]||get_or(wanted, "bytes", - 1) != entry["bytes"] {
            return {"ok": false, "error": "workspace package manifest mismatch: " + entry["path"]}
        }
        i = i + 1
    }
    return {"ok": true, "files": actual["total_files"], "bytes": actual["total_bytes"]}
}

export func materialize_workspace_package(package, target_dir, requested_limits) {
    if type(package) != "dict"||type(target_dir) != "string"||trim(target_dir) == "" {
        return {"ok": false, "error": "workspace package and target are invalid"}
    }
    archive_path := get_or(package, "archive_path", "")
    manifest := get_or(package, "manifest", null)
    expected_digest := get_or(package, "sha256", "")
    if file_exists(archive_path) == false||path_has_symlink(archive_path)||type(manifest) != "dict"||expected_digest == "" {
        return {"ok": false, "error": "workspace package archive, digest, or manifest is missing"}
    }
    mut actual_digest := ""
    try {
        actual_digest = sha256_file(archive_path)
    } except err {
        return {"ok": false, "error": "could not hash workspace package archive"}
    }
    if actual_digest != expected_digest {
        return {"ok": false, "error": "workspace package archive digest mismatch"}
    }
    limits := package_limits(requested_limits)
    inspected := inspect_tar_archive(archive_path, limits["max_files"])
    if inspected["ok"] == false {return inspected}
    if path_has_symlink(target_dir)||ensure_dir(target_dir) == false||path_is_dir(target_dir) == false {
        return {"ok": false, "error": "workspace package target is unsafe"}
    }
    mut existing := []
    try {
        existing = list_dir(target_dir)
    } except err {
        return {"ok": false, "error": "workspace package target cannot be listed"}
    }
    if len(existing) != 0 {
        return {"ok": false, "error": "workspace package target must be empty"}
    }
    extracted := run_argv(["tar", "-xf", archive_path, "-C", target_dir], 120000)
    if process_ok(extracted) == false {
        return {"ok": false, "error": process_error(extracted, "extract workspace package")}
    }
    root_name := get_or(manifest, "root_name", "")
    root_check := normalized_relative(root_name)
    if root_check["ok"] == false||root_check["path"] != root_name {
        return {"ok": false, "error": "workspace package root name is invalid"}
    }
    root := target_dir + "/" + root_name
    if path_is_dir(root) == false||path_within(target_dir, root) == false||path_has_symlink(root) {
        return {"ok": false, "error": "workspace package root is missing or unsafe"}
    }
    verified := verify_package_manifest(root, manifest, limits)
    if verified["ok"] == false {return verified}
    commit := run_argv(["git", "-C", root, "rev-parse", "HEAD"], 30000)
    status := run_argv(["git", "-C", root, "status", "--porcelain=v1", "--untracked-files=all"], 30000)
    if process_ok(commit) == false||trim(commit.stdout) != manifest["source_commit"]||process_ok(status) == false||trim(status.stdout) != "" {
        return {"ok": false, "error": "materialized workspace Git identity or cleanliness does not match manifest"}
    }
    return {"ok": true, "workspace_root": root, "observed_package_digest": actual_digest, "source_commit": trim(commit.stdout), "files": verified["files"], "bytes": verified["bytes"]}
}
