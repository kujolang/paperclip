# Podman-specific capability and identity resolution.

from src.backend.resolution import resolve_capabilities
from src.backend.types import backend_identity
from src.runtime.docker import doctor_runtime, podman_security_status, verify_daemon_security
from src.util import get_or

func podman_claim(status, evidence) {
    return {"status": status, "authority": "podman-engine", "evidence": evidence}
}

func podman_observation(status, method, result) {
    return {"status": status, "method": method, "result": result}
}

export func podman_identity(definition) {
    runtime := get_or(definition, "runtime", {})
    substrate := "oci/default"
    engine_runtime := get_or(runtime, "engine_runtime", "")
    if engine_runtime != "" {
        substrate = "oci/" + engine_runtime
    }
    return backend_identity("podman", "builtin", "podman-engine", "podman-cli", substrate)
}

export func podman_capabilities(definition) {
    security := podman_security_status()
    observed := podman_observation("not-observed", "podman-info", "unavailable")
    compute_support := "conditional"
    condition_met := false
    if get_or(security, "ok", false) {
        observed = podman_observation("observed", "podman-info", "rootless and security settings inspected")
        compute_support = "supported"
        condition_met = true
    }
    engine := podman_claim("workcell-enforced", "Podman CLI flags and Workcell watchdog")
    provider := podman_claim("provider-claimed", "Podman engine configuration")
    mut capabilities := {}
    required := [
    "lifecycle.provision",
    "lifecycle.terminate",
    "lifecycle.destroy",
    "lifecycle.inventory",
    "workspace.stage",
    "workspace.collect_delta",
    "process.argv",
    "process.exit_status",
    "execution.timeout",
    "logs.bounded",
    "artifact.selective_export",
    "environment.explicit",
    "credentials.redacted_transport",
    "evidence.provider_identity",
    "ownership.markers",
    "network.none",
    "network.custom",
    "filesystem.read_only_root",
    "filesystem.tmpfs",
    "filesystem.writable_paths",
    "image.oci",
    "image.digest",
    "logs.streaming",
    "logs.stdout_stderr_separate",
    "lifecycle.cancel_process"
    ]
    mut i := 0
    while i < len(required) {
        capabilities[required[i]] := {
            "support": "supported",
            "resolved": true,
            "enforcement": engine,
            "observation": observed,
            "limitations": []
        }
        i = i + 1
    }
    for id in ["process.argv", "process.exit_status", "network.none", "network.custom", "filesystem.read_only_root", "filesystem.tmpfs", "filesystem.writable_paths", "image.oci", "image.digest"] {
        provider_capability := capabilities[id]
        provider_capability["enforcement"] := provider
        capabilities[id] := provider_capability
    }
    for id in ["compute.cpu_limit", "compute.memory_limit", "compute.pid_limit"] {
        capabilities[id] := {
            "support": compute_support,
            "condition_met": condition_met,
            "resolved": true,
            "enforcement": podman_claim("provider-claimed", "Podman cgroup configuration"),
            "observation": observed,
            "limitations": ["availability depends on rootless mode and host cgroup configuration"]
        }
    }
    capabilities["compute.disk_limit"] := {"support": "unknown", "enforcement": podman_claim("unknown", ""), "observation": podman_observation("not-observed", "", ""), "limitations": ["no portable writable-layer disk ceiling"]}
    capabilities["lifecycle.pause"] := {"support": "unsupported", "enforcement": podman_claim("unsupported", ""), "observation": podman_observation("not-applicable", "", ""), "limitations": ["not part of the Workcell lifecycle"]}
    capabilities["lifecycle.resume"] := {"support": "unsupported", "enforcement": podman_claim("unsupported", ""), "observation": podman_observation("not-applicable", "", ""), "limitations": ["not part of the Workcell lifecycle"]}
    return capabilities
}

export func resolve_podman(definition, requirements) {
    resolution := resolve_capabilities(requirements, podman_capabilities(definition))
    resolution["identity"] := podman_identity(definition)
    return resolution
}

export func verify_podman_backend(definition) {
    return verify_daemon_security(definition)
}

export func doctor_podman_backend() {
    return doctor_runtime("podman")
}
