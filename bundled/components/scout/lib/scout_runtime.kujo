                    if lang == "Rust" {
                        if starts_with(trimmed, "use ") {
                            dep_part4 := trim(substring(trimmed, 4, len(trimmed)))
                            dep_words4 := split(dep_part4, " ")
                            dep_module4 := ""
                            for dw4 in dep_words4 {
                                if trim(dw4) != "" {
                                    dep_module4 := trim(dw4)
                                    break
                                }
                            }
                            if dep_module4 != "" {
                                if ends_with(dep_module4, ";") {
                                    dep_module4 := substring(dep_module4, 0, len(dep_module4) - 1)
                                }
                                dep_key5 := "rust_use|" + dep_module4
                                if has_key(DEP_SEEN, dep_key5) == 0 {
                                    DEP_SEEN[dep_key5] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "rust_use", "module": dep_module4, "source": out_path})
                                }
                            }
                        }

                        if starts_with(trimmed, "extern crate ") {
                            dep_part5 := trim(substring(trimmed, 13, len(trimmed)))
                            dep_words5 := split(dep_part5, " ")
                            dep_module5 := ""
                            for dw5 in dep_words5 {
                                if trim(dw5) != "" {
                                    dep_module5 := trim(dw5)
                                    break
                                }
                            }
                            if dep_module5 != "" {
                                if ends_with(dep_module5, ";") {
                                    dep_module5 := substring(dep_module5, 0, len(dep_module5) - 1)
                                }
                                dep_key6 := "extern_crate|" + dep_module5
                                if has_key(DEP_SEEN, dep_key6) == 0 {
                                    DEP_SEEN[dep_key6] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "extern_crate", "module": dep_module5, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "Go" {
                        if trimmed == "import (" {
                            inside_go_import_block := true
                        } else if inside_go_import_block && trimmed == ")" {
                            inside_go_import_block := false
                        } else if inside_go_import_block {
                            dep_module_block := first_quoted_value(trimmed)
                            if dep_module_block != "" {
                                dep_key_block := "go_import|" + dep_module_block
                                if has_key(DEP_SEEN, dep_key_block) == 0 {
                                    DEP_SEEN[dep_key_block] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "go_import", "module": dep_module_block, "source": out_path})
                                }
                            }
                        }

                        if starts_with(trimmed, "import \"") {
                            dep_module8 := ""
                            g1 := index_of(trimmed, "\"")
                            if g1 >= 0 {
                                g2 := find_after(trimmed, "\"", g1 + 1)
                                if g2 > g1 {
                                    dep_module8 := substring(trimmed, g1 + 1, g2)
                                }
                            }
                            if dep_module8 != "" {
                                dep_key9 := "go_import|" + dep_module8
                                if has_key(DEP_SEEN, dep_key9) == 0 {
                                    DEP_SEEN[dep_key9] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "go_import", "module": dep_module8, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "Haskell" {
                        if starts_with(trimmed, "import ") {
                            hs_part := trim(substring(trimmed, 7, len(trimmed)))
                            hs_words := split(hs_part, " ")
                            hs_dep := ""
                            hs_take_next := false
                            for hw in hs_words {
                                if trim(hw) != "" {
                                    if hs_take_next {
                                        hs_dep := trim(hw)
                                        break
                                    }
                                    if trim(hw) == "qualified" {
                                        hs_take_next := true
                                    }
                                    if trim(hw) != "qualified" {
                                        hs_dep := trim(hw)
                                        break
                                    }
                                }
                            }
                            if hs_dep != "" {
                                hs_key := "haskell_import|" + hs_dep
                                if has_key(DEP_SEEN, hs_key) == 0 {
                                    DEP_SEEN[hs_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "haskell_import", "module": hs_dep, "source": out_path})
                                }
                            }
                        }
                    }

