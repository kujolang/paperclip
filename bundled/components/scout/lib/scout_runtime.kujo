                        for py_mk in [[".get(", "GET"], [".post(", "POST"], [".put(", "PUT"], [".patch(", "PATCH"], [".delete(", "DELETE"], [".options(", "OPTIONS"], [".head(", "HEAD"]] {
                            py_sig := py_mk[0]
                            py_method := py_mk[1]
                            if starts_with(trimmed, "@") && index_of(trimmed, py_sig) >= 0 {
                                py_route2 := first_quoted_value(trimmed)
                                if py_route2 != "" {
