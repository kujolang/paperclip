                        if index_of(trimmed, "wp_ajax_") >= 0 {
                            ajax_action := ""
                            ajax_hook := first_quoted_value(trimmed)
                            if ajax_hook != "" {
                                if starts_with(ajax_hook, "wp_ajax_") {
                                    ajax_action := substring(ajax_hook, len("wp_ajax_"), len(ajax_hook))
                                }
                                if starts_with(ajax_hook, "wp_ajax_nopriv_") {
                                    ajax_action := substring(ajax_hook, len("wp_ajax_nopriv_"), len(ajax_hook))
                                }
                            }

                            if ajax_action != "" {
                                ajax_path := "/wp-admin/admin-ajax.php?action=" + ajax_action
                                ajax_key := "POST|" + ajax_path + "|" + path
                                if has_key(ROUTE_SEEN, ajax_key) == 0 {
                                    ROUTE_SEEN[ajax_key] := true
                                    ROUTES := push(ROUTES, {"method": "POST", "path": ajax_path, "source": out_path})
                                }
                            }
