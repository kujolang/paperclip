SECURITY_PATTERNS := [
    {"match": ["password =", "password=", "secret =", "api_key =", "apikey ="], "label": "Hardcoded credential", "severity": "high"},
    {"match": ["token =", "token=", "auth_token", "access_token", "refresh_token"], "label": "Hardcoded token", "severity": "high"},
    {"match": ["-----BEGIN", "PRIVATE KEY-----"], "label": "Embedded private key", "severity": "critical"},
    {"match": ["eval(", "exec(", "system(", "shell_exec(", "passthru("], "label": "Dangerous code execution function", "severity": "high"},
    {"match": ["innerHTML =", "innerHTML=", "document.write(", "dangerouslySetInnerHTML"], "label": "XSS sink usage", "severity": "medium"},
    {"match": ["unserialize(", "pickle.load(", "pickle.loads("], "label": "Insecure deserialization", "severity": "high"},
    {"match": ["md5(", "sha1("], "label": "Weak hash usage", "severity": "low"}
]

func normalize_security_export_format(value) {
    format_text := trim(to_string(value))
    if format_text == "" {
        return ""
    }

    format_upper := upper(format_text)
    if format_upper == "SARIF" {
        return "sarif"
    }
    if format_upper == "JSONL" {
        return "jsonl"
    }

    return ""
}

func normalize_output_profile(value) {
    profile_text := lower(trim(to_string(value)))
    if profile_text == "" {
        return ""
    }
    if profile_text == "full" {
        return "full"
    }
    if profile_text == "minimal" || profile_text == "quick" {
        return "minimal"
    }
    return ""
}

func literal_option_value(source, key) {
    key_pos := index_of(source, key + ":")
    if key_pos < 0 {
        return ""
    }
    tail := trim(substring(source, key_pos + len(key) + 1, len(source)))
    if !starts_with(tail, "\"") && !starts_with(tail, "'") && !starts_with(tail, "`") {
        return ""
    }
    return first_quoted_value(tail)
}

func enable_optional_rule(name) {
    rule := trim(to_string(name))
    if rule != "fastify-object" {
        invalid_expected("optional rule", rule, "fastify-object")
    }
    if has_key(OPTIONAL_RULE_SEEN, rule) == 0 {
        OPTIONAL_RULE_SEEN[rule] := true
        OPTIONAL_RULES := push(OPTIONAL_RULES, rule)
    }
}

func is_non_negative_integer_text(value) {
    text := trim(to_string(value))
    if text == "" {
        return false
    }

    char_i := 0
    while char_i < len(text) {
        ch := substring(text, char_i, char_i + 1)
        if ch < "0" || ch > "9" {
            return false
        }
        char_i := char_i + 1
    }

    return true
}

func append_lines(lines, new_lines) {
    out_lines := lines
    for line in new_lines {
        out_lines := push(out_lines, line)
    }
    return out_lines
}

func print_lines(lines) {
    for line in lines {
        print(line)
    }
}

func error_exit(message) {
    print("Error: " + message)
    exit(1)
}

# Stable identifiers let CI classify fail-closed resource limits without
# parsing human prose. The prose remains for operators and compatibility.
func limit_error(identifier, message) {
    error_exit("[" + identifier + "] " + message)
}

func missing_option_value(option) {
    error_exit("missing value for " + option)
}

func empty_option_value(option) {
    error_exit("empty value for " + option)
}

func invalid_expected(name, value, expected) {
    error_exit("invalid " + name + ": " + to_string(value) + " (expected: " + expected + ")")
}

func invalid_format_expected(name, value, expected) {
    error_exit("invalid " + name + " format: " + to_string(value) + " (expected: " + expected + ")")
}

func md_section(lines, title) {
    return append_lines(lines, ["", "## " + title, ""])
}

func md_kv(label, value) {
    return "- " + label + ": " + to_string(value)
}

func md_check(text) {
    return "- [ ] " + text
}

func md_table_row(cells) {
    return "| " + join(cells, " | ") + " |"
}

func kv_line(label, value) {
    return label + ": " + to_string(value)
}

func is_absolute_input_path(value) {
    text := to_string(value)
    if starts_with(text, "/") || starts_with(text, "\\") {
        return true
    }
    if len(text) >= 3 && substring(text, 1, 3) == ":\\" {
        return true
    }
    if len(text) >= 3 && substring(text, 1, 3) == ":/" {
        return true
    }
    return false
}

func is_safe_relative_input_path(value) {
    text := to_string(value)
    if text == "" || is_absolute_input_path(text) {
        return false
    }
    normalized := normalize_filter_text(text)
    if normalized == ".." || starts_with(normalized, "../") || index_of(normalized, "/../") >= 0 {
        return false
    }
    return true
}

func decode_utf8_prefix_beneath(root, relative_path, byte_limit) {
    prefix_bytes := read_binary_prefix_beneath(root, relative_path, byte_limit)
    decoded := false
    decoded_text := ""
    trim_bytes := 0
    while trim_bytes < 4 && !decoded {
        try {
            if trim_bytes > 0 {
                prefix_bytes := read_binary_prefix_beneath(root, relative_path, byte_limit - trim_bytes)
            }
            decoded_text := decode_base64_utf8(encode_base64(prefix_bytes))
            decoded := true
        } except err {
            trim_bytes := trim_bytes + 1
        }
    }
    if !decoded {
        decoded_text := decode_base64_utf8(encode_base64(prefix_bytes))
    }
    return decoded_text
}

func markdown_data(value) {
    safe := replace(to_string(value), "\r", " ")
    safe := replace(safe, "\n", " ")
    safe := replace(safe, "\t", " ")
    safe := replace(safe, "`", "'")
    safe := replace(safe, "|", "&#124;")
    safe := replace(safe, "<", "&lt;")
    safe := replace(safe, ">", "&gt;")
    return safe
}

ARGS := args()

if file_exists(CONFIG_PATH) {
    try {
        config_doc := parse_json(read_file(CONFIG_PATH))

        if has_key(config_doc, "scan") && type(config_doc["scan"]) == "dict" {
            scan_doc := config_doc["scan"]

            if has_key(scan_doc, "default_max_depth") {
                cfg_depth := trim(to_string(scan_doc["default_max_depth"]))
                if !is_non_negative_integer_text(cfg_depth) {
                    error_exit("scan.default_max_depth must be a non-negative integer")
                }
                if cfg_depth != "" {
                    MAX_DEPTH := to_int(cfg_depth)
                }
            }

            if has_key(scan_doc, "max_file_size") {
                cfg_size := trim(to_string(scan_doc["max_file_size"]))
                if !is_non_negative_integer_text(cfg_size) {
                    error_exit("scan.max_file_size must be a non-negative integer")
                }
                if cfg_size != "" {
                    MAX_FILE_SIZE := to_int(cfg_size)
                }
            }

            for limit_spec in [
                ["max_entries", "entries"],
                ["max_code_files", "code files"],
                ["max_total_analyzed_bytes", "total analyzed bytes"],
                ["max_analysis_results", "analysis results"],
                ["max_ignore_rules", "ignore rules"]
            ] {
                limit_key := limit_spec[0]
                if has_key(scan_doc, limit_key) {
                    limit_value := trim(to_string(scan_doc[limit_key]))
                    if !is_non_negative_integer_text(limit_value) || limit_value == "" || to_int(limit_value) == 0 {
                        error_exit("scan." + limit_key + " must be a positive integer")
                    }
                    if limit_key == "max_entries" {
                        MAX_ENTRIES := to_int(limit_value)
                    }
                    if limit_key == "max_code_files" {
                        MAX_CODE_FILES := to_int(limit_value)
                    }
                    if limit_key == "max_total_analyzed_bytes" {
                        MAX_TOTAL_ANALYZED_BYTES := to_int(limit_value)
                    }
                    if limit_key == "max_analysis_results" {
                        MAX_ANALYSIS_RESULTS := to_int(limit_value)
                    }
                    if limit_key == "max_ignore_rules" {
                        MAX_IGNORE_RULES := to_int(limit_value)
                    }
                }
            }

            if has_key(scan_doc, "ignored_dirs") && type(scan_doc["ignored_dirs"]) == "array" {
                for ignored_dir in scan_doc["ignored_dirs"] {
                    ignored_name := trim(to_string(ignored_dir))
                    if ignored_name != "" {
                        IGNORED_DIRS[ignored_name] := true
                    }
                }
            }

            if has_key(scan_doc, "include") && type(scan_doc["include"]) == "array" {
                for include_rule in scan_doc["include"] {
                    include_text := trim(to_string(include_rule))
                    if include_text != "" {
                        INCLUDE_PATTERNS := push(INCLUDE_PATTERNS, include_text)
                    }
                }
            }

            if has_key(scan_doc, "exclude") && type(scan_doc["exclude"]) == "array" {
                for exclude_rule in scan_doc["exclude"] {
                    exclude_text := trim(to_string(exclude_rule))
                    if exclude_text != "" {
                        EXCLUDE_PATTERNS := push(EXCLUDE_PATTERNS, exclude_text)
                    }
                }
            }
        }

        if has_key(config_doc, "output") && type(config_doc["output"]) == "dict" {
            output_doc := config_doc["output"]
            if has_key(output_doc, "default_dir") {
                cfg_output_root := trim(to_string(output_doc["default_dir"]))
                if cfg_output_root != "" {
                    OUTPUT_ROOT := cfg_output_root
                }
            }
            if has_key(output_doc, "path_mode") {
                cfg_path_mode := trim(to_string(output_doc["path_mode"]))
                if cfg_path_mode != "" {
                    PATH_MODE := cfg_path_mode
                }
            }
			if has_key(output_doc, "profile") {
				cfg_profile := normalize_output_profile(output_doc["profile"])
				if cfg_profile == "" {
					invalid_format_expected("output.profile", output_doc["profile"], "full|minimal")
				}
				OUTPUT_PROFILE := cfg_profile
			}
            if has_key(output_doc, "emit_kennel_index") && type(output_doc["emit_kennel_index"]) == "bool" {
                EMIT_KENNEL_INDEX := output_doc["emit_kennel_index"]
            }
            if has_key(output_doc, "emit_kennel_metadata") && type(output_doc["emit_kennel_metadata"]) == "bool" {
                EMIT_KENNEL_METADATA := output_doc["emit_kennel_metadata"]
            }
            if has_key(output_doc, "security_exports") && type(output_doc["security_exports"]) == "array" {
                cfg_export_list := output_doc["security_exports"]
                cfg_export_i := 0
                while cfg_export_i < len(cfg_export_list) {
                    cfg_export_format := cfg_export_list[cfg_export_i]
                    normalized_export := normalize_security_export_format(cfg_export_format)
                    if normalized_export == "" {
                        invalid_format_expected("output.security_exports", cfg_export_format, "sarif|jsonl")
                    }

                    if has_key(SECURITY_EXPORT_SEEN, normalized_export) == 0 {
                        SECURITY_EXPORT_SEEN[normalized_export] := true
                        SECURITY_EXPORT_FORMATS := push(SECURITY_EXPORT_FORMATS, normalized_export)
                    }

                    cfg_export_i := cfg_export_i + 1
                }
            }
        }

        if has_key(config_doc, "analysis") && type(config_doc["analysis"]) == "dict" {
            analysis_doc := config_doc["analysis"]

            if has_key(analysis_doc, "strict_scan") && type(analysis_doc["strict_scan"]) == "bool" {
                STRICT_SCAN := analysis_doc["strict_scan"]
            }
            if has_key(analysis_doc, "optional_rules") && type(analysis_doc["optional_rules"]) == "array" {
                for rule_name in analysis_doc["optional_rules"] {
                    enable_optional_rule(rule_name)
                }
            }

            if has_key(analysis_doc, "metrics") && type(analysis_doc["metrics"]) == "bool" {
                METRICS_ENABLED := analysis_doc["metrics"]
            }

            if has_key(analysis_doc, "security") && type(analysis_doc["security"]) == "bool" {
                if analysis_doc["security"] == false {
                    SKIP_SEC := true
                }
                if analysis_doc["security"] == true {
                    SKIP_SEC := false
                }
            }

            if has_key(analysis_doc, "dependencies") && type(analysis_doc["dependencies"]) == "bool" {
                if analysis_doc["dependencies"] == false {
                    SKIP_DEPS := true
                }
                if analysis_doc["dependencies"] == true {
                    SKIP_DEPS := false
                }
            }

            if has_key(analysis_doc, "routes") && type(analysis_doc["routes"]) == "bool" {
                if analysis_doc["routes"] == false {
                    SKIP_ROUTES := true
                }
                if analysis_doc["routes"] == true {
                    SKIP_ROUTES := false
                }
            }

            if has_key(analysis_doc, "security_baseline_file") {
                cfg_baseline := trim(to_string(analysis_doc["security_baseline_file"]))
                if cfg_baseline != "" {
                    BASELINE_FILE := cfg_baseline
                }
            }

            if has_key(analysis_doc, "show_suppressed_findings") && type(analysis_doc["show_suppressed_findings"]) == "bool" {
                SHOW_SUPPRESSED := analysis_doc["show_suppressed_findings"]
            }
        }
    } except err {
        error_exit("invalid config.json: " + to_string(err))
    }
}

I := 0
while I < len(ARGS) {
    a := ARGS[I]
    handled_option := false

    if a == "-h" || a == "--help" {
        print_lines([
            "Scout " + VERSION,
            "Usage: kujo run scout.kujo [path] [options]",
            "Options:",
            "  -o, --output DIR     Output root directory (default: ./results)",
            "  -d, --max-depth N    Max directory depth (default: 6)",
            "  --skip-security      Skip security smell scan",
            "  --skip-deps          Skip dependency analysis",
            "  --skip-routes        Skip route discovery",
            "  --include PATTERN    Include only files matching glob (repeatable)",
            "  --exclude PATTERN    Exclude files/directories matching glob (repeatable)",
            "  --ignore-file PATH   Ignore file path relative to target (default: .scoutignore)",
            "  --path-mode MODE     Path style for outputs: relative|absolute (default: relative)",
            "  --output-profile P   Output profile: full|minimal (default: full)",
            "  --quick              Shortcut for --output-profile minimal",
            "  --strict             Exit 2 on partial scans (diagnostics remain in output)",
            "  --rule NAME         Opt into a rule: fastify-object (repeatable)",
            "  --security-export F  Security export format: sarif|jsonl (repeatable)",
            "  --baseline PATH      Baseline file for suppressed security findings (default: scout-baseline.json)",
            "  --show-suppressed    Include suppressed findings in output",
            "  --write-baseline     Write current findings to baseline file",
            "  --kennel-index       Emit Kennel-compatible index.json payload",
            "  --kennel-metadata    Emit Kennel-compatible packages/<name>.json payload",
            "  -v, --version        Show version"
        ])
        return
    }

    if a == "-v" || a == "--version" {
        print(VERSION)
        return
    }

    if a == "-o" || a == "--output" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        output_value := trim(ARGS[I])
        if output_value == "" {
            empty_option_value(a)
        }

        OUTPUT_ROOT := output_value
    }

    if a == "-d" || a == "--max-depth" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        depth_value := trim(ARGS[I])
        if !is_non_negative_integer_text(depth_value) {
            error_exit("invalid max depth: " + depth_value)
        }

        MAX_DEPTH := to_int(depth_value)
    }

    if a == "--skip-security" {
        handled_option := true
        SKIP_SEC := true
    }

    if a == "--skip-deps" {
        handled_option := true
        SKIP_DEPS := true
    }

    if a == "--skip-routes" {
        handled_option := true
        SKIP_ROUTES := true
    }

    if a == "--include" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        include_cli := trim(ARGS[I])
        if include_cli == "" {
            empty_option_value(a)
        }

        INCLUDE_PATTERNS := push(INCLUDE_PATTERNS, include_cli)
    }

    if a == "--exclude" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        exclude_cli := trim(ARGS[I])
        if exclude_cli == "" {
            empty_option_value(a)
        }

        EXCLUDE_PATTERNS := push(EXCLUDE_PATTERNS, exclude_cli)
    }

    if a == "--ignore-file" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        ignore_cli := trim(ARGS[I])
        if ignore_cli == "" {
            empty_option_value(a)
        }

        IGNORE_FILE := ignore_cli
    }

    if a == "--path-mode" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        path_mode_cli := trim(ARGS[I])
        if path_mode_cli == "" {
            empty_option_value(a)
        }

        PATH_MODE := path_mode_cli
    }

    if a == "--output-profile" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        profile_cli := normalize_output_profile(ARGS[I])
        if profile_cli == "" {
            invalid_expected("output profile", ARGS[I], "full|minimal")
        }

        OUTPUT_PROFILE := profile_cli
    }

    if a == "--quick" {
        handled_option := true
        OUTPUT_PROFILE := "minimal"
    }

    if a == "--strict" {
        handled_option := true
        STRICT_SCAN := true
    }

    if a == "--rule" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }
        enable_optional_rule(ARGS[I])
    }

    if a == "--security-export" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        export_cli := normalize_security_export_format(ARGS[I])
        if export_cli == "" {
            invalid_expected("security export format", ARGS[I], "sarif|jsonl")
        }

        if has_key(SECURITY_EXPORT_SEEN, export_cli) == 0 {
            SECURITY_EXPORT_SEEN[export_cli] := true
            SECURITY_EXPORT_FORMATS := push(SECURITY_EXPORT_FORMATS, export_cli)
        }
    }

    if a == "--baseline" {
        handled_option := true
        I := I + 1
        if I >= len(ARGS) {
            missing_option_value(a)
        }

        baseline_cli := trim(ARGS[I])
        if baseline_cli == "" {
            empty_option_value(a)
        }

        BASELINE_FILE := baseline_cli
    }

    if a == "--show-suppressed" {
        handled_option := true
        SHOW_SUPPRESSED := true
    }

    if a == "--write-baseline" {
        handled_option := true
        WRITE_BASELINE := true
    }

    if a == "--kennel-index" {
        handled_option := true
        EMIT_KENNEL_INDEX := true
    }

    if a == "--kennel-metadata" {
        handled_option := true
        EMIT_KENNEL_METADATA := true
    }

    if starts_with(a, "-") && !handled_option {
        error_exit("unknown option: " + a)
    }

    if !starts_with(a, "-") {
        TARGET := a
    }

    I := I + 1
}

if !file_exists(TARGET) {
    error_exit("target path not found: " + TARGET)
}
if !path_is_dir(TARGET) {
    error_exit("target must be a directory: " + TARGET)
}

TARGET_ABS := path_absolute(TARGET)

# Older Kujo releases cannot confine large prefix reads to the target root.
# Fail before scanning rather than publishing a quietly partial report.
try {
    prefix_reader_kind := type(read_binary_prefix_beneath)
} except err {
    error_exit("this Scout build requires Kujo with read_binary_prefix_beneath; see README install instructions")
}

PATH_MODE := trim(PATH_MODE)
if PATH_MODE != "relative" && PATH_MODE != "absolute" {
    invalid_expected("path mode", PATH_MODE, "relative|absolute")
}

if OUTPUT_PROFILE != "full" && OUTPUT_PROFILE != "minimal" {
	invalid_expected("output profile", OUTPUT_PROFILE, "full|minimal")
}

TARGET_DISPLAY := TARGET
if PATH_MODE == "absolute" {
    TARGET_DISPLAY := TARGET_ABS
}

BASELINE_PATH := BASELINE_FILE
BASELINE_READ_ROOT := TARGET_ABS
BASELINE_READ_REL := BASELINE_FILE
if BASELINE_PATH != "" {
    if is_absolute_input_path(BASELINE_PATH) {
        BASELINE_READ_ROOT := dirname(BASELINE_PATH)
        BASELINE_READ_REL := basename(BASELINE_PATH)
    } else {
        if !is_safe_relative_input_path(BASELINE_PATH) {
            error_exit("baseline path must be relative to the scan target or an explicit absolute path")
        }
        BASELINE_PATH := TARGET_ABS + "/" + BASELINE_PATH
        if file_exists(BASELINE_PATH) {
            baseline_abs := path_absolute(BASELINE_PATH)
            if !is_canonical_path_within_target(baseline_abs, TARGET_ABS) {
                error_exit("baseline path must stay within the scan target")
            }
        }
    }
}

BASELINE_FINGERPRINTS := {}
if !SKIP_SEC && BASELINE_PATH != "" && file_exists(BASELINE_PATH) {
    try {
        baseline_text := decode_utf8_prefix_beneath(BASELINE_READ_ROOT, BASELINE_READ_REL, 4194305)
        if len(baseline_text) > 4194304 {
            limit_error("SCOUT-LIMIT-BASELINE-BYTES", "baseline file exceeds 4194304 bytes")
        }
        baseline_doc := parse_json(baseline_text)
        if has_key(baseline_doc, "fingerprints") && type(baseline_doc["fingerprints"]) == "array" {
            baseline_fingerprints := baseline_doc["fingerprints"]
            baseline_i := 0
            while baseline_i < len(baseline_fingerprints) {
                baseline_fp := trim(to_string(baseline_fingerprints[baseline_i]))
                if baseline_fp != "" {
                    BASELINE_FINGERPRINTS[baseline_fp] := true
                }
                baseline_i := baseline_i + 1
            }
        }
    } except err {
        error_exit("invalid baseline file: " + BASELINE_PATH + ": " + to_string(err))
    }
}

if IGNORE_FILE != "" {
    IGNORE_READ_ROOT := TARGET_ABS
    IGNORE_READ_REL := IGNORE_FILE
    ignore_file_path := IGNORE_FILE
    if is_absolute_input_path(IGNORE_FILE) {
        IGNORE_READ_ROOT := dirname(IGNORE_FILE)
        IGNORE_READ_REL := basename(IGNORE_FILE)
    } else {
        if !is_safe_relative_input_path(IGNORE_FILE) {
            error_exit("ignore file path must be relative to the scan target or an explicit absolute path")
        }
        ignore_file_path := TARGET_ABS + "/" + IGNORE_FILE
        if file_exists(ignore_file_path) {
            ignore_file_abs := path_absolute(ignore_file_path)
            if !is_canonical_path_within_target(ignore_file_abs, TARGET_ABS) {
                error_exit("ignore file path must stay within the scan target")
            }
        }
    }

    if file_exists(ignore_file_path) {
        try {
            ignore_text := decode_utf8_prefix_beneath(IGNORE_READ_ROOT, IGNORE_READ_REL, 262145)
            if len(ignore_text) > 262144 {
                limit_error("SCOUT-LIMIT-IGNORE-BYTES", "ignore file exceeds 262144 bytes")
            }
            ignore_lines := split(ignore_text, "\n")
            for ignore_line in ignore_lines {
                ignore_rule := trim(ignore_line)
                if ignore_rule != "" && !starts_with(ignore_rule, "#") {
                    if len(EXCLUDE_PATTERNS) >= MAX_IGNORE_RULES {
                        limit_error("SCOUT-LIMIT-IGNORE-RULES", "ignore rule limit exceeded: " + to_string(MAX_IGNORE_RULES))
                    }
                    EXCLUDE_PATTERNS := push(EXCLUDE_PATTERNS, ignore_rule)
                }
            }
        } except err {
            error_exit("unable to read ignore file: " + ignore_file_path)
        }
    }
}

if MAX_DEPTH < 0 {
    MAX_DEPTH := 0
}

PROJECT_NAME := basename_from_path(TARGET)
if PROJECT_NAME == "" || PROJECT_NAME == "." || PROJECT_NAME == ".." {
    PROJECT_NAME := basename_from_path(path_absolute(TARGET))
}
if PROJECT_NAME == "" {
    PROJECT_NAME := "project"
}

PROJECT_SLUG := sanitize_slug(PROJECT_NAME)
RUN_TS := format_date(now(), "YYYYMMDD-HHmmss") + "-" + to_string(current_timestamp()) + "-" + substring(uuid_v4(), 0, 8)
OUTPUT := OUTPUT_ROOT + "/" + PROJECT_SLUG + "-" + RUN_TS
STAGING := OUTPUT_ROOT + "/.scout-stage-" + RUN_TS

OUTPUT_ROOT_ABS := ""
OUTPUT_BASE := basename_from_path(OUTPUT_ROOT)
if file_exists(OUTPUT_ROOT) {
    OUTPUT_ROOT_ABS := path_absolute(OUTPUT_ROOT)
}

PARSE_ERRORS := []
TREE_LINES := ["# Project File Tree", "", "- [D] " + markdown_data(TARGET_DISPLAY)]
CODE_FILES := []
TOTAL_FILES_SEEN := 0
TOTAL_DIRS_SEEN := 0

root_out_path := "."
if PATH_MODE == "absolute" {
    root_out_path := TARGET_ABS
}
LEVEL_DIRS := [{"path": TARGET, "depth": 0, "ancestors": [TARGET_ABS], "out_path": root_out_path}]
while len(LEVEL_DIRS) > 0 {
    NEXT_LEVEL := []

    for dir_node in LEVEL_DIRS {
        dir_path := dir_node["path"]
        dir_depth := dir_node["depth"]
        dir_out_path := dir_node["out_path"]

        try {
            items := sort_strings_asc(list_dir(dir_path))
            for item in items {
                try {
                    # Honor the explicit ignore list, but keep useful hidden project
                    # directories (for example .github) available to the scanner.
                    # Exclude generated reports only when the output root is inside
                    # the target; a same-named directory elsewhere is not output.
                    if has_key(IGNORED_DIRS, item) == 0 && !(dir_depth == 0 && starts_with(item, "kujo-intel")) && !(dir_depth == 0 && starts_with(item, "kujo intel")) {
                        full_path := dir_path + "/" + item
                        child_abs := path_absolute(full_path)
                        output_dir_entry := OUTPUT_ROOT_ABS != "" && item == OUTPUT_BASE && child_abs == OUTPUT_ROOT_ABS
                        if !output_dir_entry && is_canonical_path_within_target(child_abs, TARGET_ABS) {
                            if TOTAL_FILES_SEEN + TOTAL_DIRS_SEEN >= MAX_ENTRIES {
                                limit_error("SCOUT-LIMIT-ENTRIES", "scan entry limit exceeded: " + to_string(MAX_ENTRIES))
                            }
                            child_is_dir := path_is_dir(full_path)
                            rel_path := relative_canonical_path_from_target(child_abs, TARGET_ABS)
                            child_out_path := rel_path
                            if PATH_MODE == "absolute" {
                                child_out_path := child_abs
                            }

                            excluded := false
                            if len(EXCLUDE_PATTERNS) > 0 {
                                ex_i := 0
                                while ex_i < len(EXCLUDE_PATTERNS) {
                                    if pattern_match(rel_path, to_string(EXCLUDE_PATTERNS[ex_i])) {
                                        excluded := true
                                        break
                                    }
                                    ex_i := ex_i + 1
                                }
                            }

                            include_allowed := true
                            if !child_is_dir && len(INCLUDE_PATTERNS) > 0 {
                                include_allowed := false
                                in_i := 0
                                while in_i < len(INCLUDE_PATTERNS) {
                                    if pattern_match(rel_path, to_string(INCLUDE_PATTERNS[in_i])) {
                                        include_allowed := true
                                        break
                                    }
                                    in_i := in_i + 1
                                }
                            }

                            if !excluded && include_allowed {
                                indent := ""
                                ind_i := 0
                                while ind_i < dir_depth + 1 {
                                    indent := indent + "  "
                                    ind_i := ind_i + 1
                                }

                                if child_is_dir {
                                    TOTAL_DIRS_SEEN := TOTAL_DIRS_SEEN + 1
                                    TREE_LINES := push(TREE_LINES, indent + "- [D] " + markdown_data(item))
                                    directory_cycle := false
                                    for ancestor in dir_node["ancestors"] {
                                        if child_abs == ancestor {
                                            directory_cycle := true
                                        }
                                    }
                                    if directory_cycle {
                                        PARSE_ERRORS := push(PARSE_ERRORS, {"file": child_out_path, "error": "directory_cycle"})
                                    }
                                    if !directory_cycle && dir_depth < MAX_DEPTH {
                                        NEXT_LEVEL := push(NEXT_LEVEL, {"path": full_path, "depth": dir_depth + 1, "ancestors": push(dir_node["ancestors"], child_abs), "out_path": child_out_path})
                                    }
                                }

                                if !child_is_dir && path_is_file(full_path) {
                                    TOTAL_FILES_SEEN := TOTAL_FILES_SEEN + 1

                                    file_size_bytes := 0
                                    try {
                                        file_size_bytes := file_size(full_path)
                                    } except err {
                                        file_size_bytes := 0
                                        PARSE_ERRORS := push(PARSE_ERRORS, {"file": rel_path, "error": "stat_failed"})
                                    }

                                    lang := "Unknown"
                                    for ext in keys(LANGUAGE_MAP) {
                                        if ends_with(item, ext) {
                                            lang := LANGUAGE_MAP[ext]
                                            break
                                        }
                                    }

                                    size_label := to_string(file_size_bytes) + " B"
                                    if file_size_bytes >= 1024 && file_size_bytes < 1048576 {
                                        size_label := to_string(round((file_size_bytes / 1024) * 10) / 10) + " KB"
                                    }
                                    if file_size_bytes >= 1048576 {
                                        size_label := to_string(round((file_size_bytes / 1048576) * 10) / 10) + " MB"
                                    }

                                    TREE_LINES := push(TREE_LINES, indent + "- [F] " + markdown_data(item) + " (" + lang + ", " + size_label + ")")

                                    ignored_ext := false
                                    for ext2 in keys(IGNORED_EXTS) {
                                        if ends_with(item, ext2) {
                                            ignored_ext := true
                                            break
                                        }
                                    }

                                    include_as_code := false
                                    if !ignored_ext && lang != "Unknown" && lang != "Lock File" {
                                        include_as_code := true
                                    }
                                    if !ignored_ext && has_key(MANIFEST_FILES, item) {
                                        include_as_code := true
                                    }
                                    if !ignored_ext && starts_with(item, "requirements-") && ends_with(item, ".txt") {
                                        include_as_code := true
                                    }

                                    if include_as_code {
                                        if len(CODE_FILES) >= MAX_CODE_FILES {
                                            limit_error("SCOUT-LIMIT-CODE-FILES", "code file limit exceeded: " + to_string(MAX_CODE_FILES))
                                        }
                                        CODE_FILES := push(CODE_FILES, {
                                            "path": full_path,
                                            "out_path": child_out_path,
                                            "relative_source_path": rel_path,
                                            "name": item,
                                            "lang": lang,
                                            "size": file_size_bytes
                                        })
                                    }
                                }
                            }
                        }
                    }
                } except err {
                    entry_error_path := dir_out_path + "/" + item
                    if dir_out_path == "." {
                        entry_error_path := item
                    }
                    PARSE_ERRORS := push(PARSE_ERRORS, {"file": entry_error_path, "error": "path_unavailable"})
                }
            }
        } except err {
            PARSE_ERRORS := push(PARSE_ERRORS, {"file": dir_out_path, "error": "directory_read_failed"})
        }
    }

    LEVEL_DIRS := NEXT_LEVEL
}

METRICS := {
    "total_files": 0,
    "total_lines": 0,
    "total_size": 0,
    "languages": {},
    "largest_files": []
}

if METRICS_ENABLED {
    METRICS["total_files"] := len(CODE_FILES)
}

DEPENDENCIES := []
DEP_SEEN := {}
ROUTES := []
ROUTE_SEEN := {}
SECURITY_FINDINGS := []
ALL_SECURITY_FINDINGS := []
SECURITY_FINDINGS_TOTAL := 0
SUPPRESSED_SECURITY_FINDINGS := []
ANALYZED_BYTES := 0

for code_file in CODE_FILES {
    path := code_file["path"]
    out_path := code_file["out_path"]
    name := code_file["name"]
    lang := code_file["lang"]
    size := code_file["size"]

    analyzed_file_bytes := size
    if analyzed_file_bytes > MAX_FILE_SIZE * 4 {
        analyzed_file_bytes := MAX_FILE_SIZE * 4
    }
    if ANALYZED_BYTES + analyzed_file_bytes > MAX_TOTAL_ANALYZED_BYTES {
        limit_error("SCOUT-LIMIT-ANALYZED-BYTES", "total analyzed byte limit exceeded: " + to_string(MAX_TOTAL_ANALYZED_BYTES))
    }
    ANALYZED_BYTES := ANALYZED_BYTES + analyzed_file_bytes

    if METRICS_ENABLED {
        METRICS["total_size"] := METRICS["total_size"] + size

        language_counts := METRICS["languages"]
        next_lang_count := 1
        if has_key(language_counts, lang) {
            next_lang_count := language_counts[lang] + 1
        }
        language_counts[lang] := next_lang_count
        METRICS["languages"] := language_counts
    }

    content := ""
    read_ok := false
    truncated := false

    try {
        # The canonical in-root path was captured during discovery; the reader
        # confines every actual open to the trusted root even if the entry
        # changes in the meantime. A vanished entry becomes read_failed.
        relative_source_path := code_file["relative_source_path"]
        max_read_bytes := MAX_FILE_SIZE * 4
        content := decode_utf8_prefix_beneath(TARGET_ABS, relative_source_path, max_read_bytes)
        read_ok := true
    } except err {
        read_ok := false
    }

    if !read_ok {
        PARSE_ERRORS := push(PARSE_ERRORS, {"file": out_path, "error": "read_failed"})
    }

    if read_ok {
        if size > MAX_FILE_SIZE * 4 || len(content) > MAX_FILE_SIZE {
            content := substring(content, 0, MAX_FILE_SIZE)
            truncated := true
        }

        if truncated {
            PARSE_ERRORS := push(PARSE_ERRORS, {"file": out_path, "error": "truncated_" + to_string(MAX_FILE_SIZE) + "b"})
        }

        lines := split(content, "\n")
        if METRICS_ENABLED {
            METRICS["total_lines"] := METRICS["total_lines"] + len(lines)
        }

        if !SKIP_DEPS {
            if name == "package.json" {
                pkg_parsed := false
                try {
                    pkg_doc := parse_json(content)
                    for pkg_section_name in ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"] {
                        if has_key(pkg_doc, pkg_section_name) && type(pkg_doc[pkg_section_name]) == "dict" {
                            for pkg_dep_name in keys(pkg_doc[pkg_section_name]) {
                                pkg_json_key := "npm_" + pkg_section_name + "|" + pkg_dep_name
                                if has_key(DEP_SEEN, pkg_json_key) == 0 {
                                    DEP_SEEN[pkg_json_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "npm_" + pkg_section_name, "module": pkg_dep_name, "source": out_path})
                                }
                            }
                        }
                    }
                    pkg_parsed := true
                } except err {
                    # The line parser below preserves best-effort behavior for malformed manifests.
                }

                if !pkg_parsed {
                    pkg_section := ""
                    for pkg_line in lines {
                        pkg_trim := trim(pkg_line)

                        if pkg_section == "" {
                            if starts_with(pkg_trim, "\"dependencies\"") && index_of(pkg_trim, "{") >= 0 {
                                pkg_section := "dependencies"
                            }
                            if starts_with(pkg_trim, "\"devDependencies\"") && index_of(pkg_trim, "{") >= 0 {
                                pkg_section := "devDependencies"
                            }
                            if starts_with(pkg_trim, "\"peerDependencies\"") && index_of(pkg_trim, "{") >= 0 {
                                pkg_section := "peerDependencies"
                            }
                            if starts_with(pkg_trim, "\"optionalDependencies\"") && index_of(pkg_trim, "{") >= 0 {
                                pkg_section := "optionalDependencies"
                            }
                        }

                        if pkg_section != "" {
                            if starts_with(pkg_trim, "\"") {
                                p1 := index_of(pkg_trim, "\"")
                                if p1 >= 0 {
                                    p2 := find_after(pkg_trim, "\"", p1 + 1)
                                    if p2 > p1 {
                                        pkg_dep := trim(substring(pkg_trim, p1 + 1, p2))
                                        if pkg_dep != "" {
                                            if pkg_dep != "dependencies" && pkg_dep != "devDependencies" && pkg_dep != "peerDependencies" && pkg_dep != "optionalDependencies" {
                                                pkg_key := "npm_" + pkg_section + "|" + pkg_dep
                                                if has_key(DEP_SEEN, pkg_key) == 0 {
                                                    DEP_SEEN[pkg_key] := true
                                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "npm_" + pkg_section, "module": pkg_dep, "source": out_path})
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if index_of(pkg_trim, "}") >= 0 {
                                pkg_section := ""
                            }
                        }
                    }
                }
            }

            if name == "composer.json" {
                composer_parsed := false
                try {
                    composer_doc := parse_json(content)
                    for composer_section_name in ["require", "require-dev"] {
                        if has_key(composer_doc, composer_section_name) && type(composer_doc[composer_section_name]) == "dict" {
                            for composer_dep_name in keys(composer_doc[composer_section_name]) {
                                if composer_dep_name != "php" && !starts_with(composer_dep_name, "ext-") && !starts_with(composer_dep_name, "lib-") {
                                    composer_json_key := "composer_" + composer_section_name + "|" + composer_dep_name
                                    if has_key(DEP_SEEN, composer_json_key) == 0 {
                                        DEP_SEEN[composer_json_key] := true
                                        DEPENDENCIES := push(DEPENDENCIES, {"type": "composer_" + composer_section_name, "module": composer_dep_name, "source": out_path})
                                    }
                                }
                            }
                        }
                    }
                    composer_parsed := true
                } except err {
                    # The line parser below preserves best-effort behavior for malformed manifests.
                }

                if !composer_parsed {
                    composer_section := ""
                    for composer_line in lines {
                        composer_trim := trim(composer_line)

                        if composer_section == "" {
                            if starts_with(composer_trim, "\"require\"") && index_of(composer_trim, "{") >= 0 {
                                composer_section := "require"
                            }
                            if starts_with(composer_trim, "\"require-dev\"") && index_of(composer_trim, "{") >= 0 {
                                composer_section := "require-dev"
                            }
                        }

                        if composer_section != "" {
                            if starts_with(composer_trim, "\"") {
                                c1 := index_of(composer_trim, "\"")
                                if c1 >= 0 {
                                    c2 := find_after(composer_trim, "\"", c1 + 1)
                                    if c2 > c1 {
                                        composer_dep := trim(substring(composer_trim, c1 + 1, c2))
                                        if composer_dep != "" && composer_dep != "php" && !starts_with(composer_dep, "ext-") && !starts_with(composer_dep, "lib-") {
                                            if composer_dep != "require" && composer_dep != "require-dev" {
                                                composer_key := "composer_" + composer_section + "|" + composer_dep
                                                if has_key(DEP_SEEN, composer_key) == 0 {
                                                    DEP_SEEN[composer_key] := true
                                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "composer_" + composer_section, "module": composer_dep, "source": out_path})
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if index_of(composer_trim, "}") >= 0 {
                                composer_section := ""
                            }
                        }
                    }
                }
            }

            if name == "pyproject.toml" {
                py_section := ""
                py_array_mode := ""

                for py_line in lines {
                    py_trim := trim(py_line)

                    if starts_with(py_trim, "[") && ends_with(py_trim, "]") {
                        py_section := py_trim
                    }

                    if starts_with(py_trim, "dependencies = [") {
                        py_array_mode := "project_dependencies"
                    }

                    if py_array_mode != "" {
                        scan_pos := 0
                        while scan_pos < len(py_trim) {
                            q_start := -1
                            q_mark := ""

                            p_quote := find_after(py_trim, "\"", scan_pos)
                            s_quote := find_after(py_trim, "'", scan_pos)

                            if p_quote >= 0 {
                                q_start := p_quote
                                q_mark := "\""
                            }
                            if s_quote >= 0 && (q_start < 0 || s_quote < q_start) {
                                q_start := s_quote
                                q_mark := "'"
                            }

                            if q_start >= 0 {
                                q_end := find_after(py_trim, q_mark, q_start + 1)
                                if q_end > q_start {
                                    py_dep := trim(substring(py_trim, q_start + 1, q_end))
                                    if py_dep != "" {
                                        py_key := "pyproject_array|" + py_dep
                                        if has_key(DEP_SEEN, py_key) == 0 {
                                            DEP_SEEN[py_key] := true
                                            DEPENDENCIES := push(DEPENDENCIES, {"type": "pyproject_array", "module": py_dep, "source": out_path})
                                        }
                                    }
                                    scan_pos := q_end + 1
                                }
                                if q_end <= q_start {
                                    scan_pos := len(py_trim)
                                }
                            }
                            if q_start < 0 {
                                scan_pos := len(py_trim)
                            }
                        }

                        if index_of(py_trim, "]") >= 0 {
                            py_array_mode := ""
                        }
                    }

                    poetry_dep_table := py_section == "[tool.poetry.dependencies]"
                    poetry_group_dep_table := starts_with(py_section, "[tool.poetry.group.") && ends_with(py_section, ".dependencies]")
                    if poetry_dep_table || poetry_group_dep_table {
                        if py_trim != "" && !starts_with(py_trim, "#") {
                            py_eq := index_of(py_trim, "=")
                            if py_eq > 0 {
                                poetry_dep := trim(substring(py_trim, 0, py_eq))
                                if poetry_dep != "" && poetry_dep != "python" {
                                    poetry_key := "poetry_dep|" + poetry_dep
                                    if has_key(DEP_SEEN, poetry_key) == 0 {
                                        DEP_SEEN[poetry_key] := true
                                        DEPENDENCIES := push(DEPENDENCIES, {"type": "poetry_dep", "module": poetry_dep, "source": out_path})
                                    }
                                }
                            }
                        }
                    }

                    if py_section == "[project.optional-dependencies]" || py_section == "[dependency-groups]" {
                        scan_pos2 := 0
                        while scan_pos2 < len(py_trim) {
                            q_start2 := -1
                            q_mark2 := ""

                            p_quote2 := find_after(py_trim, "\"", scan_pos2)
                            s_quote2 := find_after(py_trim, "'", scan_pos2)

                            if p_quote2 >= 0 {
                                q_start2 := p_quote2
                                q_mark2 := "\""
                            }
                            if s_quote2 >= 0 && (q_start2 < 0 || s_quote2 < q_start2) {
                                q_start2 := s_quote2
                                q_mark2 := "'"
                            }

                            if q_start2 >= 0 {
                                q_end2 := find_after(py_trim, q_mark2, q_start2 + 1)
                                if q_end2 > q_start2 {
                                    py_dep2 := trim(substring(py_trim, q_start2 + 1, q_end2))
                                    if py_dep2 != "" {
                                        py_key2 := "pyproject_optional|" + py_dep2
                                        if has_key(DEP_SEEN, py_key2) == 0 {
                                            DEP_SEEN[py_key2] := true
                                            DEPENDENCIES := push(DEPENDENCIES, {"type": "pyproject_optional", "module": py_dep2, "source": out_path})
                                        }
                                    }
                                    scan_pos2 := q_end2 + 1
                                }
                                if q_end2 <= q_start2 {
                                    scan_pos2 := len(py_trim)
                                }
                            }
                            if q_start2 < 0 {
                                scan_pos2 := len(py_trim)
                            }
                        }
                    }
                }
            }

            if name == "Cargo.toml" || name == "cargo.toml" {
                cargo_section := ""

                for cargo_line in lines {
                    cargo_trim := trim(cargo_line)

                    if starts_with(cargo_trim, "[") && ends_with(cargo_trim, "]") {
                        cargo_section := cargo_trim

                        if starts_with(cargo_trim, "[dependencies.") {
                            dep_table_name := substring(cargo_trim, len("[dependencies."), len(cargo_trim) - 1)
                            dep_table_name := trim(dep_table_name)
                            if dep_table_name != "" {
                                dep_table_key := "cargo_dep_table|" + dep_table_name
                                if has_key(DEP_SEEN, dep_table_key) == 0 {
                                    DEP_SEEN[dep_table_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "cargo_dep_table", "module": dep_table_name, "source": out_path})
                                }
                            }
                        }

                        if index_of(cargo_trim, ".dependencies.") >= 0 {
                            dep_table_pos := index_of(cargo_trim, ".dependencies.")
                            dep_table_name2 := trim(substring(cargo_trim, dep_table_pos + len(".dependencies."), len(cargo_trim) - 1))
                            if dep_table_name2 != "" {
                                dep_table_key2 := "cargo_dep_table|" + dep_table_name2
                                if has_key(DEP_SEEN, dep_table_key2) == 0 {
                                    DEP_SEEN[dep_table_key2] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "cargo_dep_table", "module": dep_table_name2, "source": out_path})
                                }
                            }
                        }
                    }

                    cargo_dep_section := false
                    if cargo_section == "[dependencies]" || cargo_section == "[dev-dependencies]" || cargo_section == "[build-dependencies]" || index_of(cargo_section, ".dependencies]") >= 0 {
                        cargo_dep_section := true
                    }

                    if cargo_dep_section {
                        if cargo_trim != "" && !starts_with(cargo_trim, "#") && index_of(cargo_trim, "=") > 0 {
                            cargo_eq := index_of(cargo_trim, "=")
                            cargo_dep := trim(substring(cargo_trim, 0, cargo_eq))

                            if starts_with(cargo_dep, "\"") && ends_with(cargo_dep, "\"") && len(cargo_dep) > 1 {
                                cargo_dep := substring(cargo_dep, 1, len(cargo_dep) - 1)
                            }

                            if cargo_dep != "" {
                                cargo_key := "cargo_dep|" + cargo_dep
                                if has_key(DEP_SEEN, cargo_key) == 0 {
                                    DEP_SEEN[cargo_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "cargo_dep", "module": cargo_dep, "source": out_path})
                                }
                            }
                        }
                    }
                }
            }

            if name == "go.mod" {
                go_require_block := false

                for go_line in lines {
                    go_trim := trim(go_line)

                    if starts_with(go_trim, "require (") {
                        go_require_block := true
                    }

                    if go_require_block && starts_with(go_trim, ")") {
                        go_require_block := false
                    }

                    if !starts_with(go_trim, "//") {
                        if starts_with(go_trim, "require ") && !starts_with(go_trim, "require (") {
                            go_rest := trim(substring(go_trim, 8, len(go_trim)))
                            go_words := split(go_rest, " ")
                            go_dep := ""
                            for gw in go_words {
                                if trim(gw) != "" {
                                    go_dep := trim(gw)
                                    break
                                }
                            }

                            if go_dep != "" {
                                go_key := "go_mod_require|" + go_dep
                                if has_key(DEP_SEEN, go_key) == 0 {
                                    DEP_SEEN[go_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "go_mod_require", "module": go_dep, "source": out_path})
                                }
                            }
                        }

                        if go_require_block && go_trim != "" && !starts_with(go_trim, ")") && !starts_with(go_trim, "require (") {
                            go_words2 := split(go_trim, " ")
                            go_dep2 := ""
                            for gw2 in go_words2 {
                                if trim(gw2) != "" {
                                    go_dep2 := trim(gw2)
                                    break
                                }
                            }

                            if go_dep2 != "" {
                                go_key2 := "go_mod_require|" + go_dep2
                                if has_key(DEP_SEEN, go_key2) == 0 {
                                    DEP_SEEN[go_key2] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "go_mod_require", "module": go_dep2, "source": out_path})
                                }
                            }
                        }
                    }
                }
            }

            if name == "requirements.txt" || starts_with(name, "requirements-") && ends_with(name, ".txt") {
                for req_line in lines {
                    req_trim := trim(req_line)

                    if req_trim != "" && !starts_with(req_trim, "#") && !starts_with(req_trim, "-") {
                        req_core := split(req_trim, ";")[0]
                        req_core := trim(req_core)

                        cut_points := []
                        for sep in ["==", ">=", "<=", "~=", "!=", ">", "<", "[", " "] {
                            sep_pos := index_of(req_core, sep)
                            if sep_pos >= 0 {
                                cut_points := push(cut_points, sep_pos)
                            }
                        }

                        req_cut := len(req_core)
                        for cp in cut_points {
                            if cp < req_cut {
                                req_cut := cp
                            }
                        }

                        req_dep := trim(substring(req_core, 0, req_cut))
                        if req_dep != "" {
                            req_key := "pip_requirements|" + req_dep
                            if has_key(DEP_SEEN, req_key) == 0 {
                                DEP_SEEN[req_key] := true
                                DEPENDENCIES := push(DEPENDENCIES, {"type": "pip_requirements", "module": req_dep, "source": out_path})
                            }
                        }
                    }
                }
            }

            if name == "Gemfile" {
                for gem_line in lines {
                    gem_trim := trim(gem_line)
                    if starts_with(gem_trim, "gem ") {
                        gem_dep := first_quoted_value(gem_trim)

                        if gem_dep != "" {
                            gem_key := "gemfile_dep|" + gem_dep
                            if has_key(DEP_SEEN, gem_key) == 0 {
                                DEP_SEEN[gem_key] := true
                                DEPENDENCIES := push(DEPENDENCIES, {"type": "gemfile_dep", "module": gem_dep, "source": out_path})
                            }
                        }
                    }
                }
            }

            if name == "pubspec.yaml" || name == "pubspec.yml" {
                pub_section := ""

                for pub_line in lines {
                    pub_trim := trim(pub_line)

                    if pub_trim == "dependencies:" {
                        pub_section := "dependencies"
                    }
                    if pub_trim == "dev_dependencies:" {
                        pub_section := "dev_dependencies"
                    }
                    if pub_trim != "" && !starts_with(pub_line, " ") && !starts_with(pub_line, "\t") && ends_with(pub_trim, ":") && pub_trim != "dependencies:" && pub_trim != "dev_dependencies:" {
                        pub_section := ""
                    }

                    if pub_section != "" && (starts_with(pub_line, " ") || starts_with(pub_line, "\t")) {
                        colon_at := index_of(pub_trim, ":")
                        if colon_at > 0 {
                            pub_dep := trim(substring(pub_trim, 0, colon_at))
                            if pub_dep != "" && pub_dep != "sdk" && pub_dep != "path" && pub_dep != "git" && pub_dep != "version" {
                                pub_key := "pubspec_" + pub_section + "|" + pub_dep
                                if has_key(DEP_SEEN, pub_key) == 0 {
                                    DEP_SEEN[pub_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "pubspec_" + pub_section, "module": pub_dep, "source": out_path})
                                }
                            }
                        }
                    }
                }
            }

            if name == "Package.swift" {
                for swift_pkg_line in lines {
                    swift_pkg_trim := trim(swift_pkg_line)
                    if index_of(swift_pkg_trim, ".package(") >= 0 {
                        swift_pkg_dep := first_quoted_value(swift_pkg_trim)
                        if swift_pkg_dep != "" {
                            swift_pkg_key := "swift_package|" + swift_pkg_dep
                            if has_key(DEP_SEEN, swift_pkg_key) == 0 {
                                DEP_SEEN[swift_pkg_key] := true
                                DEPENDENCIES := push(DEPENDENCIES, {"type": "swift_package", "module": swift_pkg_dep, "source": out_path})
                            }
                        }
                    }
                }
            }

            if name == "mix.exs" {
                for mix_line in lines {
                    mix_trim := trim(mix_line)
                    if starts_with(mix_trim, "{:") {
                        mix_end := index_of(mix_trim, ",")
                        if mix_end < 0 {
                            mix_end := index_of(mix_trim, "}")
                        }
                        if mix_end > 2 {
                            mix_dep := trim(substring(mix_trim, 2, mix_end))
                            if mix_dep != "" {
                                mix_key := "mix_dep|" + mix_dep
                                if has_key(DEP_SEEN, mix_key) == 0 {
                                    DEP_SEEN[mix_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "mix_dep", "module": mix_dep, "source": out_path})
                                }
                            }
                        }
                    }
                }
            }
        }

        if !SKIP_ROUTES {
            if lang == "JavaScript" || lang == "TypeScript" || lang == "React JSX" || lang == "React TSX" {
                if index_of(path, "/pages/api/") >= 0 {
                    api_pos := index_of(path, "/pages/api/")
                    api_tail := substring(path, api_pos + len("/pages/api/"), len(path))
                    route_path_file := api_tail

                    for js_ext in [".tsx", ".ts", ".jsx", ".js", ".mjs", ".cjs"] {
                        if ends_with(route_path_file, js_ext) {
                            route_path_file := substring(route_path_file, 0, len(route_path_file) - len(js_ext))
                            break
                        }
                    }

                    if route_path_file == "index" {
                        route_path_file := ""
                    } else if ends_with(route_path_file, "/index") {
                        route_path_file := substring(route_path_file, 0, len(route_path_file) - len("/index"))
                    }

                    route_path_file := "/" + route_path_file
                    route_path_file := join(split(route_path_file, "[["), "")
                    route_path_file := join(split(route_path_file, "]]"), "")
                    route_path_file := join(split(route_path_file, "["), ":")
                    route_path_file := join(split(route_path_file, "]"), "")

                    if route_path_file != "" {
                        next_key := "ANY|" + route_path_file + "|" + path
                        if has_key(ROUTE_SEEN, next_key) == 0 {
                            ROUTE_SEEN[next_key] := true
                            ROUTES := push(ROUTES, {"method": "ANY", "path": route_path_file, "source": out_path})
                        }
                    }
                }

                if index_of(path, "/app/api/") >= 0 && (ends_with(name, "route.ts") || ends_with(name, "route.tsx") || ends_with(name, "route.js") || ends_with(name, "route.jsx") || ends_with(name, "route.mjs") || ends_with(name, "route.cjs")) {
                    app_api_pos := index_of(path, "/app/api/")
                    app_api_tail := substring(path, app_api_pos + len("/app/api/"), len(path))
                    app_route_path := app_api_tail

                    for root_route_file in ["route.tsx", "route.ts", "route.jsx", "route.js", "route.mjs", "route.cjs"] {
                        if app_route_path == root_route_file {
                            app_route_path := ""
                            break
                        }
                    }

                    for route_file in ["/route.tsx", "/route.ts", "/route.jsx", "/route.js", "/route.mjs", "/route.cjs"] {
                        if ends_with(app_route_path, route_file) {
                            app_route_path := substring(app_route_path, 0, len(app_route_path) - len(route_file))
                            break
                        }
                    }

                    app_route_path := "/" + app_route_path
                    app_route_path := join(split(app_route_path, "[["), "")
                    app_route_path := join(split(app_route_path, "]]"), "")
                    app_route_path := join(split(app_route_path, "["), ":")
                    app_route_path := join(split(app_route_path, "]"), "")

                    if app_route_path != "" {
                        app_next_key := "ANY|" + app_route_path + "|" + path
                        if has_key(ROUTE_SEEN, app_next_key) == 0 {
                            ROUTE_SEEN[app_next_key] := true
                            ROUTES := push(ROUTES, {"method": "ANY", "path": app_route_path, "source": out_path})
                        }
                    }
                }
            }
        }

        line_num := 0
        security_scan_allowed := true
        if name == "AGENTS.md" || name == "CHECKLIST.md" || name == "FILE_TREE.md" || name == "llms.txt" || name == "intelligence.json" {
            security_scan_allowed := false
        }
        if lang == "Markdown" || lang == "JSON" || lang == "YAML" || lang == "TOML" || lang == "XML" {
            security_scan_allowed := false
        }
        inside_security_patterns_definition := false
        inside_go_import_block := false
        for line in lines {
            line_num := line_num + 1
            if len(DEPENDENCIES) >= MAX_ANALYSIS_RESULTS {
                limit_error("SCOUT-LIMIT-DEPENDENCIES", "dependency result limit exceeded: " + to_string(MAX_ANALYSIS_RESULTS))
            }
            if len(ROUTES) >= MAX_ANALYSIS_RESULTS {
                limit_error("SCOUT-LIMIT-ROUTES", "route result limit exceeded: " + to_string(MAX_ANALYSIS_RESULTS))
            }
            if SECURITY_FINDINGS_TOTAL >= MAX_ANALYSIS_RESULTS {
                limit_error("SCOUT-LIMIT-SECURITY-FINDINGS", "security finding limit exceeded: " + to_string(MAX_ANALYSIS_RESULTS))
            }
            trimmed := trim(line)

            if starts_with(trimmed, "SECURITY_PATTERNS") && index_of(trimmed, "[") >= 0 {
                inside_security_patterns_definition := true
            }

            if trimmed != "" {
                if !SKIP_DEPS {
                    if lang == "Python" {
                        if starts_with(trimmed, "import ") {
                            dep_part := trim(substring(trimmed, 7, len(trimmed)))
                            for dep_segment in split(dep_part, ",") {
                                dep_words := split(trim(dep_segment), " ")
                                dep_module := ""
                                for dw in dep_words {
                                    if trim(dw) != "" {
                                        dep_module := trim(dw)
                                        break
                                    }
                                }
                                if dep_module != "" {
                                    dep_key := "import|" + dep_module
                                    if has_key(DEP_SEEN, dep_key) == 0 {
                                        DEP_SEEN[dep_key] := true
                                        DEPENDENCIES := push(DEPENDENCIES, {"type": "import", "module": dep_module, "source": out_path})
                                    }
                                }
                            }
                        }

                        if starts_with(trimmed, "from ") {
                            dep_part2 := trim(substring(trimmed, 5, len(trimmed)))
                            dep_words2 := split(dep_part2, " ")
                            dep_module2 := ""
                            for dw2 in dep_words2 {
                                if trim(dw2) != "" {
                                    dep_module2 := trim(dw2)
                                    break
                                }
                            }
                            if dep_module2 != "" {
                                dep_key2 := "import|" + dep_module2
                                if has_key(DEP_SEEN, dep_key2) == 0 {
                                    DEP_SEEN[dep_key2] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "import", "module": dep_module2, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "JavaScript" || lang == "TypeScript" || lang == "React JSX" || lang == "React TSX" {
                        if starts_with(trimmed, "import ") || index_of(trimmed, "require(") >= 0 {
                            qval := first_quoted_value(trimmed)
                            if qval != "" {
                                dep_key3 := "module|" + qval
                                if has_key(DEP_SEEN, dep_key3) == 0 {
                                    DEP_SEEN[dep_key3] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "module", "module": qval, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "PHP" {
                        if starts_with(trimmed, "use ") {
                            dep_part3 := trim(substring(trimmed, 4, len(trimmed)))
                            dep_words3 := split(dep_part3, " ")
                            dep_module3 := ""
                            for dw3 in dep_words3 {
                                if trim(dw3) != "" {
                                    dep_module3 := trim(dw3)
                                    break
                                }
                            }
                            if dep_module3 != "" {
                                if ends_with(dep_module3, ";") {
                                    dep_module3 := substring(dep_module3, 0, len(dep_module3) - 1)
                                }
                                dep_key4 := "use|" + dep_module3
                                if has_key(DEP_SEEN, dep_key4) == 0 {
                                    DEP_SEEN[dep_key4] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "use", "module": dep_module3, "source": out_path})
                                }
                            }
                        }
