                            for zq in ["\"", "'", "`"] {
                                z1 := index_of(trimmed, zq)
                                if z1 >= 0 {
                                    z2 := find_after(trimmed, zq, z1 + 1)
                                    if z2 > z1 {
                                        zig_dep := substring(trimmed, z1 + 1, z2)
                                        break
                                    }
                                }
                            }
                            if zig_dep != "" {
                                zig_key := "zig_import|" + zig_dep
                                if has_key(DEP_SEEN, zig_key) == 0 {
                                    DEP_SEEN[zig_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "zig_import", "module": zig_dep, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "Swift" {
                        if starts_with(trimmed, "import ") {
                            sw_part := trim(substring(trimmed, 7, len(trimmed)))
                            sw_words := split(sw_part, " ")
                            sw_dep := ""
                            for sw in sw_words {
                                if trim(sw) != "" {
                                    sw_dep := trim(sw)
                                    break
                                }
                            }
                            if sw_dep != "" {
                                sw_key := "swift_import|" + sw_dep
                                if has_key(DEP_SEEN, sw_key) == 0 {
                                    DEP_SEEN[sw_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "swift_import", "module": sw_dep, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "Dart" {
                        if starts_with(trimmed, "import ") {
                            dart_dep := ""
                            for dq in ["\"", "'", "`"] {
                                d1 := index_of(trimmed, dq)
                                if d1 >= 0 {
                                    d2 := find_after(trimmed, dq, d1 + 1)
                                    if d2 > d1 {
                                        dart_dep := substring(trimmed, d1 + 1, d2)
                                        break
                                    }
                                }
                            }
                            if dart_dep != "" {
                                dart_key := "dart_import|" + dart_dep
                                if has_key(DEP_SEEN, dart_key) == 0 {
                                    DEP_SEEN[dart_key] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "dart_import", "module": dart_dep, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "Ruby" {
                        if starts_with(trimmed, "require ") || starts_with(trimmed, "require_relative ") || starts_with(trimmed, "gem ") {
                            dep_module9 := ""
                            for q11 in ["\"", "'", "`"] {
                                rb1 := index_of(trimmed, q11)
                                if rb1 >= 0 {
                                    rb2 := find_after(trimmed, q11, rb1 + 1)
                                    if rb2 > rb1 {
                                        dep_module9 := substring(trimmed, rb1 + 1, rb2)
                                        break
                                    }
                                }
                            }
                            if dep_module9 != "" {
                                dep_key10 := "ruby_dep|" + dep_module9
                                if has_key(DEP_SEEN, dep_key10) == 0 {
                                    DEP_SEEN[dep_key10] := true
                                    DEPENDENCIES := push(DEPENDENCIES, {"type": "ruby_dep", "module": dep_module9, "source": out_path})
                                }
                            }
                        }
                    }

                    if lang == "Java" || lang == "Kotlin" {
                        if starts_with(trimmed, "import ") || starts_with(trimmed, "package ") {
                            dep_kind := "jvm_import"
                            start_at := 7
                            if starts_with(trimmed, "package ") {
                                dep_kind := "jvm_package"
                                start_at := 8
                            }

                            dep_part8 := trim(substring(trimmed, start_at, len(trimmed)))
                            if dep_kind == "jvm_import" && starts_with(dep_part8, "static ") {
                                dep_part8 := trim(substring(dep_part8, 7, len(dep_part8)))
                            }
                            dep_words8 := split(dep_part8, " ")
                            dep_module10 := ""
                            for dw8 in dep_words8 {
                                if trim(dw8) != "" {
                                    dep_module10 := trim(dw8)
                                    break
                                }
                            }

                            if dep_module10 != "" {
                                if ends_with(dep_module10, ";") {
