                    }

                    if lang == "JavaScript" || lang == "TypeScript" || lang == "React JSX" || lang == "React TSX" {
                        # Only literal single-line Fastify object routes are
                        # eligible; dynamic paths and other receivers are not
                        # guessed into an endpoint.
                        if has_key(OPTIONAL_RULE_SEEN, "fastify-object") && !starts_with(trimmed, "//") && contains_unquoted_call(trimmed, "fastify.route(") && index_of(trimmed, "fastify.route({") >= 0 {
                            fastify_method := upper(literal_option_value(trimmed, "method"))
                            fastify_path := literal_option_value(trimmed, "url")
                            if fastify_path == "" {
                                fastify_path := literal_option_value(trimmed, "path")
                            }
                            if starts_with(fastify_path, "/") && index_of("|GET|POST|PUT|PATCH|DELETE|OPTIONS|HEAD|", "|" + fastify_method + "|") >= 0 && fastify_method != "" {
                                fastify_key := fastify_method + "|" + fastify_path + "|" + path
                                if has_key(ROUTE_SEEN, fastify_key) == 0 {
                                    ROUTE_SEEN[fastify_key] := true
                                    ROUTES := push(ROUTES, {"method": fastify_method, "path": fastify_path, "source": out_path})
                                }
                            }
                        }
                        for mk in [".get(", ".post(", ".put(", ".delete(", ".patch(", ".options(", ".head(", ".all("] {
                            if index_of(trimmed, mk) >= 0 {
                                js_route := first_quoted_value(trimmed)
                                if js_route != "" && starts_with(js_route, "/") {
                                    method := upper(substring(mk, 1, index_of(mk, "(")))
                                    route_key2 := method + "|" + js_route + "|" + path
                                    if has_key(ROUTE_SEEN, route_key2) == 0 {
                                        ROUTE_SEEN[route_key2] := true
                                        ROUTES := push(ROUTES, {"method": method, "path": js_route, "source": out_path})
                                    }
                                }
                            }
                        }
                    }

                    if lang == "PHP" {
                        for php_m in ["get", "post", "put", "patch", "delete", "options", "any"] {
                            if index_of(trimmed, "Route::" + php_m + "(") >= 0 {
                                php_route := first_quoted_value(trimmed)
                                if php_route != "" {
                                    method2 := upper(php_m)
                                    route_key3 := method2 + "|" + php_route + "|" + path
                                    if has_key(ROUTE_SEEN, route_key3) == 0 {
                                        ROUTE_SEEN[route_key3] := true
                                        ROUTES := push(ROUTES, {"method": method2, "path": php_route, "source": out_path})
                                    }
                                }
                            }

                            if index_of(trimmed, "$app->" + php_m + "(") >= 0 {
                                slim_route := first_quoted_value(trimmed)
                                if slim_route != "" {
                                    slim_method := upper(php_m)
                                    slim_key := slim_method + "|" + slim_route + "|" + path
                                    if has_key(ROUTE_SEEN, slim_key) == 0 {
                                        ROUTE_SEEN[slim_key] := true
                                        ROUTES := push(ROUTES, {"method": slim_method, "path": slim_route, "source": out_path})
                                    }
                                }
                            }
                        }

                        if index_of(trimmed, "register_rest_route(") >= 0 {
                            wp_ns := ""
                            wp_route := ""
                            wp_quote_count := 0

                            scan_wp := 0
                            while scan_wp < len(trimmed) {
                                wp_q_start := -1
                                wp_q_char := ""

                                wp_dq := find_after(trimmed, "\"", scan_wp)
                                wp_sq := find_after(trimmed, "'", scan_wp)

                                if wp_dq >= 0 {
                                    wp_q_start := wp_dq
                                    wp_q_char := "\""
                                }
                                if wp_sq >= 0 && (wp_q_start < 0 || wp_sq < wp_q_start) {
                                    wp_q_start := wp_sq
                                    wp_q_char := "'"
                                }

                                if wp_q_start >= 0 {
                                    wp_q_end := find_after(trimmed, wp_q_char, wp_q_start + 1)
                                    if wp_q_end > wp_q_start {
                                        wp_val := substring(trimmed, wp_q_start + 1, wp_q_end)
                                        if wp_quote_count == 0 {
                                            wp_ns := wp_val
                                        }
                                        if wp_quote_count == 1 {
                                            wp_route := wp_val
                                        }
                                        wp_quote_count := wp_quote_count + 1
                                        scan_wp := wp_q_end + 1
                                    }
                                    if wp_q_end <= wp_q_start {
                                        scan_wp := len(trimmed)
                                    }
                                }
                                if wp_q_start < 0 {
                                    scan_wp := len(trimmed)
                                }
                            }

                            wp_path := ""
                            if wp_route != "" {
                                wp_path := wp_route
                                if !starts_with(wp_path, "/") {
                                    wp_path := "/" + wp_path
                                }
                                if wp_ns != "" {
                                    wp_ns_norm := wp_ns
                                    if !starts_with(wp_ns_norm, "/") {
                                        wp_ns_norm := "/" + wp_ns_norm
                                    }
                                    if ends_with(wp_ns_norm, "/") {
                                        wp_ns_norm := substring(wp_ns_norm, 0, len(wp_ns_norm) - 1)
                                    }
                                    wp_path := wp_ns_norm + wp_path
                                }
                            }

                            if wp_path != "" {
                                wp_key := "ANY|" + wp_path + "|" + path
                                if has_key(ROUTE_SEEN, wp_key) == 0 {
                                    ROUTE_SEEN[wp_key] := true
                                    ROUTES := push(ROUTES, {"method": "ANY", "path": wp_path, "source": out_path})
                                }
                            }
                        }

                        if index_of(trimmed, "#[Route(") >= 0 || index_of(trimmed, "@Route(") >= 0 {
                            php_attr_route := first_quoted_value(trimmed)
                            if php_attr_route != "" {
                                php_attr_key := "ANY|" + php_attr_route + "|" + path
                                if has_key(ROUTE_SEEN, php_attr_key) == 0 {
                                    ROUTE_SEEN[php_attr_key] := true
                                    ROUTES := push(ROUTES, {"method": "ANY", "path": php_attr_route, "source": out_path})
                                }
                            }
