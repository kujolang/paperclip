# Scout v1.1.0 (Kujo-native)

from lib.path_filters import basename_from_path, sanitize_slug, normalize_filter_text, pattern_match, any_pattern_match, is_canonical_path_within_target, relative_canonical_path_from_target
from lib.sorting import sort_strings_asc, sort_dependencies, sort_routes, sort_security_findings
from lib.security_exports import build_sarif_security_export, build_jsonl_security_export, redact_security_snippet, build_security_fingerprint
from lib.text_scan import find_after, first_quoted_value, is_escaped_char, is_inside_quoted_literal, contains_unquoted_call

