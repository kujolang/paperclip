# Muzzle — Quiet Workflow Runner for AI-Assisted Development
#
# A Kujo-native CLI that runs known local workflows quietly.
# Captures noisy logs to files, prints compact agent-friendly summaries.
#
# Usage:
#   kujo run muzzle.kujo -- <command> [options]
#   muzzle <command> [options]           (via Bash wrapper)

from src.cli import parse_command_args
from src.common import parse_subcommand, has_flag, flag_value, positional_args
from src.common import is_trueish, is_falseish, str_starts_with, str_ends_with
from src.common import dict_has_key, has_muzzle_dir, format_duration_ms, path_is_within_muzzle
from src.common import timestamp_compact, timestamp_iso, ensure_dir
from src.runner import resolve_runner, valid_runner, run_workflow, read_log_tail, runner_label
from src.workflow import load_manifest, inspect_manifest, first_manifest_issue, verify_manifest_integrity, resolve_workflow_script, resolve_manifest_script, validate_script_path, validate_workflow_name, discover_workflows, get_workflow_info
from src.report import write_markdown_report, write_json_report, make_paths, json_report_path
from src.redact import error_excerpt
from src.loops import find_active_loop, find_invalid_loop_state, load_loop, create_loop, advance_loop, record_loop_done, current_iteration_recorded, list_all_loops
from src.policy import valid_policy_mode, evaluate_safety_policy, validate_manifest_args, display_args, verify_signed_policy_bundle
from src.doctor import run_doctor
from src.retention import clean_artifacts

MUZZLE_VERSION := "1.1.3"

WORKFLOWS_DIR := ".muzzle/workflows"
MANIFESTS_DIR := ".muzzle/manifests"
SESSION_FILE := ".muzzle/state/session.json"
SESSION_LOCK_FILE := ".muzzle/state/session.lock"

# =============================================================================
# HELP
# =============================================================================
func print_lines(output_lines) {
	mut idx := 0
	while idx < len(output_lines) {
		print(output_lines[idx])
		idx = idx + 1
	}
}

func print_kv(prefix, value) {
	print(prefix + to_string(value))
}

func print_json(payload) {
	print(to_json(payload))
}

func command_json(argv) {
	return is_trueish(has_flag(argv, "--json"))
}

func fail_command(command_name, code, message, details, json_out, exit_code) {
	if json_out {
		print_json({"schema_version": "muzzle.error/v1", "command": command_name, "code": code, "message": message, "details": details})
	} else {
		print("Error [" + code + "]: " + message)
	}
	exit(exit_code)
}

