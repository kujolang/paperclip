# Escape terminal controls only at human-output boundaries; JSON retains data.
DISPLAY_CONTROLS := parse_json("{\"\\u0000\": \"\\\\u0000\", \"\\u0001\": \"\\\\u0001\", \"\\u0002\": \"\\\\u0002\", \"\\u0003\": \"\\\\u0003\", \"\\u0004\": \"\\\\u0004\", \"\\u0005\": \"\\\\u0005\", \"\\u0006\": \"\\\\u0006\", \"\\u0007\": \"\\\\u0007\", \"\\b\": \"\\\\u0008\", \"\\t\": \"\\\\u0009\", \"\\n\": \"\\\\u000a\", \"\\u000b\": \"\\\\u000b\", \"\\f\": \"\\\\u000c\", \"\\r\": \"\\\\u000d\", \"\\u000e\": \"\\\\u000e\", \"\\u000f\": \"\\\\u000f\", \"\\u0010\": \"\\\\u0010\", \"\\u0011\": \"\\\\u0011\", \"\\u0012\": \"\\\\u0012\", \"\\u0013\": \"\\\\u0013\", \"\\u0014\": \"\\\\u0014\", \"\\u0015\": \"\\\\u0015\", \"\\u0016\": \"\\\\u0016\", \"\\u0017\": \"\\\\u0017\", \"\\u0018\": \"\\\\u0018\", \"\\u0019\": \"\\\\u0019\", \"\\u001a\": \"\\\\u001a\", \"\\u001b\": \"\\\\u001b\", \"\\u001c\": \"\\\\u001c\", \"\\u001d\": \"\\\\u001d\", \"\\u001e\": \"\\\\u001e\", \"\\u001f\": \"\\\\u001f\", \"\\u007f\": \"\\\\u007f\", \"\\u0080\": \"\\\\u0080\", \"\\u0081\": \"\\\\u0081\", \"\\u0082\": \"\\\\u0082\", \"\\u0083\": \"\\\\u0083\", \"\\u0084\": \"\\\\u0084\", \"\\u0085\": \"\\\\u0085\", \"\\u0086\": \"\\\\u0086\", \"\\u0087\": \"\\\\u0087\", \"\\u0088\": \"\\\\u0088\", \"\\u0089\": \"\\\\u0089\", \"\\u008a\": \"\\\\u008a\", \"\\u008b\": \"\\\\u008b\", \"\\u008c\": \"\\\\u008c\", \"\\u008d\": \"\\\\u008d\", \"\\u008e\": \"\\\\u008e\", \"\\u008f\": \"\\\\u008f\", \"\\u0090\": \"\\\\u0090\", \"\\u0091\": \"\\\\u0091\", \"\\u0092\": \"\\\\u0092\", \"\\u0093\": \"\\\\u0093\", \"\\u0094\": \"\\\\u0094\", \"\\u0095\": \"\\\\u0095\", \"\\u0096\": \"\\\\u0096\", \"\\u0097\": \"\\\\u0097\", \"\\u0098\": \"\\\\u0098\", \"\\u0099\": \"\\\\u0099\", \"\\u009a\": \"\\\\u009a\", \"\\u009b\": \"\\\\u009b\", \"\\u009c\": \"\\\\u009c\", \"\\u009d\": \"\\\\u009d\", \"\\u009e\": \"\\\\u009e\", \"\\u009f\": \"\\\\u009f\"}")

export func display_text(value) {
	characters := split(value, "")
	mut output := []
	mut i := 0
	while i < len(characters) {
		character := characters[i]
		if has_key(DISPLAY_CONTROLS, character) {
			output = push(output, DISPLAY_CONTROLS[character])
		} else {
			output = push(output, character)
		}
		i = i + 1
	}
	return join(output, "")
}
