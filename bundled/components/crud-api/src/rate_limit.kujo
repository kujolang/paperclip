from src.config import TRUST_PROXY_HEADERS
from src.validation import get_header

func parse_positive_int_env(var_name, default_value) {
	raw := env_or(var_name, to_string(default_value))
	try {
		parsed := parse_int(trim(raw))
		if parsed > 0 {
			return parsed
		}
	} except err {}

	return default_value
}

WINDOW_SECONDS := parse_positive_int_env("KUJO_CRUD_RATE_LIMIT_WINDOW_SECONDS", 60)
MAX_WRITES_PER_WINDOW := parse_positive_int_env("KUJO_CRUD_RATE_LIMIT_MAX_WRITES", 30)

func has_key_true(value, key_name) {
	probe := has_key(value, key_name)
	if type(probe) == "bool" {
		return probe
	}
	if type(probe) == "int" {
		return probe == 1
	}
	return false
}

func unix_seconds_now() {
	try {
		raw_now := to_string(now())
		parts := split(raw_now, ".")
		return parse_int(parts[0])
	} except err {
		return 0
	}
}

func rate_limit_key(req) {
	if TRUST_PROXY_HEADERS {
		forwarded := trim(get_header(req, "X-Forwarded-For"))
		if len(forwarded) == 0 {
			forwarded := trim(get_header(req, "x-forwarded-for"))
		}
		if len(forwarded) > 0 {
			parts := split(forwarded, ",")
			return "proxy-ip:" + trim(parts[0])
		}
	}

	if has_key_true(req, "ip") {
		return "ip:" + to_string(req["ip"])
	}

	return "global"
}

write_buckets := {}

export func check_write_rate_limit(req) {
	key := rate_limit_key(req)
	now_seconds := unix_seconds_now()

	if has_key_true(write_buckets, key) == false {
		write_buckets[key] := {
			"window_start": now_seconds,
			"count": 1
		}
		return {"ok": true}
	}

	bucket := write_buckets[key]
	window_start := bucket["window_start"]
	count := bucket["count"]

	if (now_seconds - window_start) >= WINDOW_SECONDS {
		write_buckets[key] := {
			"window_start": now_seconds,
			"count": 1
		}
		return {"ok": true}
	}

	if count >= MAX_WRITES_PER_WINDOW {
		retry_after := WINDOW_SECONDS - (now_seconds - window_start)
		if retry_after < 1 {
			retry_after := 1
		}
		return {
			"ok": false,
			"error": "Too many write requests",
			"retry_after": retry_after
		}
	}

	write_buckets[key] := {
		"window_start": window_start,
		"count": count + 1
	}

	return {"ok": true}
}
