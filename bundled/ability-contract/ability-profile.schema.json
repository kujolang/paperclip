{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.ai/schema/ability-profile.schema.json",
  "title": "Kujo Ability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "description", "ability_ids"],
  "properties": {
    "schema": { "const": "kujo.ability-profile/v1" },
    "id": { "type": "string", "pattern": "^kujo\\.profile\\.[a-z0-9][a-z0-9.-]*$", "maxLength": 200 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "default": { "type": "boolean", "default": false },
    "extends": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^kujo\\.profile\\.[a-z0-9][a-z0-9.-]*$" } },
    "ability_ids": { "type": "array", "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,199}$" } },
    "metadata": { "type": "object" }
  }
}
