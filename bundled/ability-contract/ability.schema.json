{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kujolang.dev/schemas/ability/v1",
  "title": "Kujo Ability Definition",
  "description": "Portable semantic operation contract independent of handlers, policy, providers, and exposure protocols.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "description",
    "input_schema",
    "output_schema",
    "effects",
    "idempotency"
  ],
  "properties": {
    "schema": {
      "const": "kujo.ability/v1"
    },
    "id": {
      "type": "string",
      "minLength": 5,
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){2,}$",
      "maxLength": 240
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "resource"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "delete",
              "external"
            ]
          },
          "resource": {
            "type": "string",
            "minLength": 5,
            "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*){2,}$",
            "maxLength": 240
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "intrinsic",
            "keyed",
            "none"
          ]
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_world",
        "destructive",
        "executes_code"
      ],
      "properties": {
        "open_world": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        },
        "executes_code": {
          "type": "boolean"
        }
      },
      "description": "Optional complete host-neutral effect facts. Absence means unknown. Not authorization. Cross-field consistency is enforced by the contract validator."
    }
  }
}
